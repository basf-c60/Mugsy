; VM variables
;
; The VM has 84 32-bit signed variables, each holding a fixed-point number with two decimal places (so 1.00 is stored as 100). Variables 37-64 are constants; variables 65-83 are the table of initial values for v0-v18 copied by #R33937, but the script also uses v68-v72 as the constants 40, 10, 2.5, 1 and 0. See the #LINK(Variables)(variables page).
b33552 DEFB 0,0,0,0 ; v0 (StartClients): Number of clients at the start of the game (400) [0]
 33556 DEFB 0,0,0,0 ; v1 (Squeezed): Number of clients squeezed this year [0]
 33560 DEFB 0,0,0,0 ; v2 (Raided): Amount (in grand) taken by the cops in a raid [0]
 33564 DEFB 0,0,0,0 ; v3 (Hoods): Number of hoods in the mob (shown on the status line) [0]
 33568 DEFB 0,0,0,0 ; v4 (Killed): Number of hoods rubbed out last year [0]
 33572 DEFB 0,0,0,0 ; v5 (Price): Average protection payment per client [0]
 33576 DEFB 0,0,0,0 ; v6 (Year): Current year (starts at 1) [0]
 33580 DEFB 0,0,0,0 ; v7 (Dough): Dough in the safe, in thousands of dollars (shown on the status line) [0]
 33584 DEFB 0,0,0,0 ; v8 (Clients): Number of clients (shown on the status line as CUSTOMERS) [0]
 33588 DEFB 0,0,0,0 ; v9 (Recruits): Number of hoods recruited last year [0]
 33592 DEFB 0,0,0,0 ; v10 (TotalKilled): Total number of hoods killed during the game [0]
 33596 DEFB 0,0,0,0 ; v11 (Blunders): Number of blunders (silly answers) made this year [0]
 33600 DEFB 0,0,0,0 ; v12 (TotalBlunders): Total number of blunders made during the game [0]
 33604 DEFB 0,0,0,0 ; v13 (HoodYears): Sum of the mob size over all years [0]
 33608 DEFB 0,0,0,0 ; v14 (Loan): Loan from Nick the Greek (in grand) [0]
 33612 DEFB 0,0,0,0 ; v15 (Score): Final score (percentage) [0]
 33616 DEFB 0,0,0,0 ; v16 (TotalTakings): Total protection takings [0]
 33620 DEFB 0,0,0,0 ; v17 (TotalProfit): Total profit [0]
 33624 DEFB 0,0,0,0 ; v18 (ClientYears): Sum of the number of clients over all years [0]
 33628 DEFB 0,0,0,0 ; v19 (Bought): Number of clients bought from the syndicate this year [0]
 33632 DEFB 0,0,0,0 ; v20 (Sold): Number of clients sold to the syndicate this year [0]
 33636 DEFB 0,0,0,0 ; v21 (Unsqueezed): Number of clients available to be squeezed [0]
 33640 DEFB 0,0,0,0 ; v22 (ClientsLeft): Number of clients that would be left after a sale [0]
 33644 DEFB 0,0,0,0 ; v23 (Ammo): Amount spent on artillery and ammo this year [0]
 33648 DEFB 0,0,0,0 ; v24 (FedsKilled): Number of recruits killed in the shootout with the feds [0]
 33652 DEFB 0,0,0,0 ; v25 (Takings): Protection takings this year [0]
 33656 DEFB 0,0,0,0 ; v26 (Profit): Profit this year (after Rocco has taken his cut) [0]
 33660 DEFB 0,0,0,0 ; v27 (Interest): Interest rate on Nick the Greek's loan (percent) [0]
 33664 DEFB 0,0,0,0 ; v28 (HoodGrowth): Percentage growth of the mob over the game [0]
 33668 DEFB 0,0,0,0 ; v29 (ClientGrowth): Percentage growth of the client list over the game [0]
 33672 DEFB 0,0,0,0 ; v30 (Handout): Handout paid to keep the hoods loyal [0]
 33676 DEFB 0,0,0,0 ; v31 (Bribe): Bribe paid to Rocco's mob [0]
 33680 DEFB 0,0,0,0 ; v32 (Kickback): Annual kickback to the cops [0]
 33684 DEFB 0,0,0,0 ; v33 (Tmp): Scratch variable [0]
 33688 DEFB 0,0,0,0 ; v34 (ClientCost): Price of a client this year (in grand) [0]
 33692 DEFB 0,0,0,0 ; v35 (Input): Number entered by the player (x100 fixed point; see #R27790) [0]
 33696 DEFB 0,0,0,0 ; v36 (Years): Number of years the game will last (7-11, chosen at random by #R33937) [0]
 33700 DEFB 128,56,1,0 ; v37 (K800): Constant: 800 [800]
 33704 DEFB 160,134,1,0 ; v38 (K1000): Constant: 1000 [1000]
 33708 DEFB 251,255,255,255 ; v39 (Km005): Constant: -0.05 [-0.05]
 33712 DEFB 246,255,255,255 ; v40 (Km010): Constant: -0.1 [-0.1]
 33716 DEFB 50,0,0,0 ; v41 (K05): Constant: 0.5 [0.5]
 33720 DEFB 150,0,0,0 ; v42 (K15): Constant: 1.5 [1.5]
 33724 DEFB 200,0,0,0 ; v43 (K2): Constant: 2 [2]
 33728 DEFB 44,1,0,0 ; v44 (K3): Constant: 3 [3]
 33732 DEFB 94,1,0,0 ; v45 (K35): Constant: 3.5 [3.5]
 33736 DEFB 144,1,0,0 ; v46 (K4): Constant: 4 [4]
 33740 DEFB 244,1,0,0 ; v47 (K5): Constant: 5 [5]
 33744 DEFB 88,2,0,0 ; v48 (K6): Constant: 6 [6]
 33748 DEFB 188,2,0,0 ; v49 (K7): Constant: 7 [7]
 33752 DEFB 32,3,0,0 ; v50 (K8): Constant: 8 [8]
 33756 DEFB 132,3,0,0 ; v51 (K9): Constant: 9 [9]
 33760 DEFB 76,4,0,0 ; v52 (K11): Constant: 11 [11]
 33764 DEFB 176,4,0,0 ; v53 (K12): Constant: 12 [12]
 33768 DEFB 20,5,0,0 ; v54 (K13): Constant: 13 [13]
 33772 DEFB 220,5,0,0 ; v55 (K15b): Constant: 15 [15]
 33776 DEFB 164,6,0,0 ; v56 (K17): Constant: 17 [17]
 33780 DEFB 108,7,0,0 ; v57 (K19): Constant: 19 [19]
 33784 DEFB 208,7,0,0 ; v58 (K20): Constant: 20 [20]
 33788 DEFB 196,9,0,0 ; v59 (K25): Constant: 25 [25]
 33792 DEFB 172,13,0,0 ; v60 (K35b): Constant: 35 [35]
 33796 DEFB 136,19,0,0 ; v61 (K50): Constant: 50 [50]
 33800 DEFB 112,23,0,0 ; v62 (K60): Constant: 60 [60]
 33804 DEFB 172,38,0,0 ; v63 (K99): Constant: 99 [99]
 33808 DEFB 16,39,0,0 ; v64 (K100): Constant: 100 [100]
 33812 DEFB 64,156,0,0 ; v65 (v65): Initial value of v0 (part of the table at #R33812); not otherwise used [400]
 33816 DEFB 48,117,0,0 ; v66 (v66): Initial value of v1 (part of the table at #R33812); not otherwise used [300]
 33820 DEFB 76,29,0,0 ; v67 (v67): Initial value of v2 (part of the table at #R33812); not otherwise used [75]
 33824 DEFB 160,15,0,0 ; v68 (K40): Initial value of v3 (part of the table at #R33812); also used as the constant 40 [40]
 33828 DEFB 232,3,0,0 ; v69 (K10): Initial value of v4 (part of the table at #R33812); also used as the constant 10 [10]
 33832 DEFB 250,0,0,0 ; v70 (K25c): Initial value of v5 (part of the table at #R33812); also used as the constant 2.5 [2.5]
 33836 DEFB 100,0,0,0 ; v71 (K1): Initial value of v6 (part of the table at #R33812); also used as the constant 1 [1]
 33840 DEFB 0,0,0,0 ; v72 (K0): Initial value of v7 (part of the table at #R33812); also used as the constant 0 [0]
 33844 DEFB 64,156,0,0 ; v73 (v73): Initial value of v8 (part of the table at #R33812); not otherwise used [400]
 33848 DEFB 232,3,0,0 ; v74 (v74): Initial value of v9 (part of the table at #R33812); not otherwise used [10]
 33852 DEFB 0,0,0,0 ; v75 (v75): Initial value of v10 (part of the table at #R33812); not otherwise used [0]
 33856 DEFB 0,0,0,0 ; v76 (v76): Initial value of v11 (part of the table at #R33812); not otherwise used [0]
 33860 DEFB 0,0,0,0 ; v77 (v77): Initial value of v12 (part of the table at #R33812); not otherwise used [0]
 33864 DEFB 0,0,0,0 ; v78 (v78): Initial value of v13 (part of the table at #R33812); not otherwise used [0]
 33868 DEFB 0,0,0,0 ; v79 (v79): Initial value of v14 (part of the table at #R33812); not otherwise used [0]
 33872 DEFB 0,0,0,0 ; v80 (v80): Initial value of v15 (part of the table at #R33812); not otherwise used [0]
 33876 DEFB 0,0,0,0 ; v81 (v81): Initial value of v16 (part of the table at #R33812); not otherwise used [0]
 33880 DEFB 0,0,0,0 ; v82 (v82): Initial value of v17 (part of the table at #R33812); not otherwise used [0]
 33884 DEFB 0,0,0,0 ; v83 (v83): Initial value of v18 (part of the table at #R33812); not otherwise used [0]

; VM flags
;
; Nine flag bytes that the script tests and sets with IFPEEKEQ, IFPEEKNE and POKE, followed by the game status flag and some workspace used by the speech bubble code. #R33937 sets the nine flags and the status flag to 1 at the start of each game; the values below are those in the saved game image.
b33888 DEFB 0 ; Flag 0: the feds flag. 1 normally, 2 when the feds have been tipped off (set at the end of the recruiting step, tested in the next report; see the #LINK(Economics)(economics page))
 33889 DEFB 0 ; Flag 1: set to 2 when the ammo comes to 1 grand per hood or less (adequate or not), but never tested
 33890 DEFB 0 ; Flag 2: set to 2 when the game ends early (the mob walks out, Nick the Greek, no money left for ammo, cousin Abe, an empty safe, or the hit man); the end of the game then skips the farewell from the hoods
 33891 DEFB 0 ; Flag 3: Rocco. Set to 2 when Rocco gets uppity; next year's report then halves the takings (if they are 3 grand or more) and changes its wording. Reset to 1 after the report
 33892 DEFB 0 ; Flag 4: the contract. 2 when the hit man is coming, 3 when he has won the shootout (set by #R28358); reset to 1 afterwards
 33893 DEFB 0 ; Flag 5: chooses between two openings of the contract warning; never changed from 1, so the second opening is never used
 33894 DEFB 0 ; Flag 6: the ammo flag. 2 when last year's ammo was inadequate and not forgiven (cousin Abe then takes over), 1 otherwise
 33895 DEFB 0 ; Flag 7: 1 in the first year, set to 2 at the end of every year
 33896 DEFB 0 ; Flag 8: the type of the last number entered, set by #R27835 (1 negative, 2 zero, 3 exactly 0.01, 4 anything else)
 33897 DEFB 0 ; Game status flag: non-zero ends the main loop at #R24614
 33898 DEFB 0,0 ; Default sub-message address
 33900 DEFB 0,0 ; Saved IY
 33902 DEFB 121,132 ; Pointer to this year's bubble layout table (#R33913 or #R33925)
 33904 DEFB 0,0 ; The current bubble layout
 33906 DEFB 0 ; Layout-unchanged flag
 33907 DEFB 0,0 ; Text width

; Speech bubble layouts
;
; Each entry is 4 bytes: a chance value (compared with a random number from 0 to 100), the address of the picture, and a byte that is always 0. #R33909 is the fixed "answer" layout. #R33913 and #R33925 start the two tables, one of which #R24614 picks at random each year; the SAY routine (#R28549) then takes the first entry in that table whose chance value is above a new random number. See #LINK(Facts#backgrounds)(Which background you get) on the trivia page for the resulting odds.
b33909 DEFB 0,134,252,0 ; Fixed "answer" layout: picture #R64646 (close-up of a hood)
 33913 DEFB 30,49,229,0 ; First table, below 30: picture #R58673 (a figure in a doorway)
 33917 DEFB 70,5,232,0 ; First table, below 70: picture #R59397 (two hoods at a table)
 33921 DEFB 101,239,224,0 ; First table, otherwise: picture #R57583 (a man in a hat at a table)
 33925 DEFB 33,113,248,0 ; Second table, below 33: picture #R63601 (hoods and a car in the city)
 33929 DEFB 66,110,236,0 ; Second table, below 66: picture #R60526 (the getaway car from above)
 33933 DEFB 101,185,240,0 ; Second table, otherwise: picture #R61625 (two figures at the waterfront)

; Initialise the game variables
;
; Copies the initial values of v0-v18 from the table at #R33812, sets the nine VM flags at #R33888 to 1 and chooses the length of the game: v36 = 7 + 4 x (a random number from 0 to 1.00), which is not rounded (see #LINK(Bugs#years)(the bugs page)).
@label=INITVARS
c33937 LD HL,33812 ; Copy the initial values of v0-v18...
 33940 LD DE,33552 ; ...from the table at #R33812 (which doubles as variables v65-v83)
 33943 LD BC,76 ; BC=76: nineteen four-byte variables
 33946 LDIR ; Copy them into place
 33948 LD HL,33888 ; Set the nine VM flag bytes at #R33888...
 33951 LD B,10 ; B=10: nine VM flags plus the game status flag
 33953 LD (HL),1 ; ...and the game status flag to 1
 33955 INC HL ; Next flag
 33956 DJNZ 33953 ; Loop for all ten
 33958 LD DE,100 ; BCDE=1.00
 33961 LD BC,0 ; BC=0: the high half of 1.00
 33964 CALL 30482 ; Get a random number in BCDE (0..1.00)
 33967 EXX ; Switch to the alternate registers to hold the multiplier
 33968 LD DE,400 ; BC'DE'=4.00
 33971 LD BC,0 ; BC'=0: the high half of 4.00
 33974 CALL 30657 ; Multiply
 33977 EXX ; Switch back
 33978 LD DE,700 ; BC'DE'=7.00
 33981 LD BC,0 ; BC=0: the high half of 7.00
 33984 CALL 30441 ; Add
 33987 LD L,36 ; Store the result in v36 (the length of the game in years)
 33989 CALL 31179 ; Store BCDE in v36: the length of the game, 7 + 4 x (a random number), an unrounded number of years
 33992 RET ; Return

; The sequence-finished flag
b33993 DEFB 0

; VM native: "A year goes by ......" animation
;
; Installs the IM2 interrupt routine at #R34069 (via the jump at #R53456 and the vector table at #R53504) and then plays one of two short animations chosen at random: the bar-room scene (step table at #R36348) or the getaway car (step table at #R34298).
;
; Nothing in the game chooses between them: not the year, the hoods, the cash or what happened in the year. The choice is one call of the random routine (#R30014, limit 100); a result below 50 gives the bar room. That is not an even split, because the routine is not uniform (see #R30026): counting the 256 raw values gives 154 for the bar room and 102 for the car, about 60% to 40%.
;
; #HTML[<img src="../images/baranim.gif" alt="The bar-room animation" /> <img src="../images/caranim.gif" alt="The getaway car animation" />]
@label=YEARGOESBY
c33994 DI ; Interrupts off while the animation interrupt routine is installed
 33995 LD HL,34069 ; Point the interrupt jump at #R53456...
 33998 LD (53457),HL ; ...at the interrupt routine at #R34069
 34001 LD A,209 ; Point I at the vector table at #R53504
 34003 LD I,A ; Point the interrupt vector register at the table at #R53504
 34005 IM 2 ; Select interrupt mode 2
 34007 EI ; Enable interrupts: #R34069 now runs fifty times a second
 34008 XOR A ; Clear the sequence-finished flag
 34009 LD (33993),A ; Clear the "animation finished" flag
 34012 LD A,100 ; Pick one of the two animations at random
 34014 CALL 30014 ; A=a random number from 0 to 100 (not evenly spread: below 50 about 60% of the time)
 34017 LD IX,36348 ; Bar-room animation...
 34021 CP 50 ; Below 50?
 34023 JR C,34029 ; ...if the number is below 50
 34025 LD IX,34298 ; Otherwise the getaway car animation
 34029 CALL 34040 ; Run the animation
 34032 DI ; Interrupts off again
 34033 LD A,63 ; Restore I (63 is its normal value)
 34035 LD I,A ; Put I back as the ROM expects it
 34037 IM 1 ; Back to interrupt mode 1
 34039 RET ; Return

; Run the steps of an animation
;
; IX points at a list of step routine addresses. Once per tick (set by the interrupt routine) the current step is called; while it returns with the zero flag reset it is called again on the next tick, otherwise IX moves on to the next step. The sequence ends when #R33993 is set.
;
; Input:IX Step table
@label=RUNSTEPS
c34040 LD A,(33993) ; Has the animation finished?
 34043 AND A ; Test the flag
 34044 RET NZ ; Return if so
 34045 EI ; Enable interrupts
 34046 HALT ; Wait for an interrupt
 34047 EI ; And again, to be sure they are on
 34048 LD L,(IX+0) ; Pick up the address of the current step routine
 34051 LD H,(IX+1) ; H=the high byte of the step routine's address
 34054 CALL 34065 ; Call it
 34057 JR NZ,34040 ; Keep calling it until it returns with the zero flag set
 34059 INC IX ; Then move to the next step
 34061 INC IX ; Next step
 34063 JR 34040 ; Loop back to wait for the interrupt and run the step

; Jump to the address in HL
c34065 JP (HL) ; Jump to the step routine

; The interrupt countdown
b34066 DEFB 0,0,0

; Interrupt routine for the animations
;
; Counts down #R34066; when it reaches zero it reloads it from 34067 and sets the tick flag at 34068.
@label=ISR1
c34069 PUSH AF ; Save AF
 34070 LD A,(34066) ; Decrement the interrupt countdown
 34073 DEC A ; One tick less
 34074 LD (34066),A ; Store it
 34077 JR NZ,34090 ; Jump unless it has reached zero
 34079 LD A,(34067) ; Reload the countdown
 34082 LD (34066),A ; Store it
 34085 LD A,1 ; Set the tick flag
 34087 LD (34068),A ; Set the tick flag
 34090 POP AF ; Restore AF
 34091 RETI ; Return from the interrupt

; Draw a 2-cell-wide sprite (no mask)
;
; Copies B=2 bytes per pixel row from DE to the screen at HL; the first byte at DE is the height.
c34093 LD B,2 ; B=2: two bytes per pixel row
 34095 JR 34099 ; Carry on with the common code

; Draw a 3-cell-wide sprite (no mask)
;
; As #R34093 but 3 bytes wide.
c34097 LD B,3 ; B=3: three bytes per pixel row
 34099 LD A,(DE) ; A=the height of the sprite (the first byte of the sprite data)
 34100 INC DE ; Move to the graphic data
 34101 LD C,A ; C=the number of pixel rows
 34102 PUSH BC ; Save the row counter and width
 34103 PUSH HL ; Save the screen address
 34104 LD A,(DE) ; A=a byte of the graphic
 34105 LD (HL),A ; Put it on the screen
 34106 INC DE ; Next graphic byte
 34107 INC L ; Next screen column
 34108 DJNZ 34104 ; Loop for every byte of the row
 34110 POP HL ; Restore the screen address
 34111 POP BC ; Restore the row counter
 34112 INC H ; Down one pixel row
 34113 LD A,H ; A=the high byte
 34114 AND 7 ; Crossed into a new character row?
 34116 JR Z,34122 ; Yes: adjust the address
 34118 DEC C ; One row less
 34119 JR NZ,34102 ; Loop for every pixel row
 34121 RET ; Return
 34122 LD A,L ; A=the low byte
 34123 ADD A,32 ; Down one character row
 34125 LD L,A ; L=the new low byte
 34126 JR C,34118 ; Carry: the next third of the screen (H is already right)
 34128 LD A,H ; A=the high byte
 34129 SUB 8 ; Take back the 8 added by the pixel row steps
 34131 LD H,A ; H=it
 34132 JP 34118 ; Carry on

; Prepare a pre-shifted masked sprite
;
; Copies the 32x32 sprite whose address is at HL into the buffer at DE, giving each row of 4 graphic bytes a mask byte of 255 and a spare 0 byte, then shifts the whole buffer right A pixels.
;
; This routine has a serious bug: it leaves the buffer address on the stack (PUSH DE ... POP HL; PUSH HL) and so, when A is 0, the RET Z at #R34164 "returns" into the sprite buffer and the CPU executes the graphic data. See the #LINK(Bugs#preshift)(bugs page).
;
; Input:A Shift (0-7)
; DE Buffer (24192 or 24384)
; HL Pointer to the sprite address
@label=PRESHIFT
c34135 PUSH DE ; Push the buffer address (this is the problem)
 34136 LD E,(HL) ; Pick up the address of the sprite graphic
 34137 INC HL ; Next byte
 34138 LD D,(HL) ; D=the high byte of the sprite's graphic address
 34139 POP HL ; HL=buffer address
 34140 PUSH HL ; Leave it on the stack (above the return address)
 34141 EX DE,HL ; HL=graphic, DE=buffer
 34142 PUSH AF ; Save the shift count
 34143 XOR A ; A=0
 34144 EXX ; Switch to the alternate registers
 34145 LD B,32 ; 32 pixel rows
 34147 EXX ; Switch back
 34148 LD BC,4 ; Copy the 4 graphic bytes of this row
 34151 LDIR ; Copy the four graphic bytes of the row
 34153 DEC A ; A=255
 34154 LD (DE),A ; Add a mask byte of 255
 34155 INC DE ; Next buffer byte
 34156 INC A ; A=0
 34157 LD (DE),A ; Add a spare byte of 0
 34158 INC DE ; Next buffer byte
 34159 EXX ; Switch to the alternate registers (for the row counter)
 34160 DJNZ 34147 ; Next row
 34162 POP AF ; Restore the shift count
 34163 AND A ; Is it zero?
 34164 RET Z ; BUG: return to the buffer address left on the stack if so
 34165 LD C,A ; C=shift count
 34166 POP HL ; HL=buffer
 34167 PUSH HL ; Save the buffer address
 34168 LD B,32 ; 32 rows
 34170 SCF ; Rotate a 1 into the mask...
 34171 RR (HL) ; Shift the mask byte right (the carry brings in a 1)
 34173 INC HL ; Skip to the next mask byte
 34174 INC HL ; (rows are 6 bytes long)
 34175 RR (HL) ; Shift the second mask byte
 34177 INC HL ; Skip on
 34178 INC HL ; ...
 34179 RR (HL) ; Shift the third mask byte
 34181 DEC HL ; Back to the first graphic byte
 34182 DEC HL ; ...
 34183 DEC HL ; ...
 34184 OR A ; ...and a 0 into the graphic
 34185 RR (HL) ; Shift the first graphic byte (a 0 comes in)
 34187 INC HL ; Next graphic byte
 34188 INC HL ; ...
 34189 RR (HL) ; Shift the second graphic byte
 34191 INC HL ; Next graphic byte
 34192 INC HL ; ...
 34193 RR (HL) ; Shift the third graphic byte
 34195 INC HL ; Next row
 34196 DJNZ 34170 ; Next row
 34198 DEC C ; One pixel of shift less
 34199 JR NZ,34166 ; Repeat for each pixel of the shift
 34201 POP HL ; Drop the buffer address
 34202 RET ; Return properly
 34203 LD C,32 ; C=32 pixel rows
 34205 LD B,3 ; B=3 bytes per row
 34207 LD A,(DE) ; A=the screen byte
 34208 EXX ; Switch to the alternate registers
 34209 LD (HL),A ; Save it in the background store
 34210 INC HL ; Next store byte
 34211 EXX ; Switch back
 34212 AND (HL) ; AND with the mask
 34213 INC HL ; Next byte of the sprite buffer
 34214 OR (HL) ; OR in the graphic
 34215 EX AF,AF' ; Save the result in A'
 34216 LD A,E ; A=the screen column
 34217 AND 31 ; Column bits
 34219 CP 30 ; Is it column 30 or more?
 34221 JR NC,34225 ; Yes: do not draw (off the right of the scene)
 34223 EX AF,AF' ; Get the result back
 34224 LD (DE),A ; Draw it
 34225 INC HL ; Next sprite buffer byte
 34226 INC E ; Next column
 34227 DJNZ 34207 ; Loop for three bytes
 34229 DEC E ; Back to the first column
 34230 DEC E ; ...
 34231 DEC E ; ...
 34232 INC D ; Down one pixel row
 34233 LD A,D ; A=the high byte
 34234 AND 7 ; Crossed into the next character row?
 34236 JR Z,34242 ; Yes: adjust
 34238 DEC C ; One row less
 34239 JR NZ,34205 ; Loop for every row
 34241 RET ; Return
 34242 LD A,E ; A=the low byte
 34243 ADD A,32 ; Down one character row
 34245 LD E,A ; E=the new low byte
 34246 JR C,34238 ; Carry: next third (D is right)
 34248 LD A,D ; A=the high byte
 34249 SUB 8 ; Take back the 8
 34251 LD D,A ; D=it
 34252 JP 34238 ; Carry on
 34255 LD C,32 ; C=32 pixel rows
 34257 LD B,3 ; B=3 bytes per row
 34259 LD A,(HL) ; A=a saved background byte
 34260 LD (DE),A ; Put it back on the screen
 34261 INC E ; Next column
 34262 INC HL ; Next saved byte
 34263 DJNZ 34259 ; Loop for three bytes
 34265 DEC E ; Back to the first column
 34266 DEC E ; ...
 34267 DEC E ; ...
 34268 INC D ; Down one pixel row
 34269 LD A,D ; A=the high byte
 34270 AND 7 ; Crossed into the next character row?
 34272 JR Z,34278 ; Yes: adjust
 34274 DEC C ; One row less
 34275 JR NZ,34257 ; Loop for every row
 34277 RET ; Return
 34278 LD A,E ; A=the low byte
 34279 ADD A,32 ; Down one character row
 34281 LD E,A ; E=the new low byte
 34282 JR C,34274 ; Carry: next third
 34284 LD A,D ; A=the high byte
 34285 SUB 8 ; Take back the 8
 34287 LD D,A ; D=it
 34288 JP 34274 ; Carry on

; Getaway car animation: counters
b34291 DEFB 0,0,0,0,0,0,0

; Getaway car animation: step table
;
; Used by #R34040.
w34298 DEFW 34318,34455,34481,34455
 34306 DEFW 34513,34537,34558,34579
 34314 DEFW 34600,34440

; Getaway car animation: step 1 (set up)
;
; Draws the street picture at #R55692 and initialises the positions and timers of the car and the hoods.
c34318 XOR A ; A=0
 34319 OUT (254),A ; Black border
 34321 LD HL,55692 ; HL=the compressed picture of the street
 34324 CALL 32126 ; Draw it
 34327 LD HL,19482 ; HL=the screen address of the first hood's start position
 34330 LD (37101),HL ; Store it
 34333 LD HL,18465 ; HL=the screen address of the second hood's start position
 34336 LD (37933),HL ; Store it
 34339 LD HL,37109 ; HL=the first hood's frame list (#R37109)
 34342 LD (37107),HL ; Store it
 34345 LD HL,37941 ; HL=the second hood's frame list (#R37941)
 34348 LD (37939),HL ; Store it
 34351 LD HL,52311 ; HL=the screen address where the car starts (52311, with the left-clip flag in bit 7 of H)
 34354 LD (38789),HL ; Store it as the car's position
 34357 XOR A ; A=0
 34358 LD (37105),A ; The first hood's pixel shift is 0
 34361 LD (37937),A ; The second hood's pixel shift is 0
 34364 LD (38791),A ; The car's pixel shift is 0
 34367 LD A,10 ; A=10
 34369 LD (34292),A ; The first hood waits 10 steps before moving
 34372 LD (34067),A ; Set the reload value of the interrupt countdown (one tick every 10 interrupts)
 34375 LD (34066),A ; Set the countdown
 34378 LD (34295),A ; Figure counter 34295 starts at 10
 34381 LD A,9 ; A=9
 34383 LD (34291),A ; The first hood moves every 9 ticks
 34386 LD A,13 ; A=13
 34388 LD (34293),A ; The second hood moves every 13 ticks
 34391 LD A,8 ; A=8
 34393 LD (34296),A ; Counter for the figure at 17728
 34396 LD (34297),A ; Counter for the figure's delay
 34399 LD A,3 ; A=3
 34401 LD (34294),A ; Step counter
 34404 LD HL,(37107) ; HL=the first hood's frame list
 34407 INC HL ; Skip the first entry
 34408 INC HL ; ...
 34409 LD A,(37105) ; A=the first hood's pixel shift
 34412 LD DE,24384 ; DE=the first hood's sprite buffer (24384)
 34415 CALL 34135 ; Prepare the shifted sprite
 34418 CALL 34779 ; Draw the first hood
 34421 LD HL,(37939) ; HL=the second hood's frame list
 34424 INC HL ; Skip the first entry
 34425 INC HL ; ...
 34426 LD A,(37937) ; A=the second hood's pixel shift
 34429 LD DE,24192 ; DE=the second hood's sprite buffer (24192)
 34432 CALL 34135 ; Prepare the shifted sprite
 34435 CALL 34798 ; Draw the second hood
 34438 XOR A ; A=0: this step is complete
 34439 RET ; Return

; Getaway car animation: last step
;
; Sets #R33993 to end the animation, then keeps scrolling the car off the screen.
c34440 LD A,1 ; A=1
 34442 LD (33993),A ; Mark the animation as finished
 34445 LD A,(38791) ; A=the car's pixel shift
 34448 AND A ; Test it
 34449 RET Z ; Done if it is at a byte boundary
 34450 CALL 35000 ; Otherwise keep scrolling the car
 34453 JR 34440 ; Check again

; Getaway step 2
c34455 CALL 34862 ; Draw the next frame of the street animation
 34458 CALL 34759 ; Restore the background behind the second hood
 34461 CALL 34798 ; Draw the second hood
 34464 CALL 34817 ; Draw the five-byte-wide graphic
 34467 CALL 34707 ; Move the second hood on
 34470 LD A,(37933) ; A=the second hood's screen address
 34473 AND 31 ; Column
 34475 CP 18 ; Column 18?
 34477 RET Z ; Yes: this step is not finished (Z set)
 34478 CP 30 ; Column 30?
 34480 RET ; Return (Z set when the hood has reached column 30)

; Getaway step 3
c34481 CALL 34862 ; Draw the next frame of the street animation
 34484 CALL 34769 ; Restore the background behind the first hood
 34487 CALL 34779 ; Draw the first hood
 34490 CALL 34759 ; Restore the background behind the second hood
 34493 CALL 34798 ; Draw the second hood
 34496 CALL 34817 ; Draw the five-byte-wide graphic
 34499 CALL 34643 ; Move the first hood on
 34502 CALL 34707 ; Move the second hood on
 34505 LD A,(37101) ; A=the first hood's screen address
 34508 AND 31 ; Column
 34510 CP 30 ; Column 30?
