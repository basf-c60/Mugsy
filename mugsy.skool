 26639 DEFB 28,58 ; VM: LOAD K20
 26641 DEFB 15,33 ; VM: STORE Tmp
*26643 DEFB 21,15,33 ; VM: SUB Score,Tmp
 26646 DEFB 15,15 ; VM: STORE Score
 26648 DEFB 21,17,70 ; VM: SUB TotalProfit,K25c
 26651 DEFB 23,58 ; VM: MUL K20
 26653 DEFB 27 ; VM: INT
 26654 DEFB 15,33 ; VM: STORE Tmp
 26656 DEFB 5,40,33,41,104 ; VM: IFLE Km010,Tmp,#R26665
 26661 DEFB 28,40 ; VM: LOAD Km010
 26663 DEFB 15,33 ; VM: STORE Tmp
*26665 DEFB 8,69,33,50,104 ; VM: IFGE K10,Tmp,#R26674
 26670 DEFB 28,69 ; VM: LOAD K10
 26672 DEFB 15,33 ; VM: STORE Tmp
*26674 DEFB 18,15,33 ; VM: ADD Score,Tmp
 26677 DEFB 15,15 ; VM: STORE Score
 26679 DEFB 8,64,15,64,104 ; VM: IFGE K100,Score,#R26688
 26684 DEFB 28,64 ; VM: LOAD K100
 26686 DEFB 15,15 ; VM: STORE Score
*26688 DEFB 6,72,15,80,104 ; VM: IFLT K0,Score,#R26704
 26693 DEFB 28,72 ; VM: LOAD K0
 26695 DEFB 15,15 ; VM: STORE Score
 26697 DEFB 11,1,104,132 ; VM: POKE 1,#R33896
 26701 DEFB 13,90,104 ; VM: GOTO #R26714
*26704 DEFB 26,15,69 ; VM: DIV Score,K10
 26707 DEFB 27 ; VM: INT
 26708 DEFB 17,43 ; VM: ADD K2
 26710 DEFB 25,64 ; VM: DIV K100
 26712 DEFB 15,33 ; VM: STORE Tmp
*26714 DEFB 14,116,104 ; VM: CALL #R26740 (choose the end-of-game rating)
 26717 DEFB 1,34,206,8,0,0,15 ; VM: SAY #R52770,8 "You were <msg 0>. You scored (Score)%. Hows about another game, Mugsy?"
 26724 DEFB 14,105,108 ; VM: CALL #R27753 (get a yes/no answer)
 26727 DEFB 12,111,104 ; VM: JZ #R26735
 26730 DEFB 11,1,105,132 ; VM: POKE 1,#R33897
 26734 DEFB 0 ; VM: END
*26735 DEFB 11,2,105,132 ; VM: POKE 2,#R33897
 26739 DEFB 0 ; VM: END

; VM native: choose the end-of-game rating
;
; Called from the VM script at #R26714. Uses the value in v33 (the score divided into bands) to pick one of the rating words ("lousy", "ghastly", "swell" and so on) from the table at #R53301, and stores its address as the default sub-message (#R33898) for the "You were ..." message.
c26740 LD L,33 ; L=33 (v33: the rating number worked out by the script)
 26742 CALL 31201 ; Load it into BCDE
 26745 LD A,E ; A=low byte
 26746 CALL 26753 ; Get the address of the rating word
 26749 LD (33898),HL ; Make it the default sub-message for the "You were ..." message
 26752 RET ; Done: HL points at the rating word

; Get the address of a rating word
;
; Returns the address of rating word number A (1-11) in the table of words at #R53301. Any other value, including 0, gives the twelfth word, "terrific", which has no end code (see #LINK(Bugs#terrific)(the bugs page)).
;
; Input:A Rating number
; Output:HL Address of the word
c26753 LD HL,53301 ; Rating 1: "lousy"
 26756 DEC A ; Count the rating down
 26757 RET Z ; Return if this is the one
 26758 LD HL,53303 ; Rating 2: "real bad"
 26761 DEC A ; Count the rating down
 26762 RET Z ; Return if this is the one
 26763 LD HL,53307 ; Rating 3: "terrible"
 26766 DEC A ; Count the rating down
 26767 RET Z ; Return if this is the one
 26768 LD HL,53313 ; Rating 4: "ghastly"
 26771 DEC A ; Count the rating down
 26772 RET Z ; Return if this is the one
 26773 LD HL,53322 ; Rating 5: "poor"
 26776 DEC A ; Count the rating down
 26777 RET Z ; Return if this is the one
 26778 LD HL,53328 ; Rating 6: "so-so"
 26781 DEC A ; Count the rating down
 26782 RET Z ; Return if this is the one
 26783 LD HL,53332 ; Rating 7: "fair"
 26786 DEC A ; Count the rating down
 26787 RET Z ; Return if this is the one
 26788 LD HL,53338 ; Rating 8: "good"
 26791 DEC A ; Count the rating down
 26792 RET Z ; Return if this is the one
 26793 LD HL,53340 ; Rating 9: "okay"
 26796 DEC A ; Count the rating down
 26797 RET Z ; Return if this is the one
 26798 LD HL,53342 ; Rating 10: "great"
 26801 DEC A ; Count the rating down
 26802 RET Z ; Return if this is the one
 26803 LD HL,53344 ; Rating 11: "swell"
 26806 DEC A ; Count the rating down
 26807 RET Z ; Return if this is the one
 26808 LD HL,53351 ; Anything else (including 0): "terrific" (see #LINK(Bugs#terrific)(the bugs page))
 26811 RET ; Done: HL points at the rating word

; Draw the picture for a speech bubble layout
;
; IY points at a 4-byte bubble layout entry: byte 0 is the bubble placement chance, bytes 1-2 are the address of the picture data and byte 3 is the border colour. If the same layout is still on screen (33906=0) the screen is left alone except that the speech bubbles are wiped (cells with attribute 120 cleared); otherwise the screen is cleared and the picture is redrawn by #R31247.
;
; Input:IY Layout entry
@label=DRAWLAYOUT
c26812 LD A,(IY+3) ; Set the border colour for this layout
 26815 OUT (254),A ; Set the border to the layout's colour
 26817 PUSH HL ; Keep the caller's HL
 26818 LD L,(IY+1) ; Pick up the address of the layout's picture
 26821 LD H,(IY+2) ; H=high byte of the picture address (HL=picture address)
 26824 EX (SP),HL ; HL=the caller's HL again; the picture address is on the stack
 26825 POP IY ; IY=picture data
 26827 LD A,(33906) ; Has the layout changed?
 26830 AND A ; Test the layout-changed flag
 26831 JP NZ,31247 ; If so, draw the whole picture
 26834 PUSH HL ; Otherwise just wipe the speech bubbles: they are the cells with attribute 120
 26835 PUSH DE ; Save DE...
 26836 PUSH BC ; ...and BC
 26837 LD HL,16384 ; HL=display file
 26840 LD DE,22528 ; DE=attribute file
 26843 LD A,D ; Reached the end of the attribute file?
 26844 CP 91 ; Is this the end of the attribute file (high byte 91)?
 26846 JR Z,26872 ; Finish if so
 26848 LD A,(DE) ; Is this cell part of a bubble (bright white)?
 26849 CP 120 ; Is the cell bright white paper (a bubble cell)?
 26851 JR NZ,26862 ; Jump if not
 26853 PUSH HL ; Keep the cell's address
 26854 LD B,8 ; Clear the 8 pixel rows of the cell
 26856 LD (HL),0 ; Clear one pixel row of the cell
 26858 INC H ; Down to the next pixel row
 26859 DJNZ 26856 ; Repeat for all eight pixel rows
 26861 POP HL ; Back to the top of the cell
 26862 INC DE ; Next attribute
 26863 INC L ; Next cell
 26864 JR NZ,26843 ; Jump back unless a third of the screen is done
 26866 LD A,H ; A=H: the current screen third...
 26867 ADD A,8 ; Move to the next third
 26869 LD H,A ; H=the next third
 26870 JR 26843 ; Carry on with the next cell
 26872 POP BC ; Restore BC...
 26873 POP DE ; ...DE...
 26874 POP HL ; ...and HL
 26875 RET ; Done: all speech bubbles are wiped

; Wait for a key to be pressed or for a timeout
;
; First waits until all keys are released, then waits (up to A periods of about one second each) for a key to be pressed. Used after each speech bubble.
;
; Input:A Number of timeout periods
@label=WAITKEY
c26876 PUSH AF ; Save AF...
 26877 PUSH BC ; ...and BC
 26878 LD B,A ; B=number of timeout periods
 26879 XOR A ; Select every keyboard half-row (high byte of the port = 0)
 26880 IN A,(254) ; Read every half-row of the keyboard
 26882 AND 31 ; Keep the key bits only
 26884 CP 31 ; Are all keys released?
 26886 JR NZ,26879 ; Wait until they are
 26888 CALL 26898 ; Wait about a second for a keypress
 26891 JR NZ,26895 ; Finish if a key was pressed
 26893 DJNZ 26888 ; Otherwise try again for up to B periods
 26895 POP BC ; Restore BC...
 26896 POP AF ; ...and AF
 26897 RET ; Done: Z set if the time ran out, NZ if a key was pressed

; Wait for a keypress with a timeout (one period)
;
; Returns with the zero flag reset if a key was pressed.
c26898 PUSH BC ; Save BC
 26899 LD BC,54600 ; BC=loop count (about one second)
 26902 CALL 26907 ; Wait for a key or the timeout
 26905 POP BC ; Restore BC
 26906 RET ; Done

; Wait for a keypress for up to BC iterations
;
; Returns with the zero flag reset as soon as a key is pressed, or with the zero flag set after BC loops.
;
; Input:BC Loop count
c26907 XOR A ; A=0: select every keyboard half-row
 26908 IN A,(254) ; Read every half-row of the keyboard
 26910 AND 31 ; Keep the key bits
 26912 CP 31 ; Is any key pressed?
 26914 RET NZ ; Return (zero flag reset) if so
 26915 DEC BC ; Count down
 26916 LD A,B ; Is BC zero? Test B...
 26917 OR C ; ...together with C
 26918 JR NZ,26907 ; Keep waiting until BC is zero
 26920 RET ; Return with the zero flag set (timeout)

; Get the address of a character in the font
;
; The proportional font at #R27087 has 7 bytes per character (a width byte and six rows of pixels), starting with character 32. This routine computes 26863+7*A.
;
; Input:A Character code
; Output:HL Address of the character's width byte
@label=CHARADDR
c26921 PUSH DE ; Save DE
 26922 LD L,A ; HL=A
 26923 LD H,0 ; HL=the character code
 26925 LD E,A ; DE=A
 26926 LD D,H ; DE=the character code
 26927 ADD HL,HL ; HL=2*code
 26928 ADD HL,HL ; HL=4*code
 26929 ADD HL,HL ; HL=8*A
 26930 AND A ; Clear the carry flag
 26931 SBC HL,DE ; HL=7*A
 26933 LD DE,26863 ; Add #R26863 (the font minus 7*32)
 26936 ADD HL,DE ; HL=address of the glyph
 26937 POP DE ; Restore DE
 26938 RET ; Done

; The current character
b26939 DEFB 0

; Print a character in the proportional font
;
; Prints character A at pixel offset C within the cell at HL. The glyph is six pixels high and starts one pixel row down. Characters may straddle two cells, so each row is shifted into place by #R27021, which also clears the pixels behind the glyph. The dollar sign and the comma get a seventh row (a tail below the line). On exit C and L have been moved past the character plus one pixel of spacing.
;
; Input:A Character code
; C Pixel offset (0-7) within the current cell
; HL Display file address
; Output:C Updated pixel offset
; L Updated column
@label=PRINTCHAR
c26940 LD (26939),A ; Remember the character
 26943 PUSH AF ; Save the character...
 26944 PUSH BC ; ...and the registers
 26945 PUSH DE ; (DE)
 26946 PUSH HL ; (HL, the screen address)
 26947 CALL 26921 ; Get the address of its glyph
 26950 EX DE,HL ; DE=glyph
 26951 POP HL ; Restore the screen address
 26952 PUSH HL ; Keep the screen address
 26953 INC H ; Start one pixel row down
 26954 LD A,(DE) ; A=width
 26955 INC DE ; Point at the first row
 26956 PUSH AF ; Save the width
 26957 LD B,A ; Build a mask of width+1 zero bits...
 26958 INC B ; One more bit of mask than the width
 26959 LD A,255 ; Start from a full byte
 26961 SRL A ; Shift in a zero from the left
 26963 DJNZ 26961 ; Shift again until the mask has the right number of leading zeros
 26965 LD (27019),A ; ...and store it
 26968 LD B,6 ; Six rows
 26970 CALL 27020 ; Print a row
 26973 INC DE ; Step on to the next row of the glyph
 26974 INC H ; Next pixel row
 26975 DJNZ 26970 ; Repeat for six rows
 26977 LD A,(26939) ; Was it a dollar sign?
 26980 CP 36 ; Is it a dollar sign (36)?
 26982 JR NZ,26991 ; Jump if not
 26984 LD A,32 ; Add the tail of the dollar sign below the line
 26986 CALL 27021 ; Print the extra pixel row
 26989 JR 27000 ; Skip the comma test
 26991 CP 44 ; A comma?
 26993 JR NZ,27000 ; Jump if not
 26995 LD A,128 ; Add the tail of the comma below the line
 26997 CALL 27021 ; Print the extra pixel row
 27000 POP AF ; A=width
 27001 POP HL ; Restore the screen address
 27002 POP DE ; Restore DE
 27003 POP BC ; Restore BC
 27004 ADD A,C ; Add the old pixel offset
 27005 INC A ; +1 pixel of spacing
 27006 CP 8 ; Into the next cell?
 27008 JR C,27015 ; Jump if not
 27010 SUB 8 ; Subtract the 8 pixels already passed
 27012 INC L ; Move to the next cell
 27013 JR 27006 ; Check again
 27015 LD C,A ; C=new pixel offset
 27016 POP AF ; Restore the character
 27017 RET ; Done: HL, C updated to the next print position

; The glyph mask
b27018 DEFB 255,0

; Print one pixel row of a glyph (from DE)
;
; Fetches the row byte at DE and falls through to #R27021.
c27020 LD A,(DE) ; Pick up the pixel row

; Print one pixel row of a glyph
;
; Shifts the pixel row in A right by C bits across a 16-bit word and ORs it into the two screen bytes at HL and HL+1, using the mask at #R27018.
;
; Input:A Pixel row
; C Pixel offset
; HL Display file address
c27021 PUSH DE ; Save DE
 27022 LD D,A ; D=pixel row
 27023 LD E,0 ; E=0 (the overflow into the next cell)
 27025 PUSH BC ; Save BC
 27026 LD A,C ; A=pixel offset
 27027 LD BC,(27018) ; BC=glyph mask
 27031 AND A ; Is the offset 0?
 27032 JR Z,27046 ; Jump if so
 27034 SRL D ; Shift the row right one pixel...
 27036 RR E ; The bits that fall off go into E
 27038 SCF ; ...and the mask, bringing in a 1
 27039 RR B ; Shift a 1 into the mask (B)...
 27041 RR C ; ...and on into C
 27043 DEC A ; One fewer shift to go
 27044 JR NZ,27034 ; Repeat for each pixel of the offset
 27046 LD A,B ; Clear the pixels behind the glyph in the first cell...
 27047 AND (HL) ; Keep the background pixels outside the glyph
 27048 OR D ; ...and draw the left part of the row
 27049 LD (HL),A ; Store the combined byte
 27050 INC L ; Next cell
 27051 LD A,C ; Do the same for the second cell
 27052 AND (HL) ; Keep the background pixels in the second cell
 27053 OR E ; Add the overflow from the shifted row
 27054 LD (HL),A ; Store it
 27055 DEC L ; Back to the first cell
 27056 POP BC ; Restore BC
 27057 POP DE ; Restore DE
 27058 RET ; Done

; The attribute for the status line
b27059 DEFB 120

; Clear a character cell and set its attribute
;
; Clears the eight bytes of the character cell at HL and sets its attribute to the value at #R27059.
;
; Input:HL Display file address
c27060 PUSH HL ; Save the cell address
 27061 PUSH AF ; Keep the attribute value
 27062 LD A,8 ; 8 pixel rows
 27064 LD (HL),0 ; Clear one
 27066 INC H ; Next pixel row
 27067 DEC A ; One fewer row to clear
 27068 JR NZ,27064 ; Repeat for all eight rows
 27070 LD A,H ; Work out the attribute address from the display file address
 27071 DEC A ; H-1: the display file third is now 0-2 in bits 3-4
 27072 RRCA ; Move the third number...
 27073 RRCA ; ...down into the low bits...
 27074 RRCA ; ...(three rotates)
 27075 AND 3 ; Keep the two bits of the third
 27077 ADD A,88 ; Add the high byte of the attribute file
 27079 LD H,A ; H=attribute address high byte
 27080 LD A,(27059) ; Set the attribute
 27083 LD (HL),A ; Set the cell's attribute
 27084 POP AF ; Restore the attribute value
 27085 POP HL ; Restore the screen address
 27086 RET ; Done: the cell is blank with the new attribute

; Proportional font
;
; Used by #R26940 for the text in the speech bubbles. Each character has 7 bytes: the width in pixels followed by six pixel rows (the font is only six pixels high). Characters 32-122 are present; lower case letters are drawn as small capitals. #HTML[<img src="../images/font.png" alt="The proportional font" />]
b27087 DEFB 2,0,0,0,0,0,0 ; Character 32 (space): width 2
 27094 DEFB 1,0,128,128,128,0,128 ; Character 33 (!): width 1
 27101 DEFB 3,160,160,0,0,0,0 ; Character 34 (double quote): width 3
 27108 DEFB 5,0,80,248,80,248,80 ; Character 35 (#): width 5
 27115 DEFB 5,32,248,160,248,40,248 ; Character 36 ($): width 5
 27122 DEFB 5,0,200,144,32,72,152 ; Character 37 (%): width 5
 27129 DEFB 5,64,160,64,168,144,232 ; Character 38 (&): width 5
 27136 DEFB 2,64,128,0,0,0,0 ; Character 39 ('): width 2
 27143 DEFB 2,64,128,128,128,128,64 ; Character 40 ((): width 2
 27150 DEFB 2,128,64,64,64,64,128 ; Character 41 ()): width 2
 27157 DEFB 5,0,80,32,248,32,80 ; Character 42 (*): width 5
 27164 DEFB 5,0,32,32,248,32,32 ; Character 43 (+): width 5
 27171 DEFB 2,0,0,0,0,64,64 ; Character 44 (,): width 2
 27178 DEFB 4,0,0,0,240,0,0 ; Character 45 (-): width 4
 27185 DEFB 2,0,0,0,0,128,128 ; Character 46 (.): width 2
 27192 DEFB 5,0,8,16,32,64,128 ; Character 47 (/): width 5
 27199 DEFB 4,0,96,144,144,144,96 ; Character 48 (0): width 4
 27206 DEFB 3,0,64,192,64,64,224 ; Character 49 (1): width 3
 27213 DEFB 4,0,96,144,32,64,240 ; Character 50 (2): width 4
 27220 DEFB 4,0,96,144,32,144,96 ; Character 51 (3): width 4
 27227 DEFB 4,0,32,96,160,240,32 ; Character 52 (4): width 4
 27234 DEFB 4,0,224,128,224,16,224 ; Character 53 (5): width 4
 27241 DEFB 4,0,96,128,224,144,96 ; Character 54 (6): width 4
 27248 DEFB 4,0,240,16,32,64,64 ; Character 55 (7): width 4
 27255 DEFB 4,0,96,144,96,144,96 ; Character 56 (8): width 4
 27262 DEFB 4,0,96,144,112,16,96 ; Character 57 (9): width 4
 27269 DEFB 1,0,0,128,0,128,0 ; Character 58 (:): width 1
 27276 DEFB 2,0,0,64,0,64,64 ; Character 59 (;): width 2
 27283 DEFB 3,0,32,64,128,64,32 ; Character 60 (<): width 3
 27290 DEFB 4,0,0,240,0,240,0 ; Character 61 (=): width 4
 27297 DEFB 3,0,128,64,32,64,128 ; Character 62 (>): width 3
 27304 DEFB 5,112,136,16,32,0,32 ; Character 63 (?): width 5
 27311 DEFB 5,0,112,168,176,128,112 ; Character 64 (@): width 5
 27318 DEFB 6,112,136,136,248,136,136 ; Character 65 (A): width 6
 27325 DEFB 6,240,136,240,136,136,240 ; Character 66 (B): width 6
 27332 DEFB 6,112,136,128,128,136,112 ; Character 67 (C): width 6
 27339 DEFB 6,224,144,136,136,144,224 ; Character 68 (D): width 6
 27346 DEFB 6,248,128,240,128,128,248 ; Character 69 (E): width 6
 27353 DEFB 6,248,128,240,128,128,128 ; Character 70 (F): width 6
 27360 DEFB 6,112,136,128,184,136,112 ; Character 71 (G): width 6
 27367 DEFB 6,136,136,248,136,136,136 ; Character 72 (H): width 6
 27374 DEFB 5,248,32,32,32,32,248 ; Character 73 (I): width 5
 27381 DEFB 6,8,8,8,136,136,112 ; Character 74 (J): width 6
 27388 DEFB 5,144,160,192,160,144,136 ; Character 75 (K): width 5
 27395 DEFB 5,128,128,128,128,128,248 ; Character 76 (L): width 5
 27402 DEFB 6,136,216,168,136,136,136 ; Character 77 (M): width 6
 27409 DEFB 6,136,200,168,168,152,136 ; Character 78 (N): width 6
 27416 DEFB 6,112,136,136,136,136,112 ; Character 79 (O): width 6
