; Bar-room animation: step table
;
; Used by #R34040.
w36348 DEFW 36366,36495,36508,36527
 36356 DEFW 36546,36566,36572,36495
 36364 DEFW 36486

; Bar-room animation: step 1 (set up)
;
; Draws the Partridge Club picture at #R53793 and initialises the frame pointers and timers for the animated customers, waiters and hoods.
c36366 XOR A ; A=0
 36367 OUT (254),A ; Black border
 36369 XOR A ; A=0
 36370 LD (36702),A ; Figure 1 starts in its first state
 36373 LD (36910),A ; Figure 6 starts in its first state
 36376 LD (36860),A ; Figure 5 starts in its first state
 36379 LD (36960),A ; Figure 7 starts in its first state (bit 7 clear: it may move)
 36382 LD A,128 ; A=128
 36384 LD (37031),A ; Figure 8 starts out of action (bit 7 set)
 36387 LD A,1 ; A=1: every counter starts at 1, so each figure moves on the first tick
 36389 LD (36663),A ; Counter for the hoods' route
 36392 LD (36701),A ; Counter for figure 1
 36395 LD (36859),A ; Counter for figure 5
 36398 LD (36909),A ; Counter for figure 6
 36401 LD (36959),A ; Counter for figure 7
 36404 LD (37030),A ; Counter for figure 8
 36407 LD (36751),A ; Counter for figure 2
 36410 LD (36787),A ; Counter for figure 3
 36413 LD (36823),A ; Counter for figure 4
 36416 LD HL,41154 ; HL=the first entry of the hoods' route table
 36419 LD (41152),HL ; Store it as the route pointer
 36422 LD A,1 ; A=1
 36424 LD (36616),A ; Counter for the hoods walking through the club
 36427 LD HL,39926 ; HL=the first frame of the walking hoods
 36430 LD (39924),HL ; Store it as the frame pointer
 36433 LD HL,40249 ; HL=the first frame of figure 1
 36436 LD (40194),HL ; Store it
 36439 LD HL,40759 ; HL=the first frame of figure 5
 36442 LD (40694),HL ; Store it
 36445 LD HL,40872 ; HL=the first frame of figure 6
 36448 LD (40822),HL ; Store it
 36451 LD HL,40973 ; HL=the first frame of figure 7
 36454 LD (40920),HL ; Store it
 36457 LD HL,41089 ; HL=the first frame of figure 8
 36460 LD (41024),HL ; Store it
 36463 LD HL,53793 ; HL=the compressed picture of the Partridge Club
 36466 CALL 32126 ; Draw it
 36469 LD DE,(41024) ; DE=figure 8's frame pointer
 36473 INC DE ; Skip the link to the next frame...
 36474 INC DE ; ...to the sprite
 36475 CALL 37095 ; Draw figure 8 for the first time
 36478 LD HL,500 ; HL=500
 36481 LD (36493),HL ; The first pause lasts 500 ticks
 36484 XOR A ; A=0: the step is complete
 36485 RET ; Return

; Bar-room animation: last step (end the animation)
c36486 LD A,1 ; A=1
 36488 LD (33993),A ; Mark the animation as finished
 36491 DEC A ; A=0
 36492 RET ; Return (zero flag set: the step is complete)

; Bar-room animation: pause counter
;
; A 16-bit tick counter used by #R36495. It is set to 500 at #R36481 for the first pause (before the door opens) and to 400 at #R36582 for the final pause.
b36493 DEFB 0,0 ; Pause counter (word)

; Bar-room animation: count down the delay
c36495 CALL 36586 ; Animate all the figures
 36498 LD HL,(36493) ; HL=the pause counter
 36501 DEC HL ; One tick less
 36502 LD (36493),HL ; Store it
 36505 LD A,H ; A=H
 36506 OR L ; Combine with L to test for zero
 36507 RET ; Return (Z set when the pause is over)

; Bar-room animation: animate and wait for the door to open
c36508 CALL 36586 ; Animate all the figures
 36511 CALL 36664 ; Advance the hoods along their route
 36514 RET NZ ; Return until the route entry is finished
 36515 LD HL,41200 ; HL=the next route (41200)
 36518 LD (41152),HL ; Use it
 36521 LD A,1 ; A=1
 36523 LD (36663),A ; Make the route routine fetch its first entry at once
 36526 RET ; Return

; Bar-room animation: the hoods walk in
c36527 CALL 36703 ; Animate figure 1
 36530 CALL 36664 ; Advance the hoods along their route
 36533 RET NZ ; Return until the route entry is finished
 36534 LD HL,41221 ; HL=the next route (#R41221)
 36537 LD (41152),HL ; Use it
 36540 LD A,1 ; A=1
 36542 LD (36663),A ; Fetch the first entry at once
 36545 RET ; Return

; Bar-room animation: the hoods cross the room
c36546 CALL 36703 ; Animate figure 1
 36549 CALL 36664 ; Advance the hoods along their route
 36552 JR NZ,36569 ; Not finished: draw the walking hoods
 36554 LD HL,41237 ; HL=the next route (#R41237)
 36557 LD (41152),HL ; Use it
 36560 LD A,1 ; A=1
 36562 LD (36663),A ; Fetch the first entry at once
 36565 RET ; Return

; Bar-room animation: the hoods go out
c36566 CALL 36703 ; Animate figure 1
 36569 JP 36617 ; Animate the hoods walking

; Bar-room animation: final pause
c36572 CALL 36703 ; Animate figure 1
 36575 CALL 36664 ; Advance the hoods along their route
 36578 RET NZ ; Return until the route is finished
 36579 LD HL,400 ; HL=400
 36582 LD (36493),HL ; Pause for 400 ticks
 36585 RET ; Return

; Bar-room animation: update all the animated figures
c36586 CALL 36703 ; Animate figure 1
 36589 CALL 36752 ; Animate figure 2
 36592 CALL 36788 ; Animate figure 3
 36595 CALL 36824 ; Animate figure 4
 36598 CALL 36861 ; Animate figure 5
 36601 CALL 36911 ; Animate figure 6
 36604 CALL 36961 ; Animate figure 7
 36607 JP 37032 ; Animate figure 8 and return

; Get a random delay
;
; A=B+random(0..C).
;
; Input:B Minimum
; C Range
c36610 LD A,C ; A=the range
 36611 CALL 30014 ; A=a random number from 0 to C
 36614 ADD A,B ; Add the minimum
 36615 RET ; Return

; Bar-room animation: walking hoods counter
;
; Ticks left until the next frame of the hoods walking through the club (see #R36617). It starts at 1 so the first frame is drawn at once, and is then reloaded with the duration of each frame from the list at 39924.
b36616 DEFB 1 ; Ticks until the next frame

; Bar-room animation: animate the hoods walking through the club
c36617 LD A,(36616) ; A=the counter
 36620 DEC A ; One tick less
 36621 LD (36616),A ; Store it
 36624 RET NZ ; Not time for a new frame
 36625 LD HL,(39924) ; HL=the position in the walking hoods' list
 36628 LD A,(HL) ; A=the number of ticks this frame lasts
 36629 AND A ; Test it
 36630 RET Z ; Zero marks the end of the list: stop
 36631 INC HL ; Next byte
 36632 LD (36616),A ; Store it as the new counter
 36635 CP 2 ; Is the delay 2?
 36637 LD B,1 ; B=1
 36639 PUSH HL ; Save the list position
 36640 CALL Z,41997 ; If so, wait a moment (a step sound)
 36643 POP HL ; Restore the list position
 36644 LD E,(HL) ; E=the low byte of the record address
 36645 INC HL ; Next byte
 36646 LD D,(HL) ; D=the high byte
 36647 INC HL ; Next byte
 36648 LD (39924),HL ; Store the new list position
 36651 EX DE,HL ; HL=the record: the screen address then the sprite
 36652 LD E,(HL) ; E=the screen address, low byte
 36653 INC HL ; Next byte
 36654 LD D,(HL) ; D=high byte
 36655 INC HL ; Next byte
 36656 EX DE,HL ; HL=the screen address, DE=the sprite
 36657 CALL 34097 ; Draw the three-cell-wide sprite
 36660 OR 1 ; Clear the zero flag: the step is not complete
 36662 RET ; Return

; Bar-room animation: route counter
;
; Ticks left before #R36664 fetches the next entry from the hoods' route table. Setting it to 1 (#R36389, #R36523, #R36542 and #R36562) makes the routine fetch an entry at once.
b36663 DEFB 1 ; Ticks until the next route entry

; Bar-room animation: advance along the hoods' route table
c36664 LD A,(36663) ; A=the counter
 36667 DEC A ; One tick less
 36668 LD (36663),A ; Store it
 36671 RET NZ ; Not time for a new entry
 36672 LD HL,(41152) ; HL=the route pointer
 36675 LD A,(HL) ; A=the number of ticks this entry lasts
 36676 AND A ; Test it
 36677 RET Z ; Zero marks the end of the route
 36678 INC HL ; Next byte
 36679 LD (36663),A ; Store it as the new counter
 36682 LD E,(HL) ; E=the screen address, low byte
 36683 INC HL ; Next byte
 36684 LD D,(HL) ; D=high byte
 36685 INC HL ; Next byte
 36686 PUSH DE ; Save the screen address
 36687 LD E,(HL) ; E=the sprite address, low byte
 36688 INC HL ; Next byte
 36689 LD D,(HL) ; D=high byte
 36690 INC HL ; Next byte
 36691 LD (41152),HL ; Store the new route pointer
 36694 POP HL ; HL=the screen address
 36695 CALL 34093 ; Draw the two-cell-wide sprite
 36698 OR 1 ; Clear the zero flag: the route is not finished
 36700 RET ; Return

; Bar-room animation: figure 1 counter and state
;
; Used by #R36703. The counter counts down to the next frame; when it expires the state flips between 0 and 1, which chooses a long wait (60-100 ticks) or a short one (10-30 ticks), and the next frame is drawn.
b36701 DEFB 1 ; Counter
 36702 DEFB 0 ; State (0 or 1)

; Bar-room animation: animate figure 1 (at 21584)
c36703 LD A,(36701) ; A=figure 1's counter
 36706 DEC A ; One tick less
 36707 LD (36701),A ; Store it
 36710 RET NZ ; Not time to change yet
 36711 LD A,(36702) ; A=figure 1's state
 36714 XOR 1 ; Flip it
 36716 LD (36702),A ; Store it
 36719 LD BC,15400 ; BC=the long delay range (minimum 60, up to 40 more ticks)
 36722 JR Z,36727 ; State 0: use the long delay
 36724 LD BC,2580 ; BC=the short delay range (minimum 10, up to 20 more ticks)
 36727 CALL 36610 ; A=a random delay
 36730 LD (36701),A ; Set the counter
 36733 LD HL,(40194) ; HL=figure 1's frame pointer
 36736 LD E,(HL) ; E=the next frame's address, low byte
 36737 INC HL ; Next byte
 36738 LD D,(HL) ; D=high byte
 36739 INC HL ; Next byte
 36740 LD (40194),DE ; Store the pointer to the next frame
 36744 EX DE,HL ; DE=the sprite
 36745 LD HL,21584 ; HL=figure 1's screen address
 36748 JP 34093 ; Draw the sprite

