; Print a character using the ROM font
;
; Used for the status line at the bottom of the screen. Copies the 8x8 glyph from the ROM character set (15360+8*A) to the cell at HL, then moves HL one cell right.
;
; Input:A Character code
; HL Display file address
@label=ROMCHAR
c27724 PUSH DE ; Save DE (the screen address)
 27725 PUSH BC ; Save BC...
 27726 PUSH HL ; ...and HL
 27727 LD L,A ; HL=character code
 27728 LD H,0 ; HL=character code
 27730 ADD HL,HL ; HL=2*code
 27731 ADD HL,HL ; HL=4*code
 27732 ADD HL,HL ; HL=8*code
 27733 LD DE,15360 ; Add 15360 (the ROM character set minus 256)
 27736 ADD HL,DE ; HL=address of the glyph in the ROM font
 27737 POP DE ; DE=screen address
 27738 PUSH DE ; Keep the screen address
 27739 EX DE,HL ; HL=screen, DE=glyph
 27740 LD B,8 ; 8 pixel rows
 27742 LD A,(DE) ; Copy a row
 27743 LD (HL),A ; Store the glyph row on the screen
 27744 INC DE ; Next glyph row
 27745 INC H ; Next pixel row
 27746 DJNZ 27742 ; Repeat for all 8 rows
 27748 POP HL ; HL=screen address
 27749 POP BC ; Restore BC
 27750 POP DE ; Restore DE
 27751 INC L ; Move one cell right
 27752 RET ; Done: the character is on screen and HL has moved right

; VM native: get a yes/no answer
;
; Reads a line of input and returns with the zero flag set for "Y" or "y" and reset for "N" or "n". Any other answer makes Louey say "Don't get smart wit' me, Mugsy!..." (script at #R27785) and asks again.
@label=YESNO
c27753 CALL 28037 ; Read a line of input
 27756 LD A,(23808) ; Pick up the first character
 27759 CP 89 ; "Y"?
 27761 RET Z ; Return with the zero flag set if so
 27762 CP 121 ; "y"?
 27764 RET Z ; Return with the zero flag set (yes)
 27765 CP 78 ; "N"?
 27767 JR Z,27782 ; Jump if so
 27769 CP 110 ; "n"?
 27771 JR Z,27782 ; Jump if so (no)
 27773 LD IY,27785 ; Otherwise Louey says "Don't get smart wit' me, Mugsy!..."
 27777 CALL 30092 ; Run the script that says "Don't get smart wit' me"
 27780 JR 27753 ; And asks again
 27782 OR 1 ; Reset the zero flag for "no"
 27784 RET ; Return with the zero flag reset (no)

; VM script: complain about a yes/no answer
b27785 DEFB 1,228,206,8 ; VM: SAY #R52964,8 "Don't get smart wit' me, Mugsy! Just " yeah" or " nope" is fine."
 27789 DEFB 0 ; VM: END

; VM native: get a number from the player
;
; Reads a line of input and parses it into v35 (in hundredths, like all VM numbers). On an invalid entry Louey complains (script at #R27807 or #R27828 for fractions) and the blunder count v11 goes up. Flag 8 (#R33896) is set to the type of the answer: 1 = negative, 2 = zero, 3 = 0.01 (not possible from the keyboard), 4 = anything else.
@label=GETNUMBER
c27790 CALL 28037 ; Read a line of input
 27793 CALL 27869 ; Parse it as a number into v35
 27796 JR NZ,27817 ; Jump unless it was invalid
 27798 LD IY,27807 ; Louey says "What wuz dat, Boss?..." (and the blunder count goes up)
 27802 CALL 30092 ; Run the script that asks what he said
 27805 JR 27790 ; Ask again

; VM script: complain about an invalid number
;
; Also counts a blunder (v11).
b27807 DEFB 1,125,206,8 ; VM: SAY #R52861,8 "[What wuz dat, Boss? I missed it/It's okay, Boss - this line aint tapped. Let's have the answer]."
*27811 DEFB 18,11,71 ; VM: ADD Blunders,K1
 27814 DEFB 15,11 ; VM: STORE Blunders
 27816 DEFB 0 ; VM: END

; Complain about a fraction and try again
;
; Entered with the carry flag reset when the number contained a decimal point.
c27817 JR NC,27835 ; Jump if there was no decimal point
 27819 LD IY,27828 ; Louey complains about fractions (another blunder)
 27823 CALL 30092 ; Run the script that complains about fractions
 27826 JR 27790 ; Ask again

; VM script: complain about a fraction
b27828 DEFB 1,221,206,8 ; VM: SAY #R52957,8 "[Geez, Boss, fractions makes my head hurt. Gimme a good answer./Cripes, Boss, don't make wit' da fractions. I never did learn to dig them. Let's have it in good numbers!]"
 27832 DEFB 13,163,108 ; VM: GOTO #R27811

; Classify the number entered
;
; Sets flag 8 (#R33896) according to the value in BCDE: 1 if negative, 2 if zero, 3 if exactly 1 (0.01), 4 otherwise.
;
; Input:BCDE Number
c27835 BIT 7,B ; Is the number negative?
 27837 JR Z,27845 ; Jump if not
 27839 LD A,1 ; Type 1: negative
 27841 LD (33896),A ; Store the type in flag 8
 27844 RET ; Done
 27845 LD A,B ; Is it at least 2.56?
 27846 OR C ; Combine the upper bytes
 27847 OR D ; ...
 27848 JR NZ,27864 ; Jump if so
 27850 LD A,E ; Is the low byte zero?
 27851 AND A ; Test the low byte
 27852 JR NZ,27858 ; Jump if not
 27854 LD A,2 ; Type 2: zero
 27856 JR 27841 ; Store the type
 27858 CP 1 ; Is it exactly 0.01?
 27860 LD A,3 ; Type 3 if so
 27862 JR Z,27841 ; Store the type
 27864 LD A,4 ; Type 4: anything else
 27866 JR 27841 ; Store the type

; The minus-sign flag
b27868 DEFB 0

; Parse the input buffer as a number
;
; Checks the text at 23808 for an optional sign, digits and a decimal point, then runs the small VM scripts at #R27995, #R28000 and #R28006 to accumulate the value in v35 (each digit: v35=v35*10+digit*100). Returns with the zero flag reset if the entry was not a valid whole number, and with the carry flag reset if it contained a decimal point.
c27869 LD HL,23808 ; Point HL at the input
 27872 LD A,(HL) ; Pick up the first character
 27873 AND A ; Test the first character
 27874 RET Z ; Return (zero flag set: invalid) if the line is empty
 27875 CP 45 ; A minus sign?
 27877 JR Z,27892 ; Jump if so
 27879 CP 43 ; A plus sign?
 27881 JR Z,27892 ; Jump if so
 27883 CP 46 ; A decimal point?
 27885 JP Z,28017 ; Jump if so
 27888 CALL 28021 ; Is it a digit?
 27891 RET Z ; Return (zero flag set: invalid) if not
 27892 INC HL ; Next character
 27893 LD A,(HL) ; A=the next character
 27894 AND A ; End of the line?
 27895 JR Z,27908 ; Jump if so: the entry is valid
 27897 CP 46 ; A decimal point?
 27899 JP Z,28017 ; Jump if so
 27902 CALL 28021 ; A digit?
 27905 RET Z ; Return (invalid) if not
 27906 JR 27892 ; Check the next character
 27908 LD IX,23808 ; Now convert the number
 27912 XOR A ; Clear the minus flag
 27913 LD (27868),A ; Store it: no minus sign yet
 27916 LD A,(IX+0) ; Pick up the first character
 27919 CP 45 ; A minus sign?
 27921 JR NZ,27928 ; Jump if not
 27923 LD (27868),A ; Set the minus flag
 27926 JR 27932 ; Skip over the sign
 27928 CP 43 ; A plus sign?
 27930 JR NZ,27934 ; Jump if not
 27932 INC IX ; Skip the sign
 27934 LD IY,27995 ; Run the VM script that sets v35 to 0
 27938 CALL 30092 ; Run the script: v35=0
 27941 LD A,(IX+0) ; Next character
 27944 AND A ; End of the line?
 27945 JR Z,27980 ; Jump if so
 27947 LD IY,28000 ; Run the VM script that multiplies v35 by 10
 27951 CALL 30092 ; Run the script: v35=v35*10
 27954 LD A,(IX+0) ; A=the digit
 27957 SUB 48 ; Convert it from ASCII
 27959 LD E,A ; BCDE=digit
 27960 LD D,0 ; D=0
 27962 LD B,D ; B=0
 27963 LD C,D ; C=0: BCDE=the digit
 27964 LD L,33 ; Store it in v33
 27966 CALL 31179 ; Store the digit in v33
 27969 LD IY,28006 ; Run the VM script that adds 100*v33 to v35
 27973 CALL 30092 ; Run the script: add 100*v33 to v35 (the number is kept in hundredths)
 27976 INC IX ; Next character
 27978 JR 27941 ; Next character
 27980 LD L,35 ; Load v35 into BCDE
 27982 CALL 31201 ; BCDE=the number
 27985 LD A,(27868) ; Was there a minus sign?
 27988 AND A ; Test the minus-sign flag
 27989 CALL NZ,30634 ; Negate the number if so
 27992 OR 1 ; Reset the zero flag: the entry was valid
 27994 RET ; Done: Z set if the entry was invalid, NZ if it was valid

; VM script: set the input value to zero
b27995 DEFB 28,72 ; VM: LOAD K0
 27997 DEFB 15,35 ; VM: STORE Input
 27999 DEFB 0 ; VM: END

; VM script: multiply the input value by 10
b28000 DEFB 24,35,69 ; VM: MUL Input,K10
 28003 DEFB 15,35 ; VM: STORE Input
 28005 DEFB 0 ; VM: END

; VM script: add a digit to the input value
;
; v33 holds the digit; it is multiplied by 100 (the fixed-point scale) and added to v35.
b28006 DEFB 24,33,64 ; VM: MUL Tmp,K100
 28009 DEFB 15,33 ; VM: STORE Tmp
 28011 DEFB 18,35,33 ; VM: ADD Input,Tmp
 28014 DEFB 15,35 ; VM: STORE Input
 28016 DEFB 0 ; VM: END

; Set the "decimal point" result
;
; Returns with the zero flag reset and the carry flag set.
c28017 OR 1 ; Reset the zero flag...
 28019 SCF ; ...and set the carry flag: a decimal point was found
 28020 RET ; Done: NZ and carry set means a decimal point

; Check whether A is a digit
;
; Returns with the carry flag set if A is "0"-"9".
;
; Input:A Character code
; Output:F Carry set if A is a digit
c28021 CP 48 ; Below "0"?
 28023 JR C,28028 ; Jump if so
 28025 CP 58 ; Below ":" (i.e. "0"-"9")?
 28027 RET C ; Return with the carry flag set if so
 28028 XOR A ; Set the zero flag (and reset the carry flag): not a digit
 28029 RET ; Done: Z means not a digit

; Clear a row of character cells
;
; Clears B cells starting at HL (via #R27060).
;
; Input:B Number of cells
; HL Display file address
c28030 CALL 27060 ; Clear a cell and set its attribute
 28033 INC L ; Next cell
 28034 DJNZ 28030 ; Repeat for the whole row of cells
 28036 RET ; Done

; Read a line of input in the answer bubble
;
; Clears the answer bubble on the right of the screen, then reads keys (via #R28221) into the buffer at 23808, echoing them in the proportional font. DELETE (12) and LEFT (8) rub out the last character, ENTER (13) ends the line. The line is terminated with a zero byte.
@label=READLINE
c28037 LD HL,23808 ; Fill the input buffer with 20 spaces
 28040 LD DE,23809 ; DE=the next byte
 28043 LD BC,19 ; BC=19: copy the first space along
 28046 LD (HL),32 ; Put a space in the first byte
 28048 LDIR ; Fill the 20 bytes with spaces
 28050 LD HL,16438 ; Clear the answer bubble, line by line
 28053 LD B,8 ; Eight cells in the row
 28055 CALL 28030 ; Clear the first row of the bubble (8 cells)
 28058 LD HL,16469 ; HL=the second row
 28061 LD B,10 ; B=10 cells
 28063 CALL 28030 ; Clear it
 28066 LD HL,16500 ; HL=the third row
 28069 LD B,12 ; B=12 cells
 28071 CALL 28030 ; Clear it
 28074 LD HL,16533 ; HL=the fourth row
 28077 LD B,10 ; B=10 cells
 28079 CALL 28030 ; Clear it
 28082 LD HL,16566 ; HL=the fifth row
 28085 LD B,8 ; B=8 cells
 28087 CALL 28030 ; Clear it
 28090 LD HL,16604 ; HL=the tail of the bubble
 28093 LD B,2 ; B=2 cells
 28095 CALL 28030 ; Clear it
 28098 LD HL,16637 ; HL=the end of the tail
 28101 LD B,1 ; B=1 cell
 28103 CALL 28030 ; Clear it
 28106 LD HL,18461 ; HL=the last cell of the tail
 28109 LD B,1 ; B=1 cell
 28111 CALL 28030 ; Clear it
 28114 LD HL,16502 ; HL=start of the answer line
 28117 LD C,0 ; C=pixel offset 0
 28119 LD DE,23808 ; DE=input buffer
 28122 LD B,0 ; B counts the characters typed
 28124 CALL 28221 ; Wait for a key (flashing the cursor)
 28127 CP 13 ; ENTER?
 28129 JR Z,28175 ; Finish if so
 28131 CP 8 ; LEFT (CAPS SHIFT+5)?
 28133 JR Z,28178 ; Rub out if so
 28135 CP 12 ; DELETE (CAPS SHIFT+0)?
 28137 JR Z,28178 ; Rub out if so
 28139 CP 32 ; Ignore other control keys
 28141 JR C,28124 ; Control key: ignore it
 28143 CP 128 ; Ignore graphics and keyword codes
 28145 JR NC,28124 ; Graphics or keyword: ignore it
 28147 CALL 26940 ; Echo the character
 28150 INC B ; Count it
 28151 LD (DE),A ; Store it in the buffer
 28152 INC DE ; Next byte of the buffer
 28153 LD A,L ; Has the line reached column 30?
 28154 AND 31 ; Keep the column number
 28156 CP 30 ; Has it reached column 30 (the right-hand end of the bubble)?
 28158 JR NZ,28124 ; Get another key if not
 28160 CALL 28221 ; The line is full: only ENTER or rubbing out will do
 28163 CP 8 ; Rub out?
 28165 JR Z,28178 ; Yes
 28167 CP 12 ; Delete?
 28169 JR Z,28178 ; Yes
 28171 CP 13 ; ENTER?
 28173 JR NZ,28160 ; Not a wanted key: wait for another
 28175 XOR A ; Terminate the input with a zero byte
 28176 LD (DE),A ; Store the terminator
 28177 RET ; Return
 28178 LD A,B ; Anything to rub out?
 28179 AND A ; Test the count
 28180 JR Z,28124 ; Ignore the key if not
 28182 DEC B ; One character fewer
 28183 DEC DE ; Back up in the buffer
 28184 PUSH BC ; Save BC...
 28185 PUSH HL ; ...and HL
 28186 LD A,32 ; Print two spaces over the cursor
 28188 CALL 26940 ; Print a space over the cursor
 28191 CALL 26940 ; And another to erase the character
 28194 POP HL ; Restore the screen position
 28195 POP BC ; Restore the count
 28196 PUSH HL ; Save the screen position
 28197 LD A,(DE) ; Get the width of the character being rubbed out
 28198 CALL 26921 ; Get the glyph address of the character being rubbed out
 28201 LD A,(HL) ; A=its width
 28202 POP HL ; Restore the screen position
 28203 INC A ; +1 pixel of spacing
 28204 SUB C ; Move the print position back by that many pixels
 28205 NEG ; Work out the pixel offset after moving back
 28207 BIT 7,A ; Is the offset negative?
 28209 JR Z,28216 ; No: done
 28211 DEC L ; Back one cell
 28212 ADD A,8 ; Add a cell's 8 pixels
 28214 JR 28207 ; Check again
 28216 LD C,A ; C=new pixel offset
 28217 JR 28124 ; Wait for the next key

; The cursor character
b28219 DEFB 32,0

; Wait for a key, flashing the cursor
;
; Calls #R28266 to wait for a key while flashing an asterisk cursor (every fourth frame) in the answer bubble.
;
; Output:A Key code (from LAST-K)
c28221 CALL 28266 ; Wait one frame and check for a key
 28224 PUSH AF ; Save the key
 28225 PUSH HL ; Save HL
 28226 PUSH BC ; Save BC
 28227 LD A,(28220) ; Advance the flash counter (0-3)
 28230 INC A ; Add one
 28231 AND 3 ; Wrap round after 3
 28233 LD (28220),A ; Store the counter
 28236 LD A,(28219) ; Pick up the cursor character
 28239 JR NZ,28252 ; Jump unless it is time to flash
 28241 CP 32 ; Swap between "*" and a space
 28243 LD A,42 ; A=42: the asterisk cursor
 28245 JR Z,28249 ; It was a space: switch to the asterisk
 28247 LD A,32 ; A=32: a space
 28249 LD (28219),A ; Store the cursor character
 28252 CALL 26940 ; Print the cursor
 28255 LD A,32 ; A=space: blank the next position
 28257 CALL 26940 ; Print it
 28260 POP BC ; Restore BC
 28261 POP HL ; Restore HL
 28262 POP AF ; Restore the key
 28263 JR Z,28221 ; Back for another frame if no key was pressed
 28265 RET ; Return

; Wait one frame and read the keyboard
;
; Enables interrupts long enough for one ROM interrupt (which scans the keyboard), then checks bit 5 of FLAGS to see if a new key has been pressed.
;
; Output:A Key code (if the zero flag is reset)
c28266 PUSH IY ; Save IY
 28268 PUSH HL ; Save HL
 28269 PUSH BC ; Save BC
 28270 LD IY,(33900) ; Restore IY for the ROM interrupt routine
 28274 EI ; Let one interrupt happen (the ROM scans the keyboard)
 28275 HALT ; Wait for the next interrupt
 28276 DI ; Interrupts off again
 28277 LD A,(23611) ; Has a new key been pressed?
 28280 BIT 5,A ; Is the ROM's new-key flag (bit 5 of FLAGS) set?
 28282 JR Z,28292 ; Jump if not
 28284 RES 5,A ; Acknowledge it
 28286 LD (23611),A ; Store the flags
 28289 LD A,(23560) ; A=the key code
 28292 POP BC ; Restore BC
 28293 POP HL ; Restore HL
 28294 POP IY ; Restore IY
 28296 RET ; Return

; VM native: Louey charges hush money for a blunder
;
; Runs the VM script at #R28304. Each blunder increments v11; if the safe holds enough, Louey asks for one grand (or a tenth of the safe, if it holds 19 grand or more) to keep quiet about it.
@label=HUSHMONEY
c28297 LD IY,28304 ; Run the script at IY
 28301 JP 30092 ; Run it: the script's own END returns to the caller

; VM script: Louey's hush money
;
; Run by #R28297 after a blunder.
b28304 DEFB 18,11,71 ; VM: ADD Blunders,K1
 28307 DEFB 15,11 ; VM: STORE Blunders
 28309 DEFB 5,44,7,160,110 ; VM: IFLE K3,Dough,#R28320
 28314 DEFB 18,11,71 ; VM: ADD Blunders,K1
 28317 DEFB 15,11 ; VM: STORE Blunders
 28319 DEFB 0 ; VM: END
*28320 DEFB 5,57,7,184,110 ; VM: IFLE K19,Dough,#R28344
 28325 DEFB 26,7,69 ; VM: DIV Dough,K10
 28328 DEFB 27 ; VM: INT
 28329 DEFB 15,33 ; VM: STORE Tmp
 28331 DEFB 21,7,33 ; VM: SUB Dough,Tmp
 28334 DEFB 15,7 ; VM: STORE Dough
 28336 DEFB 1,8,208,5,33 ; VM: SAY #R53256,5 "[Your stoopidity takes my breath away, Mugsy. But for a mere (Tmp) grand I won't tell nobody./Mugsy! You're so dumb. It's gonna cost you (Tmp) G's ta make me forget it.]"
 28341 DEFB 13,193,110 ; VM: GOTO #R28353
*28344 DEFB 1,172,207,5 ; VM: SAY #R53164,5 "[Dat was real stoopid, Boss! If your boys heard about it you wud get more laughs than Jack Benny. However, for one crummy grand I guarantee ta keep my trap shut./Cripes, Boss, sometimes you're real dumb. But for a lousy grand I can be persuaded not to spill da beans about your stoopidity.]"
 28348 DEFB 21,7,71 ; VM: SUB Dough,K1
 28351 DEFB 15,7 ; VM: STORE Dough
*28353 DEFB 1,15,208,9 ; VM: SAY #R53263,9 "Gee ta, Boss! Now tell me........."
 28357 DEFB 0 ; VM: END

; VM native: shootout with the hit man from Detroit
;
; Works out Mugsy's hit points from v33 (set by the script from the handout: (low byte of v33 AND 7)+1, or 8 if v33 is 2.56 or more) and plays the shootout at #R42112. On return flag 4 (#R33892) is set to the result: 1 = the hit man was killed, 2 = the hit man was killed but bystanders were hit (the cops then want 20-60% of the safe), 3 = Mugsy was killed.
@label=HITMAN
c28358 LD L,33 ; Variable 33 holds the handout, set by the script
 28360 CALL 31201 ; BCDE=the handout (as a fixed-point number)
 28363 LD A,B ; Combine the upper three bytes
 28364 OR C ; ...
 28365 OR D ; ...
 28366 LD A,E ; A=the low byte of the handout
 28367 JR Z,28371 ; The upper bytes are zero: use the low byte as it is
 28369 LD A,255 ; The handout is 2.56 or more: use 255 (8 hit points)
 28371 CALL 42112 ; Play the shootout (A gives Mugsy's hit points)
 28374 PUSH AF ; Save the result
 28375 LD A,(23611) ; Read the keyboard flags
 28378 RES 5,A ; Forget any keypress left over from the shootout
 28380 LD (23611),A ; Store the flags
 28383 POP AF ; Restore the result
 28384 BIT 0,A ; Was Mugsy killed (bit 0)?
 28386 JR Z,28394 ; No
 28388 LD A,3 ; A=3: Mugsy was killed
 28390 LD (33892),A ; Store the outcome in flag 4
 28393 RET ; Return
 28394 AND 12 ; Were any bystanders hit (bits 2 and 3)?
 28396 LD A,1 ; A=1: the hit man was killed and no bystanders were hurt
 28398 JR Z,28390 ; Zero: store 1
 28400 LD A,2 ; A=2: the hit man was killed but bystanders were hit
 28402 JR 28390 ; Store the outcome

; Status line templates
;
; "HOODS ... CUSTOMERS ..." and "DOUGH IN DA SAFE $..." (32 characters each), filled in by #R28468 and #R28504.
t28404 DEFB 72,79,79,68,83,32,32,32,32,32,32,32,32,32,67,85,83,84,79,77,69,82,83,32,32,32,32,32,32,32,32,32 ; "HOODS         CUSTOMERS         "
 28436 DEFB 68,79,85,71,72,32,73,78,32,68,65,32,83,65,70,69,32,36,32,32,32,32,32,32,32,32,32,32,32,32,32,32 ; "DOUGH IN DA SAFE $              "

; Print the first status line
;
; Prints "HOODS nn CUSTOMERS nnn" on the second-to-last line of the screen using the values of v3 and v8.
c28468 LD HL,28410 ; HL=the template for the number of hoods
 28471 LD A,7 ; A=7: the field is seven characters wide
 28473 LD D,3 ; D=3: variable 3 holds the number of hoods
 28475 CALL 28530 ; Format it into the template
 28478 LD HL,28428 ; HL=the template for the number of customers
 28481 LD A,7 ; A=7: the field is seven characters wide
 28483 LD D,8 ; D=8: variable 8 holds the number of customers
 28485 CALL 28530 ; Format it into the template
 28488 LD B,32 ; B=32: the whole line
 28490 LD DE,28404 ; DE=the text of the line
 28493 LD HL,20672 ; HL=the second-to-last character row
 28496 LD A,(DE) ; A=the next character
 28497 CALL 27724 ; Print it
 28500 INC DE ; Next character
 28501 DJNZ 28496 ; Loop for the whole line
 28503 RET ; Return

; Print the second status line
;
; Prints "DOUGH IN DA SAFE $nnn" using the value of v7.
c28504 LD HL,28454 ; HL=the template for the money in the safe
 28507 LD A,7 ; A=7: the field is seven characters wide
 28509 LD D,7 ; D=7: variable 7 holds the money in the safe
 28511 CALL 28530 ; Format it into the template
 28514 LD B,32 ; B=32: the whole line
 28516 LD DE,28436 ; DE=the text of the line
 28519 LD HL,20704 ; HL=the last character row
 28522 LD A,(DE) ; A=the next character
 28523 CALL 27724 ; Print it
 28526 INC DE ; Next character
 28527 DJNZ 28522 ; Loop for the whole line
 28529 RET ; Return

; Print a VM variable into a status line template
;
; Formats variable D into the template at HL (A characters long) via #R29630.
;
; Input:A Field width
; D Variable number
; HL Template address
c28530 PUSH HL ; Save the template address
 28531 LD L,D ; L=the variable number
 28532 CALL 31201 ; BCDE=its value
 28535 POP HL ; HL=the template address
 28536 LD (29926),HL ; Remember where the number goes
 28539 LD (HL),32 ; Blank the field with spaces
 28541 INC HL ; Next character of the field
 28542 DEC A ; One fewer
 28543 JR NZ,28539 ; Loop until the field is blank
 28545 JP 29630 ; Print the value into the field

; The SAY flags
b28548 DEFB 0

; Show a message in a speech bubble
;
; The handler for VM op 1 (SAY, #R30225) jumps here. This is the heart of the comic strip display. HL holds the address of a message and A holds a flags byte:
; .
; #TABLE(default,centre,:w) { =h Bits | =h Meaning } { 0-1 | Non-zero: wait for a keypress (with timeout) afterwards } { 2-3 | Bubble placement: 0 = random entry from the layout table at #R33902; 4 (bit 2) = the fixed entry at #R33909 (the answer bubble); 8 (bit 3) = keep the current entry } { 4-6 | 16 = play the theme tune (#R32785) } TABLE#
;
; The message is rendered into the text buffer at 23808 (expanding dictionary words and any variables, which are taken from the VM byte stream after the SAY instruction), the picture is redrawn if the layout has changed, the status lines are printed and the text is word-wrapped into the bubble by #R28757.
;
; Input:A Flags
; HL Message address
@label=SAY
c28549 LD (28548),A ; Save the SAY flags
 28552 PUSH HL ; Save the message address
 28553 LD IY,33909 ; Point IY at the fixed "answer" bubble layout
 28557 AND 12 ; Keep bits 2 and 3 of the flags
 28559 CP 4 ; Bit 2 set?
 28561 JR Z,28600 ; Use the fixed layout if so
 28563 LD IY,(33904) ; Otherwise start with the current layout
 28567 CP 8 ; Bit 3 set?
 28569 JR Z,28600 ; Keep the current layout if so
 28571 LD IY,(33902) ; Otherwise pick a layout at random: point IY at this year's layout table
 28575 LD A,100 ; A=100: the upper limit
 28577 CALL 30014 ; A=random number 0-100
 28580 CP (IY+0) ; Compare it with the entry's chance
 28583 JR C,28595 ; Use this entry if the number is lower
 28585 INC IY ; Otherwise move on to the next entry
 28587 INC IY ; Four bytes per layout entry...
 28589 INC IY ; ...
 28591 INC IY ; ...
 28593 JR 28580 ; Compare against the next entry
 28595 CALL 28652 ; Is it the layout already on screen?
 28598 JR Z,28571 ; If so pick again (the bubble must move)
 28600 CALL 28652 ; Set A=1 if the layout has changed
 28603 LD (33906),A ; Store the layout-unchanged flag
 28606 LD (33904),IY ; Make this the current layout
 28610 CALL 26812 ; Draw the picture (or just wipe the old bubble)
 28613 CALL 28468 ; Print the status lines
 28616 CALL 28504 ; Print the second status line
 28619 POP HL ; Restore the message address
 28620 CALL 29320 ; Render the message into the text buffer
 28623 LD IX,23808 ; Point IX at the text buffer
 28627 LD HL,16384 ; HL=top of the screen
 28630 CALL 28757 ; Print the text in a bubble
 28633 LD A,(28548) ; Pick up the SAY flags
 28636 AND 112 ; Keep bits 4-6
 28638 CALL 32785 ; Play the theme tune if they are 16
 28641 LD A,(28548) ; Pick up the SAY flags again
 28644 AND 3 ; Keep bits 0-1
 28646 RET Z ; Return unless they ask for a pause
 28647 LD A,8 ; Wait up to 8 periods...
 28649 JP 26876 ; ...or until a key is pressed

; Check whether the bubble layout has changed
;
; Compares IY with the current layout (#R33904).
;
; Output:A 0 if unchanged, 1 if changed
; F Zero flag set if unchanged
c28652 PUSH HL ; Save HL...
 28653 PUSH DE ; ...and DE
 28654 PUSH IY ; HL=IY
 28656 POP HL ; HL=IY, the layout being asked for
 28657 LD DE,(33904) ; DE=current layout
 28661 AND A ; Clear the carry flag
 28662 SBC HL,DE ; Compare
 28664 LD A,0 ; A=0 (unchanged)
 28666 POP DE ; Restore DE...
 28667 POP HL ; ...and HL
 28668 RET Z ; Return with A=0 and the zero flag set if they are the same
 28669 INC A ; A=1 (changed)
 28670 RET ; Done: A=1 and NZ if the layout is different

; Measure the words in the text buffer
;
; Builds a list of word widths (in pixels) at 24192, terminated by 255.
;
; Input:IX Text
c28671 LD DE,24192 ; Point DE at the word width list
 28674 PUSH IX ; Save IX...
 28676 PUSH HL ; ...and HL
 28677 CALL 28698 ; Measure the next word
 28680 AND A ; Was it empty (two spaces in a row)?
 28681 JR Z,28685 ; Skip it if so
 28683 LD (DE),A ; Store its width
 28684 INC DE ; Next entry in the table
 28685 LD A,(IX+0) ; Reached the end of the text?
 28688 AND A ; Clear the carry flag
 28689 JR NZ,28677 ; Back for the next word if not
 28691 LD A,255 ; Terminate the list with 255
 28693 LD (DE),A ; Store the measured value
 28694 POP HL ; Restore HL
 28695 POP IX ; Restore IX
 28697 RET ; Done

; Measure one word
;
; Adds up the widths (+1 pixel spacing) of the characters at IX up to the next space.
;
; Input:IX Text
; Output:A Width in pixels
; IX Next word
c28698 PUSH BC ; Save BC
 28699 PUSH HL ; Save HL
 28700 LD C,0 ; C will accumulate the width
 28702 LD A,(IX+0) ; Pick up a character
 28705 AND A ; End of the text?
 28706 JR Z,28724 ; Finish if so
 28708 CALL 26921 ; Get the address of its glyph
 28711 LD A,(HL) ; A=width of the character
 28712 INC A ; +1 pixel of spacing
 28713 ADD A,C ; Add the character's width to the total
 28714 LD C,A ; Add it to the total
 28715 LD A,(IX+0) ; Pick up the character again
 28718 INC IX ; Move on
 28720 CP 32 ; Was it a space?
 28722 JR NZ,28702 ; Carry on until the end of the word
 28724 POP HL ; Restore HL
 28725 LD A,C ; A=width of the word
 28726 POP BC ; Restore BC
 28727 RET ; Done: A=the width of the word in pixels

; Speech bubble shape
;
; Line widths (#R28728-28736), left offsets (28737-28746) and margins (28747-28756) for the oval speech bubble; used by #R28757 and #R29161. #R29161 fills lines from the top and the bottom of the bubble at the same time, so each of the nine widths serves a pair of lines (the outermost pair first), and the table covers bubbles of up to 18 lines.
b28728 DEFB 43,75,91,91,107,107,107,107
 28736 DEFB 107,1,3,4,4,5,5,5
 28744 DEFB 5,5,0,254,253,253,252,252
 28752 DEFB 252,252,252,0,0

; Print the text buffer into a speech bubble
;
; Works out how many lines the text needs (#R29161), then prints it line by line, centring each line within the oval bubble shape described by the table of line widths at #R28728 and left margins at 28746. The bubble outline itself is drawn first by #R28905.
;
; Input:IX Text
; HL Display file address of the top of the bubble
@label=PRINTBUBBLE
c28757 CALL 28671 ; Measure the words of the text
 28760 PUSH IX ; Save IX...
 28762 PUSH IY ; ...and IY
 28764 PUSH HL ; Save the screen address
 28765 CALL 29161 ; Work out the number of lines needed (B)
 28768 LD A,B ; Is it odd?
 28769 AND 1 ; Keep bit 0: 1 if the number of lines is odd
 28771 LD (28755),A ; Store the odd-line flag
 28774 LD A,B ; A=number of lines again
 28775 SRL A ; B/2 lines in each half of the bubble
 28777 LD (28756),A ; Remember the number of lines in each half
 28780 LD B,A ; B=lines in each half
 28781 LD A,(28755) ; C=index of the widest line
 28784 ADD A,B ; Add the odd-line flag: the index of the middle line
 28785 LD C,A ; C=index of the middle line
 28786 LD B,0 ; BC=index, to look up the left offset
 28788 LD HL,28737 ; Look up the left offset of the bubble
 28791 ADD HL,BC ; HL=address of the offset for that line
 28792 LD C,(HL) ; C=the left offset of the bubble
 28793 POP HL ; Restore the screen address
 28794 ADD HL,BC ; Add the left offset
 28795 CALL 28885 ; Leave a blank row above the text
 28798 LD IY,28746 ; IY points at the margins for each line
 28802 LD DE,28728 ; DE points at the widths of the lines
 28805 CALL 28905 ; Draw the bubble outline
 28808 LD A,(28755) ; B=number of lines in the top half (plus the middle line if odd)
 28811 LD B,A ; B=the odd-line flag...
 28812 LD A,(28756) ; ...plus the lines in the top half...
 28815 ADD A,B ; ...gives the rows above the middle line...
 28816 LD B,A ; ...B=row counter
 28817 LD C,0 ; C=pixel offset 0
 28819 PUSH HL ; Keep the screen position of this row
 28820 CALL 28879 ; Indent by the margin for this line
 28823 LD A,(DE) ; A=width of this line
 28824 CALL 29029 ; Print as many words as fit
 28827 POP HL ; Back to the start of the row
 28828 INC IY ; Next margin
 28830 INC DE ; Next width
 28831 CALL 28885 ; Move down a row
 28834 DJNZ 28817 ; Repeat for the top half
 28836 DEC DE ; Step back to the middle line
 28837 DEC IY ; Back to the middle line's margin entry
 28839 LD A,(28755) ; Is there an odd middle line?
 28842 AND A ; Test for an odd middle line
 28843 JR Z,28848 ; Jump if not
 28845 DEC DE ; If so step back once more
 28846 DEC IY ; ...and its margin entry
 28848 LD A,(28756) ; B=number of lines in the bottom half
 28851 LD B,A ; B=number of lines in the bottom half
 28852 AND A ; Test for none
 28853 JR Z,28874 ; Jump if there are none
 28855 LD C,0 ; C=pixel offset 0
 28857 PUSH HL ; Keep the screen position of this row
 28858 CALL 28879 ; Indent by the margin for this line
 28861 LD A,(DE) ; A=width of this line
 28862 CALL 29029 ; Print as many words as fit
 28865 POP HL ; Back to the start of the row
 28866 DEC IY ; Previous margin (the bottom half mirrors the top)
 28868 DEC DE ; Previous width
 28869 CALL 28885 ; Move down a row
 28872 DJNZ 28855 ; Repeat for the bottom half
 28874 POP IY ; Restore IY...
 28876 POP IX ; ...and IX
 28878 RET ; Done: the bubble and its text are drawn

; Add the bubble margin for the current line
;
; L=L+(IY+0).
c28879 LD A,(IY+0) ; A=margin for this line
 28882 ADD A,L ; Add it to the column
 28883 LD L,A ; L=the indented column
 28884 RET ; Done

; Move HL down one character row
;
; HL=HL+32, crossing display file thirds as needed.
c28885 LD A,L ; Move down 32 bytes
 28886 ADD A,32 ; Add 32 to move down one pixel row...
 28888 LD L,A ; L=the new low byte
 28889 RET NC ; Return unless this crossed into the next third of the screen
 28890 LD A,H ; A=H
 28891 ADD A,8 ; Move to the next third
 28893 LD H,A ; H=the next third
 28894 RET ; Done

; Move HL up one character row
;
; HL=HL-32, crossing display file thirds as needed.
c28895 LD A,L ; Move up 32 bytes
 28896 SUB 32 ; Subtract 32 to move up one pixel row...
 28898 LD L,A ; L=the new low byte
 28899 RET NC ; Return unless this crossed into the previous third
 28900 LD A,H ; A=H
 28901 SUB 8 ; Move to the previous third
 28903 LD H,A ; H=the previous third
 28904 RET ; Done

; Draw the outline of a speech bubble
;
; Draws the rounded white bubble (paper 7) with one blank line above and below the text area.
c28905 PUSH IY ; Save IY
 28907 PUSH HL ; Save the registers this routine uses...
 28908 PUSH DE ; ...(HL=screen position, DE=width table)...
 28909 PUSH BC ; ...and BC, which will count rows
 28910 CALL 28895 ; Start one row above the text
 28913 LD A,(28755) ; B=number of lines in the top half
 28916 LD B,A ; B=lines in the top half...
 28917 LD A,(28756) ; ...plus the lines in the bottom half (28756)...
 28920 ADD A,B ; ...to give the number of rows above the middle line
 28921 LD B,A ; B=the row counter
 28922 LD C,0 ; C=pixel offset 0
 28924 PUSH HL ; Keep the screen position for the next row
 28925 CALL 28879 ; Indent by the margin
 28928 LD A,(DE) ; A=width of this line
 28929 CALL 29006 ; Paint the white background for it
 28932 POP HL ; Back to the start of this row
 28933 INC IY ; Next margin entry
 28935 INC DE ; Next line width
 28936 CALL 28885 ; Move down a row
 28939 DJNZ 28922 ; Repeat for the top half
 28941 PUSH HL ; Keep the screen position of the middle row
 28942 DEC DE ; Back to the widest line
 28943 DEC IY ; Back to the widest line's margin entry
 28945 CALL 28879 ; Indent by the margin
 28948 LD A,(DE) ; A=the width of the widest line
 28949 CALL 29006 ; Paint the blank row above the text (as wide as the line below it)
 28952 LD A,(28755) ; Is there an odd middle line?
 28955 AND A ; Test for no odd middle line
 28956 JR Z,28961 ; Skip the extra step if there is none
 28958 DEC DE ; Odd middle line: step back one more width...
 28959 DEC IY ; ...and one more margin entry
 28961 POP HL ; Restore the screen position
 28962 CALL 28885 ; Move down a row
 28965 PUSH HL ; Keep the screen position of the middle row
 28966 CALL 28879 ; Indent by the margin of the middle line
 28969 LD A,(DE) ; A=width of the middle line
 28970 CALL 29006 ; Paint the middle row
 28973 POP HL ; Restore the screen position
 28974 LD A,(28756) ; B=number of lines in the bottom half
 28977 LD B,A ; B=lines in the bottom half
 28978 AND A ; Test for none
 28979 JR Z,29000 ; Jump if there are none
 28981 LD C,0 ; C=pixel offset 0
 28983 CALL 28885 ; Move down a row
 28986 PUSH HL ; Keep the screen position
 28987 CALL 28879 ; Indent by the margin
 28990 LD A,(DE) ; A=the width of the line
 28991 CALL 29006 ; Paint the background for this line
 28994 POP HL ; Restore the screen position
 28995 DEC IY ; Previous margin
 28997 DEC DE ; Previous width
 28998 DJNZ 28981 ; Repeat for the bottom half
 29000 POP BC ; Restore BC...
 29001 POP DE ; ...DE...
 29002 POP HL ; ...HL...
 29003 POP IY ; ...and IY
 29005 RET ; Done: the whole bubble background is painted

; Fill part of a bubble line with white cells
;
; Paints A+16 pixels of white bubble background (via #R27060) from the cell at HL.
c29006 PUSH BC ; Save BC
 29007 PUSH HL ; Save HL...
 29008 ADD A,16 ; Add 16 pixels of margin to the line width
 29010 LD B,A ; B=pixels to paint
 29011 DEC L ; Start one cell to the left
 29012 CALL 27060 ; Clear a cell and make it white
 29015 INC L ; Next cell
 29016 LD A,B ; A=the width again
 29017 SUB 8 ; 8 pixels done
 29019 LD B,A ; B=the width
 29020 CP 8 ; Any more?
 29022 JR NC,29012 ; Jump back if so
 29024 POP HL ; Restore HL
 29025 POP BC ; Restore BC
 29026 RET ; Done

; The line start pointer
b29027 DEFB 0,0

; Print one line of text in a bubble
;
; Prints as many words from IX as will fit in A pixels, centred.
;
; Input:A Line width in pixels
; IX Text
c29029 PUSH BC ; Save BC
 29030 PUSH DE ; Save DE
 29031 LD B,A ; B=the width of the line in pixels
 29032 LD A,(IX+0) ; A=the first character of the text
 29035 AND A ; Test it
 29036 JR Z,29157 ; End of the text: nothing to print
 29038 PUSH IX ; Save the start of the line
 29040 LD (29027),IX ; Remember the start of the line
 29044 LD A,(IX+0) ; A=the next character
 29047 AND A ; Test it
 29048 JR Z,29061 ; End of the text: the line ends here
 29050 CALL 28698 ; Measure the next word
 29053 LD D,A ; D=the width of the word
 29054 LD A,B ; A=the width left on the line
 29055 SUB D ; Subtract the word's width
 29056 JR C,29061 ; It does not fit: the line ends before this word
 29058 LD B,A ; B=the width left
 29059 JR 29040 ; Try the next word
 29061 POP DE ; DE=the start of the line
 29062 PUSH BC ; Save the width left
 29063 PUSH DE ; Save the start of the line
 29064 PUSH HL ; Save the screen position
 29065 LD HL,(29027) ; HL=the end of the words that fit (where the next word starts)
 29068 AND A ; Clear the carry flag
 29069 SBC HL,DE ; Subtract the start: the number of characters on the line
 29071 LD A,L ; A=the character count
 29072 POP HL ; Restore the screen position
 29073 LD C,A ; C=the character count
 29074 LD E,250 ; E=250: a counter for the spaces at the end of the line
 29076 LD D,254 ; D=254: a counter for the spaces at the start of the line
 29078 LD IX,(29027) ; IX=the end of the line
 29082 LD B,C ; B=the character count
 29083 DEC IX ; Back up one character
 29085 INC D ; Count it in D
 29086 INC E ; Count three pixels in E for each space...
 29087 INC E ; ...
 29088 INC E ; ...
 29089 LD A,(IX+0) ; A=the character
 29092 CP 32 ; A space?
 29094 JR NZ,29098 ; No: stop looking
 29096 DJNZ 29083 ; Keep looking for spaces at the end
 29098 POP IX ; IX=the start of the line
 29100 DEC IX ; Step back one
 29102 LD B,C ; B=the character count
 29103 INC E ; Count three pixels in E for each space at the start...
 29104 INC E ; ...
 29105 INC E ; ...
 29106 INC D ; Count it in D
 29107 INC IX ; Move on one character
 29109 LD A,(IX+0) ; A=the character
 29112 CP 32 ; A space?
 29114 JR NZ,29118 ; No: stop looking
 29116 DJNZ 29103 ; Keep looking for spaces at the start
 29118 LD A,E ; A=the pixels to be trimmed
 29119 LD E,C ; E=the character count
 29120 POP BC ; Restore the width left
 29121 ADD A,B ; Add it
 29122 SRL A ; Halve it: this is the pixel offset that centres the line
 29124 ADD A,C ; Add the character count
 29125 CP 8 ; At least 8 pixels?
 29127 JR C,29134 ; No: that is the pixel offset within the cell
 29129 SUB 8 ; Take off a character cell's 8 pixels
 29131 INC L ; Move one cell right
 29132 JR 29125 ; Repeat
 29134 LD C,A ; C=the pixel offset within the first cell
 29135 LD A,E ; A=the character count
 29136 SUB D ; Take off the spaces to be skipped
 29137 LD E,A ; E=the number of characters to print
 29138 JR C,29153 ; None: nothing to print
 29140 JR Z,29153 ; None: nothing to print
 29142 LD A,(IX+0) ; A=the character
 29145 CALL 26940 ; Print it in the proportional font
 29148 INC IX ; Next character
 29150 DEC E ; One fewer to print
 29151 JR NZ,29142 ; Loop until the line is printed
 29153 LD IX,(29027) ; IX=the end of the line (the start of the next one)
 29157 POP DE ; Restore DE
 29158 POP AF ; Restore AF
 29159 LD B,A ; B=A
 29160 RET ; Return

; Work out the bubble shape for the text
;
; Chooses the smallest bubble (number of lines, B) into which the measured words will fit, using the line widths at #R28728.
;
; Output:B Number of lines
c29161 PUSH IX ; Save IX
 29163 PUSH IY ; Save IY
 29165 LD IX,24191 ; IX=just before the list of word widths (24192)
 29169 LD IY,24192 ; IY=the list of word widths
 29173 LD A,(IY+0) ; A=a width
 29176 INC IY ; Next one
 29178 INC A ; The end marker is 255
 29179 JR NZ,29173 ; Keep looking for it
 29181 DEC IY ; IY=the end marker
 29183 LD B,0 ; B=0: no lines yet
 29185 LD HL,28728 ; HL=the table of line widths (#R28728)
 29188 LD C,0 ; C=0: nothing in this line yet
 29190 INC IX ; Next word from the front of the text
 29192 LD A,(IX+0) ; A=its width
 29195 ADD A,C ; Add it to the line
 29196 LD C,A ; C=the line width so far
 29197 LD A,(HL) ; A=the width allowed for this line
 29198 CP C ; Does the word fit?
 29199 JR NC,29190 ; Yes: try another
 29201 DEC IX ; Back off the last word
 29203 INC B ; One more line
 29204 CALL 29236 ; Have the front and back met?
 29207 JR NC,29231 ; Yes: finished
 29209 LD C,0 ; C=0: nothing in the line from the back
 29211 DEC IY ; Back one word from the end
 29213 LD A,(IY+0) ; A=its width
 29216 ADD A,C ; Add it to the line
 29217 LD C,A ; C=the line width so far
 29218 LD A,(HL) ; A=the width allowed for this line
 29219 CP C ; Does the word fit?
 29220 JR NC,29211 ; Yes: try another
 29222 INC B ; One more line (the last one, filled from the back)
 29223 INC IY ; Put the word back
 29225 INC HL ; Next width in the table (the next pair of lines is wider)
 29226 CALL 29236 ; Have the front and back met?
 29229 JR C,29188 ; No: fill another line from the front
 29231 POP IY ; Restore IY
 29233 POP IX ; Restore IX
 29235 RET ; Return

; Compare IX and IY
;
; Returns with the carry flag set if IX<IY.
c29236 PUSH HL ; Save HL
 29237 PUSH IX ; Save IX...
 29239 POP HL ; ...in HL
 29240 PUSH IY ; Save IY...
 29242 POP DE ; ...in DE
 29243 AND A ; Clear the carry flag
 29244 SBC HL,DE ; Subtract: carry set if IX is less than IY
 29246 POP HL ; Restore HL
 29247 RET ; Return

; Message control code jump table
;
; Addresses of the handlers for control codes 0-22 (used by #R29458).
w29248 DEFW 29570,29608,29570,29570
 29256 DEFW 29621,29873,29570,29570
 29264 DEFW 29897,29570,29810,29790
 29272 DEFW 29570,29570,29570,29570
 29280 DEFW 29570,29570,29570,29570
 29288 DEFW 29570,29574,29594

; Measure the width of the text buffer
;
; Returns the total pixel width of the text at 23808 in HL.
c29294 LD IX,23808 ; IX=the text buffer
 29298 LD HL,0 ; HL=0: the width so far
 29301 LD A,(IX+0) ; A=the next character
 29304 AND A ; Test it
 29305 RET Z ; End of the text: return
 29306 EX DE,HL ; DE=the width so far
 29307 CALL 26921 ; HL=the character's glyph address
 29310 LD L,(HL) ; L=the glyph width
 29311 LD H,0 ; H=0
 29313 INC HL ; Add one pixel of spacing
 29314 ADD HL,DE ; Add the width so far
 29315 INC IX ; Next character
 29317 JR 29301 ; Loop

; The first-character flag
b29319 DEFB 0

; Render a message into the text buffer
;
; Clears the buffer, renders the message at HL into it and then, if the text is too wide for one line, inserts a line break near the middle so that the bubble comes out roughly round.
;
; Input:HL Message address
@label=RENDER
c29320 PUSH HL ; Save the message address
 29321 XOR A ; A=0, to clear the first-character flag
 29322 LD (29319),A ; Clear the first-character flag
 29325 LD HL,23808 ; Point the buffer pointer at the start of the text buffer
 29328 LD (29926),HL ; Start the text buffer pointer at 23808
 29331 POP IX ; IX=message address
 29333 CALL 29452 ; Render the message into the buffer
 29336 XOR A ; Terminate the buffer with a zero byte
 29337 CALL 29509 ; Store the zero terminator in the buffer
 29340 LD A,(33906) ; Has the bubble layout changed since the last message?
 29343 AND A ; Test the layout-changed flag
 29344 JR NZ,29445 ; Jump if so (the screen will be redrawn anyway)
 29346 CALL 29294 ; HL=width of the new text in pixels
 29349 LD DE,(33907) ; DE=width of the previous text
 29353 AND A ; Clear the carry flag for the subtraction
 29354 SBC HL,DE ; Is the new text at least as wide?
 29356 JR NC,29445 ; Jump if so (the new bubble will cover the old one)
 29358 LD DE,0 ; Otherwise work out how many 3-pixel spaces are needed...
 29361 EX DE,HL ; DE=0 (the new width), HL=old width
 29362 AND A ; Clear the carry flag
 29363 SBC HL,DE ; ...HL=old width-new width
 29365 LD DE,3 ; Spaces are 3 pixels wide
 29368 LD BC,65535 ; BC will count the spaces
 29371 INC BC ; Count one more space
 29372 AND A ; Clear the carry flag
 29373 SBC HL,DE ; Divide by 3
 29375 JR NC,29371 ; Loop while the width remaining is at least 3
 29377 LD A,B ; Are any spaces needed?
 29378 OR C ; Combine B and C to test BC for zero
 29379 JR Z,29445 ; Jump if not
 29381 PUSH BC ; Save the number of spaces
 29382 SRL B ; Half of them go in front of the text
 29384 RR C ; Half the count in BC (carry out of B into C)
 29386 LD HL,(29926) ; HL=address of the terminator
 29389 DEC HL ; HL=address of the last character
 29390 LD E,L ; DE=HL: the address of the last character...
 29391 LD D,H ; DE=HL
 29392 ADD HL,BC ; Move the end of the text along by BC
 29393 LD (29926),HL ; Update the buffer pointer
 29396 EX DE,HL ; HL=last character, DE=its new position
 29397 LD BC,23807 ; BC=length of the text
 29400 AND A ; Clear the carry flag
 29401 SBC HL,BC ; HL=length of the text in the buffer (counted down from the end)
 29403 PUSH HL ; Keep the length
 29404 ADD HL,BC ; HL=address of the last character again
 29405 POP BC ; BC=length, ready for LDDR
 29406 LDDR ; Shift the text right to make room for the leading spaces
 29408 POP BC ; Restore the total number of spaces
 29409 LD HL,(29926) ; HL=end of the text
 29412 LD DE,23808 ; DE=start of the buffer
 29415 LD A,B ; Fill in pairs of spaces...
 29416 AND A ; Test the high byte of the count
 29417 JR NZ,29427 ; Jump if at least 256 left
 29419 LD A,C ; A=low byte of the count
 29420 AND A ; Test it for zero
 29421 JR Z,29440 ; Jump if none left
 29423 CP 1 ; Just one left?
 29425 JR Z,29437 ; Jump if so
 29427 LD A,32 ; Put a space at the front...
 29429 LD (DE),A ; Space at the start of the buffer
 29430 LD (HL),A ; ...and one at the end
 29431 INC DE ; Next position at the front
 29432 INC HL ; Next position at the end
 29433 DEC BC ; One fewer space to place...
 29434 DEC BC ; Two fewer spaces to place
 29435 JR 29415 ; Loop back for the next pair
 29437 LD (HL),32 ; Put the odd space at the end
 29439 INC HL ; Step over the odd space
 29440 LD (HL),0 ; Terminate the text
 29442 LD (29926),HL ; Update the buffer pointer
 29445 CALL 29294 ; Measure the final text...
 29448 LD (33907),HL ; ...and remember its width for next time
 29451 RET ; Return with HL=the final width

; Render a message
;
; Calls #R29458 for each item until the end of the message.
;
; Input:IX Message
c29452 CALL 29458 ; Render one item
 29455 JR NZ,29452 ; Repeat until an item ends the message
 29457 RET ; Done: the message has been rendered

; Render one message item
;
; A message is a sequence of items:
; .
; #TABLE(default,centre,:w) { =h Byte(s) | =h Meaning } { 0-31 | Control code (see the table at #R29248) } { 32-95 | Literal character (letters are converted to lower case) } { 96-127 | Common word: index into the table at #R49710 } { 128-255, n | Dictionary word at 48640+((b AND 15)*256)+n; bits 4-6 of b: 7 = capitalise, 2 or 6 = last word, 3 = last word plus a full stop } TABLE#
;
; Returns with the zero flag set at the end of the message.
;
; Input:IX Item
; Output:IX Next item
@label=RENDERITEM
c29458 LD A,(IX+0) ; Pick up the first byte of the item
 29461 BIT 7,A ; Is it a two-byte dictionary reference?
 29463 JR Z,29495 ; Jump if not
 29465 AND 127 ; D=first byte without bit 7 (bits 0-3: page; bits 4-6: type)
 29467 LD D,A ; D=the type and page
 29468 LD E,(IX+1) ; E=offset into the page
 29471 INC IX ; Point IX at the second byte
 29473 AND 240 ; Keep the type bits
 29475 CP 48 ; Type 3 (last word plus full stop)?
 29477 JR Z,29578 ; Jump if so
 29479 CP 32 ; Type 2 (last word)?
 29481 JR Z,29578 ; Jump if so
 29483 CP 96 ; Type 6 (last word)?
 29485 JR Z,29578 ; Jump if so
 29487 CALL 29928 ; Print the dictionary word
 29490 INC IX ; Move IX to the next item
 29492 OR 1 ; Reset the zero flag: the message continues
 29494 RET ; Done: NZ means the message goes on
 29495 CP 32 ; Is it a control code (0-31)?
 29497 JR C,29544 ; Jump if so
 29499 CP 96 ; Is it a common word (96-127)?
 29501 JP NC,29907 ; Jump if so
 29504 CALL 29509 ; Otherwise it is a literal character: put it in the buffer
 29507 JR 29490 ; And move on

; Put a character into the text buffer (converting to lower case)
;
; Converts A-Z to a-z first.
c29509 CP 65 ; Is it an upper case letter?
 29511 JR C,29519 ; Below A: not a capital, store as it is
 29513 CP 91 ; Above Z?
 29515 JR NC,29519 ; Yes: store as it is
 29517 SET 5,A ; Convert it to lower case (which the font draws as small capitals)

; Put a character into the text buffer
;
; Stores A at the buffer pointer (#R29926). A space as the very first character is suppressed.
c29519 PUSH HL ; Save HL
 29520 LD HL,(29926) ; HL=buffer pointer
 29523 LD (HL),A ; Store the character
 29524 LD A,(29319) ; Has anything been stored yet?
 29527 AND A ; Test the first-character flag
 29528 LD A,(HL) ; A=the character
 29529 JR NZ,29538 ; Jump if so: advance the pointer
 29531 LD (29319),A ; Note that something has been stored
 29534 CP 32 ; Is the first character a space?
 29536 JR Z,29539 ; Jump if so: do not advance, so the next character overwrites it
 29538 INC HL ; Advance the buffer pointer
 29539 LD (29926),HL ; Store the updated buffer pointer
 29542 POP HL ; Restore HL
 29543 RET ; Done
 29544 PUSH DE ; Save DE
 29545 LD E,A ; DE=control code
 29546 LD D,0 ; DE=code
 29548 LD HL,29248 ; Point HL at the control code jump table
 29551 ADD HL,DE ; Add the code once...
 29552 ADD HL,DE ; Add 2*code
 29553 LD E,(HL) ; Pick up the handler address
 29554 INC HL ; Next byte of the table entry
 29555 LD D,(HL) ; D=high byte of the handler address
 29556 EX DE,HL ; HL=handler address
 29557 POP DE ; Restore DE
 29558 CP 20 ; Codes 20 and above...
 29560 JR NC,29569 ; ...are jumped to directly (they end the message)
 29562 CALL 29569 ; Codes 0-19 are called
 29565 JR Z,29490 ; Zero flag set: the handler has done its work; move on
 29567 JR 29487 ; Otherwise print the dictionary word in DE

; Jump to a control code handler
;
; JP (HL).
c29569 JP (HL) ; Jump to the handler

; Control codes 0, 2, 3, 6, 7, 9 and 12-20 (no-op)
c29570 LD D,96 ; D=96 (as for a type 6 last word)
 29572 JR 29581 ; End the message without a full stop

; Control code 21: full stop and end
c29574 LD D,48 ; D=48 (as for a type 3 last word)
 29576 JR 29581 ; End the message with a full stop
 29578 CALL 29928 ; Print the last word
 29581 LD A,46 ; A=full stop
 29583 BIT 6,D ; Type 6?
 29585 JR NZ,29594 ; Jump if so: no full stop
 29587 BIT 4,D ; Type 3?
 29589 CALL NZ,29509 ; Print the full stop if so
 29592 BIT 4,D ; Test bit 4 of D again

; Control code 22: end
c29594 XOR A ; Set the zero flag: end of message
 29595 RET ; Done

; Control codes 1/4: fetch a variable from the VM stream
;
; Reads a variable number from the VM byte stream (not the message!) and loads that variable into BCDE, then puts a space in the buffer.
c29596 CALL 30214 ; Fetch a variable number from the VM byte stream
 29599 LD L,A ; L=variable number
 29600 CALL 31201 ; Load the variable into BCDE
 29603 LD A,32 ; A=space
 29605 JP 29509 ; Put a space in the buffer

; Control code 1: print " $" and a variable
c29608 CALL 29596 ; Fetch the variable and put a space in the buffer
 29611 LD A,36 ; A="$"
 29613 CALL 29509 ; Put it in the buffer
 29616 CALL 29630 ; Print the number
 29619 XOR A ; Set the zero flag: control code done
 29620 RET ; Done

; Control code 4: print " " and a variable
c29621 CALL 29596 ; Fetch the variable and put a space in the buffer
 29624 CALL 29630 ; Print the number
 29627 XOR A ; Set the zero flag: control code done
 29628 RET ; Done

; The leading-zero flag
b29629 DEFB 240

; Print a number
;
; Prints the signed fixed-point value in BCDE in decimal (without leading zeros), adding a decimal point and two decimal places only if the fractional part is non-zero.
;
; Input:BCDE Number (x100)
@label=PRINTNUM
c29630 BIT 7,B ; Is the number negative?
 29632 JR Z,29642 ; Jump if not
 29634 CALL 30634 ; Make it positive
 29637 LD A,45 ; A="-"
 29639 CALL 29509 ; Put the minus sign in the buffer
 29642 PUSH BC ; Copy the high word (BC) into HL'
 29643 EXX ; Switch to the alternate registers...
 29644 POP HL ; ...HL'=high word of the number...
 29645 EXX ; ...and back again
 29646 EX DE,HL ; HL=low word
 29647 XOR A ; Leading zeros are not printed yet
 29648 LD (29629),A ; Clear the leading-zero flag
 29651 LD BC,15258 ; BC/DE=1,000,000,000 (the number is in hundredths, so this is ten million)
 29654 LD DE,51712 ; DE=low word of the divisor 1,000,000,000
 29657 CALL 29752 ; Print that digit
 29660 LD BC,1525 ; BC/DE=100,000,000
 29663 LD DE,57600 ; DE=low word of 100,000,000
 29666 CALL 29752 ; Print the millions digit
 29669 LD BC,152 ; BC/DE=10,000,000
 29672 LD DE,38528 ; DE=low word of 10,000,000
 29675 CALL 29752 ; Print the hundred-thousands digit
 29678 LD BC,15 ; BC/DE=1,000,000
 29681 LD DE,16960 ; DE=low word of 1,000,000
 29684 CALL 29752 ; Print the ten-thousands digit
 29687 LD BC,1 ; BC/DE=100,000
 29690 LD DE,34464 ; DE=low word of 100,000
 29693 CALL 29752 ; Print the thousands digit
 29696 LD BC,0 ; BC/DE=10,000
 29699 LD DE,10000 ; DE=10,000
 29702 CALL 29752 ; Print the hundreds digit
 29705 LD BC,0 ; BC/DE=1,000 (tens)
 29708 LD DE,1000 ; DE=1,000
 29711 CALL 29752 ; Print the tens digit
 29714 LD A,1 ; From now on zeros are printed (so 0 comes out as "0")
 29716 LD (29629),A ; Set the leading-zero flag
 29719 LD BC,0 ; BC/DE=100 (units)
 29722 LD DE,100 ; DE=100
 29725 CALL 29752 ; Print the units digit
 29728 LD A,L ; Is there a fractional part?
 29729 OR H ; Combine with H to test the fraction
 29730 RET Z ; Return if not: whole numbers have no decimal point
 29731 LD A,46 ; A="."
 29733 CALL 29509 ; Put the decimal point in the buffer
 29736 LD BC,0 ; BC/DE=10 (tenths)
 29739 LD DE,10 ; DE=10
 29742 CALL 29752 ; Print the tenths digit
 29745 LD A,L ; A=hundredths digit
 29746 ADD A,48 ; Convert it to ASCII
 29748 CALL 29509 ; Put it in the buffer
 29751 RET ; Done

; Print one decimal digit
;
; Subtracts the power of ten in BC/DE from the number in HL'/HL repeatedly to work out the digit.
c29752 PUSH BC ; Copy the high word of the power of ten into DE'
 29753 EXX ; Switch to the alternate registers...
 29754 POP DE ; ...DE'=high word of the power of ten...
 29755 EXX ; ...and back again
 29756 LD C,47 ; C will count from "0"
 29758 INC C ; Next digit value
 29759 AND A ; Clear the carry flag
 29760 SBC HL,DE ; Subtract the power of ten (low word)...
 29762 EXX ; Switch to the high words...
 29763 SBC HL,DE ; ...and high word
 29765 EXX ; ...and back
 29766 JR NC,29758 ; Repeat until the number goes negative
 29768 ADD HL,DE ; Add the power of ten back on (low word)...
 29769 EXX ; Switch to the high words...
 29770 ADC HL,DE ; ...and high word
 29772 EXX ; ...and back
 29773 LD A,(29629) ; Has a non-zero digit been printed yet?
 29776 AND A ; Test the leading-zero flag
 29777 LD A,C ; A=digit
 29778 JP NZ,29509 ; Print it if so
 29781 CP 48 ; Is it a leading zero?
 29783 RET Z ; Skip it if so
 29784 LD (29629),A ; Otherwise leading zeros are over
 29787 JP 29509 ; Print the digit

; Control code 11: repeat earlier text
;
; The next byte is an offset back (n-256) to some text earlier in the message area, which is rendered up to its own end marker. This saves space where messages share phrases.
c29790 PUSH IX ; Save the message pointer
 29792 LD E,(IX+1) ; E=offset (as a negative number: the text is earlier in memory)
 29795 LD D,255 ; D=255, so DE is a negative offset
 29797 ADD IX,DE ; IX=address of the earlier text
 29799 CALL 29452 ; Render it until its own end marker
 29802 POP IX ; Restore the message pointer
 29804 INC IX ; Skip the offset byte
 29806 XOR A ; Set the zero flag: code done
 29807 RET ; Done

; The random-choice counter
b29808 DEFB 0,0

; Control code 10: random choice
;
; The next byte is the number of alternatives n, followed by n single items (one or two bytes each). One item is chosen at random and rendered. This is how Louey varies his patter ("[What wuz dat, Boss? I missed it/It's okay, Boss - this line aint tapped...]").
c29810 INC IX ; Point at the number of alternatives
 29812 LD A,(IX+0) ; A=the number of alternatives
 29815 LD (29808),A ; Store it as the counter
 29818 DEC A ; A=n-1
 29819 CALL 30014 ; Pick a random number 0..n-1
 29822 INC A ; A=1..n
 29823 LD (29809),A ; Store the choice
 29826 INC IX ; Point at the first alternative
 29828 LD A,(29809) ; Is this the chosen alternative?
 29831 LD HL,29808 ; HL=the counter of alternatives still to skip
 29834 CP (HL) ; Is this the chosen one?
 29835 JR NZ,29844 ; Jump if not
 29837 PUSH IX ; Keep the message pointer
 29839 CALL 29458 ; Render it
 29842 POP IX ; Restore the message pointer
 29844 LD A,(IX+0) ; Get the first byte of this alternative
 29847 BIT 7,A ; A dictionary word (2 bytes)?
 29849 JR NZ,29859 ; Jump if so
 29851 CP 2 ; Control code 2 (2 bytes)?
 29853 JR Z,29859 ; Two-byte item: skip both bytes
 29855 CP 11 ; Control code 11 (2 bytes)?
 29857 JR NZ,29861 ; Jump if not
 29859 INC IX ; Skip the second byte
 29861 INC IX ; Skip the first byte
 29863 LD HL,29808 ; Count down the alternatives
 29866 DEC (HL) ; One alternative fewer to go
 29867 JR NZ,29828 ; Jump back for the next one
 29869 DEC IX ; Point at the last byte (the caller moves on)
 29871 XOR A ; Set the zero flag: code done
 29872 RET ; Done: the zero flag tells the caller the message continues

; Control code 5: insert a sub-message
;
; Takes a message address from the VM byte stream (or uses the default set by SETMSG/26740 if it is 0) and renders it.
c29873 CALL 30196 ; Fetch a message address from the VM byte stream
 29876 EX DE,HL ; DE=address
 29877 LD A,D ; Is it 0?
 29878 OR E ; Combine with E: is the address zero?
 29879 JR NZ,29885 ; Jump if not
 29881 LD DE,(33898) ; Otherwise use the default set by SETMSG
 29885 PUSH IX ; Save the message pointer
 29887 PUSH DE ; Keep the sub-message address
 29888 POP IX ; IX=sub-message
 29890 CALL 29452 ; Render it
 29893 POP IX ; Restore the message pointer
 29895 XOR A ; Set the zero flag: code done
 29896 RET ; Done

; Control code 8 handler (broken backspace)
;
; The handler for message control code 8, which was evidently meant to be a backspace: it steps the text buffer pointer (#R29926) back one character so that the next character overwrites the last. The jump table at #R29248 points here. These bytes are Z80 code; each comment gives the instruction.
; .
; It is broken. The first instruction, PUSH HL, is never undone, and the dispatcher (#R29544) has just put the handler's own address in HL, so the final RET goes back to the start of the handler. The handler then runs a second time and this time returns to 23807, one byte before the start of the text buffer (23808), and executes whatever is there as code. Run in the simulator, the buffer pointer dropped by two and the call never returned. No message in the game uses code 8, so nobody ever sees it (see the #LINK(Bugs#backspace)(bugs page)).
b29897 DEFB 229 ; PUSH HL: the stray instruction (nothing ever pops it)
 29898 DEFB 42,230,116 ; LD HL,(#R29926): HL=the text buffer pointer
 29901 DEFB 43 ; DEC HL: step back one character
 29902 DEFB 34,230,116 ; LD (#R29926),HL: store the new pointer
 29905 DEFB 175 ; XOR A: set the zero flag (code done)
 29906 DEFB 201 ; RET: return, but to the wrong place because of the PUSH HL

; Expand a common word
;
; Byte values 96-127 index the table of common words at #R49710 (values from 128 are two-byte dictionary references and never reach this routine).
c29907 SUB 96 ; A=index (0-31)
 29909 LD E,A ; E=the index
 29910 LD D,0 ; DE=index
 29912 LD HL,49710 ; Point HL at the table of common words
 29915 ADD HL,DE ; Add the index once...
 29916 ADD HL,DE ; Add 2*index
 29917 LD E,(HL) ; E=offset
 29918 INC HL ; Next byte of the table entry
 29919 LD A,(HL) ; A=page
 29920 ADD A,80 ; Add 80 (type 5: an ordinary word)
 29922 LD D,A ; D=page and type
 29923 JP 29487 ; Print the word

; The text buffer pointer
b29926 DEFB 0,0

; Expand a dictionary word
;
; Words are stored one byte per letter, of which only the low 5 bits count (1=a ... 26=z, 27-31 punctuation), in the dictionary at #R48640. Bit 7 marks the last letter, except on the second letter, or the third if the second also has bit 7 set; this lets short words overlap the starts of longer ones.
;
; Input:D Bits 0-3: dictionary page; bits 4-6: type
; E Offset
@label=DICTWORD
c29928 LD A,D ; Is the reference zero (no word)?
 29929 AND 15 ; Keep only the page number (low 4 bits of D)...
 29931 OR E ; ...and combine it with the offset in E: zero means no word at all
 29932 RET Z ; Return if so
 29933 PUSH HL ; Save HL...
 29934 PUSH BC ; ...BC...
 29935 PUSH DE ; ...and DE
 29936 LD C,D ; C=type
 29937 LD A,D ; A=the type and page byte
 29938 AND 15 ; D=page (0-15)
 29940 LD D,A ; D=page, so DE=256*page+offset
 29941 LD HL,48640 ; HL=48640+256*page+offset
 29944 ADD HL,DE ; HL=the address of the word's text
 29945 LD DE,(29926) ; DE=where the next character goes in the text buffer
 29949 LD A,32 ; Put a space before the word
 29951 CALL 29519 ; Put the space in the buffer
 29954 LD A,(HL) ; First letter: low 5 bits
 29955 INC HL ; Step on to the second letter
 29956 AND 31 ; Keep the low 5 bits (1-26 = A-Z)
 29958 OR 96 ; Convert to a lower case letter
 29960 LD B,A ; B=letter
 29961 LD A,C ; Is this a capitalised word (type 7)?
 29962 AND 240 ; Look at the type nibble only
 29964 CP 112 ; Is it type 7 (capitalised word)?
 29966 JR NZ,29970 ; Jump if not
 29968 RES 5,B ; Make the letter upper case
 29970 LD A,B ; A=the first letter, upper or lower case
 29971 CALL 29519 ; Put the first letter in the buffer
 29974 LD B,1 ; B counts the letters
 29976 LD A,(HL) ; Next letter
 29977 AND 31 ; Keep the low 5 bits of the next letter
 29979 JR Z,30010 ; A zero letter ends the word
 29981 INC B ; Count it
 29982 ADD A,96 ; Convert to a lower case letter
 29984 CALL 29519 ; Put it in the buffer
 29987 BIT 7,(HL) ; Does bit 7 mark the end of the word?
 29989 INC HL ; Step on to the next byte
 29990 JR Z,29976 ; Carry on if not
 29992 LD A,B ; Bit 7 is ignored on the second letter...
 29993 CP 2 ; Is this the second letter?
 29995 JR Z,29976 ; Yes: its end bit is ignored, so carry on
 29997 CP 3 ; ...and on the third...
 29999 JR NZ,30010 ; Finished if this is the fourth letter or later
 30001 DEC HL ; ...if the second letter also had bit 7 set
 30002 DEC HL ; Step back two bytes to the second letter...
 30003 LD A,(HL) ; ...and pick it up
 30004 INC HL ; Step forward again...
 30005 INC HL ; ...to the byte after the third letter
 30006 BIT 7,A ; Did the second letter have its end bit set?
 30008 JR NZ,29976 ; Carry on if so
 30010 POP DE ; Restore DE...
 30011 POP BC ; ...BC...
 30012 POP HL ; ...and HL
 30013 RET ; Done: the word is in the text buffer

; Get a random number between 0 and n
;
; Calls #R30026 (which returns -n..n) and negates a negative result, so the result is always 0..n. Because of the way #R30026 folds large values, the result is not uniform: for n=100, the values 1-27 are twice as likely as the others (raw bytes above 200 are halved, which lands them just above n).
;
; Input:A n
; Output:A Random number
@label=RANDOMPM
c30014 CALL 30026 ; Get a random number 0..A
 30017 BIT 7,A ; Is bit 7 of the result set?
 30019 RET Z ; Return if not
 30020 NEG ; Otherwise negate it
 30022 RET ; Done: A=0..limit

; The random number pointer
b30023 DEFB 0,80,0

; Get a random number
;
; Steps a pointer through the code of the program itself (#R30023) and mixes the bytes it finds, ensuring that the same value never comes up twice in a row, halves it until it is no more than 2*A, and subtracts A, giving a number between -A and A.
;
; Input:A Upper limit
; Output:A Random number
@label=RANDOM
c30026 PUSH IX ; Save IX
 30028 PUSH BC ; Save BC
 30029 LD C,A ; C=upper limit
 30030 SLA A ; Double it for the mask comparison
 30032 JR NC,30036 ; The doubled limit fits in a byte
 30034 LD A,255 ; Limit to 255
 30036 LD B,A ; B=limit*2
 30037 LD IX,30023 ; Point IX at the random number pointer
 30041 INC (IX+1) ; Step the pointer on by 256 bytes (increment its high byte)...
 30044 JR NZ,30049 ; No wrap-round: carry on
 30046 INC (IX+0) ; ...and the low byte too if the high byte wrapped
 30049 LD IX,(30023) ; IX=the pointer (which wanders through the whole of memory)
 30053 LD A,(30025) ; Pick up the last random number
 30056 ADC A,(IX+0) ; Add the byte at the pointer
 30059 ADD IX,DE ; Step on by DE (whatever DE happens to hold)
 30061 XOR (IX+1) ; Mix in another byte
 30064 PUSH HL ; Save HL
 30065 LD HL,30025 ; Is the new number the same as the last one?
 30068 CP (HL) ; Same as the previous number?
 30069 POP HL ; Restore HL
 30070 JR Z,30037 ; Try again if so
 30072 LD (30025),A ; Store the new random number
 30075 CP B ; Halve it until it is no greater than 2*limit
 30076 JR C,30085 ; Within range: done
 30078 JR Z,30085 ; Exactly equal to the limit: done
 30080 SRL A ; Halve the number
 30082 JP 30075 ; Check again
 30085 SUB C ; Subtract the limit (giving -limit..+limit)
 30086 POP BC ; Restore BC
 30087 POP IX ; Restore IX
 30089 RET ; Done: A=a random number from -limit to +limit

; The VM program counter
b30090 DEFB 0,0

; Run a VM script
;
; The game logic is written in a compact interpreted language. IY points at the first instruction; instructions are executed until op 0 (END). See the #LINK(VM)(VM reference) page for the full instruction set. The flags returned by each instruction are preserved (PUSH AF/POP AF) so that op 12 (JZ) can test the result of a native routine called by op 14.
;
; Input:IY Script address
@label=RUNVM
c30092 LD (30090),IY ; Set the VM program counter
 30096 PUSH AF ; Save the flags from the previous instruction
 30097 CALL 30214 ; Fetch the opcode
 30100 ADD A,A ; Double it for the jump table at #R30123
 30101 LD HL,30123 ; HL=start of the VM jump table
 30104 ADD A,L ; Add the doubled opcode to L...
 30105 LD L,A ; L=the low byte of the entry address
 30106 LD A,0 ; Prepare to add the carry to H...
 30108 ADC A,H ; ...A=H+carry
 30109 LD H,A ; HL=entry in the jump table
 30110 LD A,(HL) ; Pick up the handler address
 30111 INC HL ; Next byte of the entry
 30112 LD H,(HL) ; H=high byte of the handler address
 30113 LD L,A ; L=low byte: HL=handler
 30114 POP AF ; Restore the flags from the previous instruction
 30115 CALL 30122 ; Execute the instruction
 30118 JR 30096 ; Back for the next one

; VM op 0: END
c30120 POP HL ; Op 0 (END): drop the return address to #R30118...
 30121 RET ; ...and return from the interpreter

; Jump to the address in HL
c30122 JP (HL) ; Jump to the opcode handler

; VM opcode jump table
;
; Addresses of the handlers for VM opcodes 0-34 (used by #R30092).
w30123 DEFW 30120,30225,30231,30238
 30131 DEFW 30246,30252,30258,30265
 30139 DEFW 30271,30279,30289,30299
 30147 DEFW 30307,30313,30318,30335
 30155 DEFW 30441,30433,30438,30464
 30163 DEFW 30456,30461,30657,30649
 30171 DEFW 30654,30707,30712,30580
 30179 DEFW 31197,30482,30479,30634
 30187 DEFW 30488,30511,30508

; Compare two variables and fetch a jump address
;
; Used by ops 3-8.
;
; Output:F Flags of (second variable - first variable)
; HL Jump address
c30193 CALL 30342 ; Compare the variable in the next byte with the one in the byte after

; Fetch a word from the VM stream
;
; Flags are preserved.
;
; Output:HL Word
@label=FETCHWORD
c30196 PUSH AF ; Save the flags
 30197 LD HL,(30090) ; Pick up the VM program counter
 30200 LD A,(HL) ; Fetch the low byte
 30201 INC HL ; Step past the low byte...
 30202 INC HL ; ...and the high byte
 30203 LD (30090),HL ; Advance the program counter by 2
 30206 DEC HL ; Back to the high byte
 30207 LD H,(HL) ; Fetch the high byte
 30208 LD L,A ; HL=word
 30209 POP AF ; Restore the flags
 30210 RET ; Done: HL=the 16-bit operand

; Fetch a word and then a byte from the VM stream
;
; Output:HL Word
; A Byte
c30211 CALL 30196 ; Fetch a word into HL first

; Fetch a byte from the VM stream
;
; Output:A Byte
@label=FETCHBYTE
c30214 PUSH HL ; Save HL
 30215 LD HL,(30090) ; Pick up the VM program counter
 30218 LD A,(HL) ; Fetch the byte
 30219 INC HL ; Advance the program counter
 30220 LD (30090),HL ; Advance the program counter
 30223 POP HL ; Restore HL
 30224 RET ; Done: A=the byte

; VM op 1: SAY
c30225 CALL 30211 ; Op 1 (SAY): fetch the message address (HL) and the flags (A)
 30228 JP 28549 ; Show the speech bubble

; VM op 2: SETMSG
c30231 CALL 30196 ; Op 2 (SETMSG): fetch a message address
 30234 LD (33898),HL ; Make it the default sub-message for control code 5
 30237 RET ; Done

; VM op 3: IFEQ
c30238 CALL 30193 ; Op 3 (IFEQ): compare the variables
 30241 RET NZ ; Return unless they are equal
 30242 LD (30090),HL ; Jump: set the VM program counter to HL
 30245 RET ; Done

; VM op 4: IFNE
c30246 CALL 30193 ; Op 4 (IFNE)
 30249 RET Z ; Return if the variables are equal
 30250 JR 30242 ; Otherwise jump

; VM op 5: IFLE
c30252 CALL 30193 ; Op 5 (IFLE)
 30255 RET C ; Return if the second variable is less than the first
 30256 JR 30242 ; Otherwise jump

; VM op 6: IFLT
c30258 CALL 30193 ; Op 6 (IFLT)
 30261 RET Z ; Return if the variables are equal...
 30262 RET C ; ...or if the second is less than the first
 30263 JR 30242 ; Otherwise jump

; VM op 7: IFGT
c30265 CALL 30193 ; Op 7 (IFGT)
 30268 RET NC ; Return unless the second variable is less than the first
 30269 JR 30242 ; Otherwise jump

; VM op 8: IFGE
c30271 CALL 30193 ; Op 8 (IFGE)
 30274 JR Z,30242 ; Jump if the variables are equal
 30276 RET NC ; Return if the second variable is greater
 30277 JR 30242 ; Otherwise jump

; VM op 9: IFPEEKEQ
c30279 CALL 30211 ; Op 9 (IFPEEKEQ): fetch an address and a byte
 30282 CP (HL) ; Compare the byte at the address
 30283 CALL 30196 ; Fetch the jump address
 30286 RET NZ ; Return unless equal
 30287 JR 30242 ; Otherwise jump

; VM op 10: IFPEEKNE
c30289 CALL 30211 ; Op 10 (IFPEEKNE): fetch an address and a byte
 30292 CP (HL) ; Compare the byte at the address
 30293 CALL 30196 ; Fetch the jump address
 30296 RET Z ; Return if equal
 30297 JR 30242 ; Otherwise jump

; VM op 11: POKE
c30299 CALL 30214 ; Op 11 (POKE): fetch the byte
 30302 CALL 30196 ; Fetch the address
 30305 LD (HL),A ; POKE it
 30306 RET ; Done

; VM op 12: JZ
c30307 CALL 30196 ; Op 12 (JZ): fetch the jump address (preserving the flags)
 30310 RET NZ ; Return if the zero flag is reset
 30311 JR 30242 ; Otherwise jump

; VM op 13: GOTO
c30313 CALL 30196 ; Op 13 (GOTO): fetch the jump address
 30316 JR 30242 ; And jump

; VM op 14: CALL
c30318 LD HL,(30090) ; Op 14 (CALL): save the address of the operand
 30321 PUSH HL ; Keep the address of the operand
 30322 CALL 30196 ; Fetch the address of the native routine
 30325 CALL 30122 ; Call it
 30328 POP HL ; Restore the address of the operand
 30329 INC HL ; Step past the first byte of the operand...
 30330 INC HL ; Skip the operand
 30331 LD (30090),HL ; Set the VM program counter (anything the native routine fetched is ignored)
 30334 RET ; Done

; VM op 15: STORE
c30335 CALL 30214 ; Op 15 (STORE): fetch the variable number
 30338 LD L,A ; L=the variable number
 30339 JP 31179 ; Store BCDE in it

; Compare BCDE with a variable
;
; Compares the value in BCDE with the variable whose number is the next byte in the VM stream.
;
; Input:BCDE First value
; Output:F Zero set if equal; carry set if the variable is less than BCDE
@label=COMPARE
c30342 CALL 31197 ; BCDE=first variable
 30345 CALL 30214 ; Fetch the number of the second variable
 30348 LD L,A ; L=the variable number
 30349 LD H,0 ; HL=variable number
 30351 ADD HL,HL ; HL=2*variable
 30352 ADD HL,HL ; HL=4*variable number
 30353 PUSH DE ; Save the low word of the first value
 30354 LD DE,33552 ; Point IY at the second variable
 30357 ADD HL,DE ; HL=address of the second variable
 30358 POP DE ; Restore DE
 30359 PUSH HL ; Copy HL into IY...
 30360 POP IY ; ...by way of the stack
 30362 LD A,B ; Is the first value zero?
 30363 OR C ; Combine C into the zero test...
 30364 OR D ; ...and D...
 30365 OR E ; ...and E
 30366 JR Z,30396 ; Jump if so
 30368 LD A,(IY+3) ; Do the signs differ?
 30371 XOR B ; Compare the sign bits: XOR the top bytes
 30372 AND 128 ; Keep just the sign bit
 30374 JR NZ,30417 ; Jump if so
 30376 LD A,(IY+3) ; Same sign: compare the high bytes
 30379 CP B ; Compare the top bytes
 30380 RET NZ ; Return if they differ (carry set if the second is lower)
 30381 LD A,(IY+2) ; Compare the next bytes
 30384 CP C ; Compare the next bytes
 30385 RET NZ ; Different: that decides it
 30386 LD A,(IY+1) ; Next byte of the second value
 30389 CP D ; Compare with D
 30390 RET NZ ; Different: that decides it
 30391 LD A,(IY+0) ; Compare the low bytes
 30394 CP E ; Compare the lowest bytes
 30395 RET ; Return with the flags: Z=equal, C=second is smaller
 30396 BIT 7,(IY+3) ; First value is zero: is the second negative?
 30400 JR Z,30404 ; Jump if not
 30402 SCF ; Carry set: second < first
 30403 RET ; Return with carry set
 30404 LD A,(IY+3) ; Set the zero flag if the second is also zero
 30407 OR (IY+2) ; OR in the next byte...
 30410 OR (IY+1) ; ...and the next...
 30413 OR (IY+0) ; ...and the lowest
 30416 RET ; Return (the carry flag is reset by OR)
 30417 BIT 7,B ; Signs differ: is the first value negative?
 30419 RET NZ ; Return (zero and carry reset: second > first) if so
 30420 OR 1 ; Otherwise reset the zero flag...
 30422 SCF ; ...and set the carry flag: second < first
 30423 RET ; Return with NZ and carry set

; Load two variables
;
; Loads the variable named by the next VM byte into BCDE and the one after into BC'DE'.
c30424 CALL 31197 ; BCDE=first operand

; Load the second operand
;
; Loads the variable named by the next VM byte into BC'DE'.
c30427 EXX ; Switch to the second register set
 30428 CALL 31197 ; BC'DE'=second operand
 30431 EXX ; Back to the main registers
 30432 RET ; Done: BCDE=first operand, BC'DE'=second

; VM op 17: ADD v
c30433 CALL 30427 ; Load the operand into BC'DE'
 30436 JR 30441 ; Add

; VM op 18: ADD v,v
c30438 CALL 30424 ; Load the two operands into BCDE and BC'DE'

; VM op 16: ADD (BCDE=BCDE+BC'DE')
c30441 PUSH BC ; Add the low words...
 30442 PUSH DE ; ...and the low word
 30443 EXX ; Switch to the second operand
 30444 POP HL ; HL=low word of the first operand
 30445 AND A ; Clear the carry flag
 30446 ADC HL,DE ; Add the low words
 30448 EX (SP),HL ; HL=high word of the first operand; the low sum goes on the stack
 30449 ADC HL,BC ; ...and the high words with carry
 30451 PUSH HL ; Keep the high sum
 30452 EXX ; Back to the main registers
 30453 POP BC ; BC=high word of the sum
 30454 POP DE ; DE=low word
 30455 RET ; Done: BCDE=the sum

; VM op 20: SUB v
c30456 CALL 30427 ; Load the operand into BC'DE'
 30459 JR 30464 ; Subtract

; VM op 21: SUB v,v
c30461 CALL 30424 ; Load the two operands into BCDE and BC'DE'

; VM op 19: SUB
c30464 PUSH BC ; Subtract the low words...
 30465 PUSH DE ; Keep the low word
 30466 EXX ; Switch to the second operand
 30467 POP HL ; HL=low word of the first operand
 30468 AND A ; Clear the carry flag
 30469 SBC HL,DE ; Subtract the low words
 30471 EX (SP),HL ; HL=high word of the first operand; the low difference goes on the stack
 30472 SBC HL,BC ; ...and the high words with borrow
 30474 PUSH HL ; Keep the high difference
 30475 EXX ; Back to the main registers
 30476 POP BC ; BC=high word of the difference
 30477 POP DE ; DE=low word
 30478 RET ; Done: BCDE=the difference

; VM op 30: RND v
c30479 CALL 31197 ; Load the operand

; VM op 29: RND (replace E with a random number 0..E)
;
; Only the low byte of the accumulator is changed, so RND behaves oddly on values of 2.56 or more. The script only ever uses RND v71 (1.00), giving a random number between 0 and 1.00.
c30482 LD A,E ; A=low byte
 30483 CALL 30014 ; Replace it with a random number 0..A
 30486 LD E,A ; E=the random number
 30487 RET ; Done

; VM op 32: HALF v
c30488 CALL 31197 ; Load the operand

; Halve BCDE (arithmetic shift right)
c30491 SRA B ; Halve BCDE
 30493 RR C ; Shift C right with the carry from B
 30495 RR D ; ...D...
 30497 RR E ; ...and E
 30499 RET ; Done: BCDE=BCDE/2

; Square root workspace
;
; Used by the square root routine at #R30511. Both values are 32-bit numbers in hundredths.
b30500 DEFB 0,0,0,0 ; The current estimate x (#R30500-30503)
 30504 DEFB 0,0,0,0 ; The argument n (#R30504-30507)

; VM op 34: SQRT v (BCDE=square root of a variable)
c30508 CALL 31197 ; Load the operand

; VM op 33: SQRT (Newton's method; never terminates for some values; see #LINK(Bugs#sqrt)(the bugs page))
c30511 LD (30504),DE ; Store the argument n
 30515 LD (30506),BC ; Store the top word of the argument
 30519 CALL 30491 ; First estimate: x=n/2
 30522 LD (30500),DE ; Store the estimate x
 30526 LD (30502),BC ; Store the top word of the estimate
 30530 EXX ; Switch to the alternate registers (BC'DE' will hold x)
 30531 LD DE,(30504) ; BCDE=n
 30535 LD BC,(30506) ; BC=top word of n
 30539 CALL 30715 ; BCDE=n/x (BC'DE' holds x)
 30542 EXX ; Back to the main registers
 30543 LD DE,(30500) ; BCDE=x
 30547 LD BC,(30502) ; BC=top word of x
 30551 CALL 30441 ; Add n/x
 30554 CALL 30491 ; Halve: the new estimate is (x+n/x)/2
 30557 LD HL,30500 ; Compare it with the previous estimate
 30560 LD A,(HL) ; A=byte 0 of the previous estimate
 30561 CP E ; Same as E?
 30562 JR NZ,30522 ; Try again if different
 30564 INC HL ; Next byte
 30565 LD A,(HL) ; A=byte 1 of the previous estimate
 30566 CP D ; Same as D?
 30567 JR NZ,30522 ; Not the same: do another iteration
 30569 INC HL ; Next byte
 30570 LD A,(HL) ; A=byte 2 of the previous estimate
 30571 CP C ; Same as C?
 30572 JR NZ,30522 ; Not the same: do another iteration
 30574 INC HL ; Next byte
 30575 LD A,(HL) ; A=byte 3 of the previous estimate
 30576 CP B ; Same as B?
 30577 JR NZ,30522 ; Try again if different (for some arguments the estimates alternate for ever)
 30579 RET ; Return with the square root in BCDE

; VM op 27: INT
c30580 CALL 30993 ; Make the operands positive, noting the sign of the result (from BCDE and, wrongly, BC'DE')
 30583 LD (31030),DE ; Copy BCDE into the 64-bit dividend
 30587 LD (31032),BC ; Store the top word of the value
 30591 LD HL,0 ; Clear the upper words...
 30594 LD (31034),HL ; ...bytes 4-5...
 30597 LD (31036),HL ; ...and bytes 6-7 of the 64-bit dividend
 30600 LD BC,0 ; Divide by 100
 30603 LD DE,100 ; DE=100
 30606 CALL 31055 ; Divide by 100
 30609 LD BC,0 ; Multiply by 100 (dropping the fractional part)
 30612 LD DE,100 ; DE=100
 30615 CALL 30782 ; Multiply by 100
 30618 LD DE,(31030) ; BCDE=result
 30622 LD BC,(31032) ; BC=the top word of the result
 30626 LD A,(31054) ; Should it be negative?
 30629 AND A ; Test the sign flag
 30630 RET Z ; Return if not
 30631 JP 30634 ; Negate it

; VM op 31: NEG (BCDE=-BCDE)
c30634 LD HL,0 ; Negate the low word...
 30637 AND A ; Clear the carry flag
 30638 SBC HL,DE ; Subtract the low word from 0
 30640 EX DE,HL ; DE=the negated low word
 30641 LD HL,0 ; ...and the high word
 30644 SBC HL,BC ; Subtract the high word from 0
 30646 PUSH HL ; Copy HL into BC...
 30647 POP BC ; ...by way of the stack
 30648 RET ; Done: BCDE=-BCDE

; VM op 23: MUL v
c30649 CALL 30427 ; Load the operand into BC'DE'
 30652 JR 30657 ; Multiply

; VM op 24: MUL v,v
c30654 CALL 30424 ; Load the two operands into BCDE and BC'DE'

; VM op 22: MUL (BCDE=BCDE*BC'DE'/100)
;
; Both values are fixed point with two decimal places, so the 64-bit product is divided by 100. The signs are handled separately by #R30993.
c30657 CALL 30993 ; Make both operands positive, noting the sign of the result
 30660 EXX ; Switch to BC'DE', the second operand...
 30661 LD (31038),DE ; Store BC'DE' as the multiplier
 30665 LD (31040),BC ; Store its top word as the multiplier's
 30669 EXX ; Back to the main registers
 30670 LD HL,0 ; Clear the top half of the multiplier
 30673 LD (31042),HL ; Clear multiplier bytes 4-5...
 30676 LD (31044),HL ; ...and 6-7
 30679 CALL 30782 ; 64-bit product=BCDE*multiplier
 30682 LD BC,0 ; Divide by 100 (the fixed-point scale)
 30685 LD DE,100 ; DE=100
 30688 CALL 31055 ; Divide by 100 (the fixed-point scale)
 30691 LD DE,(31038) ; BCDE=result
 30695 LD BC,(31040) ; BC=the top word of the quotient
 30699 LD A,(31054) ; Should it be negative?
 30702 AND A ; Test the sign flag
 30703 RET Z ; Return if not
 30704 JP 30634 ; Negate it

; VM op 25: DIV v
c30707 CALL 30427 ; Load the operand into BC'DE'
 30710 JR 30715 ; Divide

; VM op 26: DIV v,v
c30712 CALL 30424 ; Load the two operands into BCDE and BC'DE'

; Divide BCDE by BC'DE' (x100)
;
; Returns 0 if the divisor is 0.
c30715 CALL 30993 ; Make both operands positive, noting the sign of the result
 30718 LD (31038),DE ; Store BCDE (the dividend) as the multiplier
 30722 LD (31040),BC ; Store the top word of the dividend
 30726 LD HL,0 ; HL=0...
 30729 LD (31042),HL ; ...clear the upper half...
 30732 LD (31044),HL ; ...of the 64-bit multiplier
 30735 EXX ; Switch to BC'DE', the divisor
 30736 LD A,B ; Is the divisor zero?
 30737 OR C ; Combine C...
 30738 OR D ; ...D...
 30739 OR E ; ...E: the divisor is zero if all clear
 30740 JR NZ,30750 ; Jump if not
 30742 EXX ; Switch back to the main registers
 30743 LD BC,0 ; Return 0 for division by zero
 30746 LD DE,0 ; DE=0
 30749 RET ; Done: division by zero gives zero
 30750 PUSH BC ; Save the divisor
 30751 PUSH DE ; Save the divisor's low word
 30752 LD BC,0 ; BCDE=100
 30755 LD DE,100 ; BCDE=100
 30758 CALL 30782 ; 64-bit product=dividend*100
 30761 POP DE ; Restore the divisor
 30762 POP BC ; Restore the divisor's high word
 30763 CALL 31055 ; Divide the product by it
 30766 LD DE,(31038) ; BCDE=quotient
 30770 LD BC,(31040) ; BC=the high word of the quotient
 30774 LD A,(31054) ; Should it be negative?
 30777 AND A ; Test the result sign flag
 30778 RET Z ; Return if not
 30779 JP 30634 ; Negate it

; Multiply BCDE by the value at #R31038 (64-bit)
;
; The product goes into #R31030-31037.
c30782 LD HL,0 ; Clear the 64-bit product
 30785 LD (31030),HL ; Clear bytes 0-1 of the 64-bit product...
 30788 LD (31032),HL ; ...bytes 2-3...
 30791 LD (31034),HL ; ...bytes 4-5...
 30794 LD (31036),HL ; ...and bytes 6-7
 30797 LD A,B ; Any bits of BCDE left?
 30798 OR C ; Combine C into the test...
 30799 OR D ; ...and D...
 30800 OR E ; ...and E: zero when the multiplier is used up
 30801 RET Z ; Return if not
 30802 BIT 0,E ; Is the lowest bit set?
 30804 JR Z,30855 ; Jump if not
 30806 EXX ; Add the multiplier to the product (64 bits)
 30807 LD HL,(31038) ; HL=low word of the shifted multiplicand
 30810 LD DE,(31030) ; DE=low word of the product so far
 30814 ADD HL,DE ; Add them
 30815 LD (31030),HL ; Store the new low word of the product
 30818 LD HL,(31040) ; HL=second word of the multiplicand
 30821 LD DE,(31032) ; DE=second word of the product
 30825 ADC HL,DE ; Add with the carry from below
 30827 LD (31032),HL ; Store it
 30830 LD HL,(31042) ; HL=third word of the multiplicand
 30833 LD DE,(31034) ; DE=third word of the product
 30837 ADC HL,DE ; Add with carry
 30839 LD (31034),HL ; Store it
 30842 LD HL,(31044) ; HL=top word of the multiplicand
 30845 LD DE,(31036) ; DE=top word of the product
 30849 ADC HL,DE ; Add with carry
 30851 LD (31036),HL ; Store it
 30854 EXX ; Back to the normal registers
 30855 LD HL,31038 ; Double the multiplier
 30858 CALL 30871 ; Shift the multiplier left
 30861 SRA B ; Shift BCDE right one bit
 30863 RR C ; Shift BCDE right: C...
 30865 RR D ; ...D...
 30867 RR E ; ...and E
 30869 JR 30797 ; Next bit

; Shift an 8-byte number left one bit
;
; HL points at the low byte.
c30871 SLA (HL) ; Shift the low byte left
 30873 LD A,7 ; 7 more bytes
 30875 INC HL ; Next byte
 30876 RL (HL) ; Shift the next byte left, bringing in the carry
 30878 DEC A ; One fewer byte to do
 30879 JR NZ,30875 ; Repeat for all the remaining bytes
 30881 RET ; Done

; Shift an 8-byte number right one bit (arithmetic)
;
; HL points at the high byte.
c30882 SRA (HL) ; Shift the high byte right (keeping the sign)
 30884 LD A,7 ; 7 more bytes
 30886 INC HL ; Next byte
 30887 RR (HL) ; Shift the next byte right, bringing in the carry
 30889 DEC A ; One fewer byte to do
 30890 JR NZ,30886 ; Repeat for all the remaining bytes
 30892 RET ; Done

; Subtract the divisor from the dividend (64-bit)
c30893 LD HL,(31030) ; Subtract the divisor from the dividend, 16 bits at a time
 30896 LD DE,(31046) ; DE=low word of the divisor
 30900 AND A ; Clear the carry flag
 30901 SBC HL,DE ; Subtract the low words
 30903 LD (31030),HL ; Store the new low word
 30906 LD HL,(31032) ; HL=second word of the dividend
 30909 LD DE,(31048) ; DE=second word of the divisor
 30913 SBC HL,DE ; Subtract with borrow
 30915 LD (31032),HL ; Store it
 30918 LD HL,(31034) ; HL=third word of the dividend
 30921 LD DE,(31050) ; DE=third word of the divisor
 30925 SBC HL,DE ; Subtract with borrow
 30927 LD (31034),HL ; Store it
 30930 LD HL,(31036) ; HL=top word of the dividend
 30933 LD DE,(31052) ; DE=top word of the divisor
 30937 SBC HL,DE ; Subtract with borrow
 30939 LD (31036),HL ; Store it (H holds the sign of the 64-bit result)
 30942 BIT 7,H ; Set the zero flag if the result is not negative
 30944 RET ; Return with Z set if the result is not negative

; Add the divisor to the dividend (64-bit)
c30945 LD HL,(31030) ; Add the divisor to the dividend, 16 bits at a time
 30948 LD DE,(31046) ; DE=low word of the divisor
 30952 ADD HL,DE ; Add the low words
 30953 LD (31030),HL ; Store the new low word
 30956 LD HL,(31032) ; HL=second word of the dividend
 30959 LD DE,(31048) ; DE=second word of the divisor
 30963 ADC HL,DE ; Add with carry
 30965 LD (31032),HL ; Store it
 30968 LD HL,(31034) ; HL=third word of the dividend
 30971 LD DE,(31050) ; DE=third word of the divisor
 30975 ADC HL,DE ; Add with carry
 30977 LD (31034),HL ; Store it
 30980 LD HL,(31036) ; HL=top word of the dividend
 30983 LD DE,(31052) ; DE=top word of the divisor
 30987 ADC HL,DE ; Add with carry
 30989 LD (31036),HL ; Store it
 30992 RET ; Done: the trial subtraction is undone

; Make BCDE and BC'DE' positive
;
; Records in #R31054 whether the result must be negated.
c30993 XOR A ; Clear the sign flag
 30994 LD (31054),A ; Store 0: the result is positive so far
 30997 BIT 7,B ; Is BCDE negative?
 30999 JR Z,31012 ; Jump if not
 31001 CALL 30634 ; Make it positive
 31004 LD A,(31054) ; Flip the sign flag
 31007 XOR 1 ; Flip the sign flag...
 31009 LD (31054),A ; ...and store it
 31012 EXX ; Now look at BC'DE'
 31013 BIT 7,B ; Is it negative?
 31015 JR Z,31028 ; Jump if not
 31017 CALL 30634 ; Make it positive
 31020 LD A,(31054) ; Flip the sign flag
 31023 XOR 1 ; Flip the sign flag...
 31025 LD (31054),A ; ...and store it
 31028 EXX ; Back to the main registers
 31029 RET ; Done: both operands positive, #R31054 holds the sign of the result

; Arithmetic workspace
;
; 64-bit product/dividend (#R31030-31037), multiplier/quotient (#R31038-31045), divisor (#R31046-31053) and the sign flag (#R31054).
b31030 DEFB 0,0,0,0,0,0,0,0
 31038 DEFB 0,0,0,0,0,0,0,0
 31046 DEFB 0,0,0,0,0,0,0,0
 31054 DEFB 0

; Divide the 64-bit number at #R31030 by BCDE
;
; Shift-and-subtract long division. The quotient goes into #R31038.
c31055 LD HL,0 ; Clear the quotient
 31058 LD (31038),HL ; Clear the quotient: bytes 0-1...
 31061 LD (31040),HL ; ...bytes 2-3...
 31064 LD (31042),HL ; ...bytes 4-5...
 31067 LD (31044),HL ; ...and bytes 6-7
 31070 LD (31046),DE ; Store BCDE as the divisor (64 bits)
 31074 LD (31048),BC ; Divisor bytes 4-5 from BC
 31078 LD (31050),HL ; Divisor bytes 6-7 are zero...
 31081 LD (31052),HL ; ...(HL is still 0)
 31084 CALL 30893 ; Is the dividend smaller than the divisor?
 31087 PUSH AF ; Keep the comparison result...
 31088 CALL 30945 ; Undo the trial subtraction
 31091 POP AF ; ...and get it back after undoing
 31092 RET NZ ; Return with a quotient of 0 if so
 31093 LD HL,31037 ; Find the highest non-zero byte of the dividend
 31096 LD B,8 ; Examine up to 8 bytes
 31098 LD A,(HL) ; A=the byte of the dividend
 31099 AND A ; Is it zero?
 31100 JR NZ,31106 ; Found a non-zero byte
 31102 DEC HL ; Zero: look at the next lower byte
 31103 DJNZ 31098 ; Keep looking down the bytes
 31105 RET Z ; The dividend is zero: quotient 0
 31106 LD C,128 ; Find its highest set bit
 31108 LD A,(HL) ; A=the byte
 31109 AND C ; Test bit C
 31110 JR NZ,31116 ; Found the highest set bit
 31112 RRC C ; Try the next lower bit
 31114 JR 31108 ; Keep looking
 31116 LD DE,16 ; Point DE at the corresponding byte of the divisor
 31119 ADD HL,DE ; HL=the matching byte of the divisor
 31120 EX DE,HL ; DE=address of the divisor byte
 31121 LD B,1 ; B counts the shifts needed
 31123 LD A,(DE) ; Shift the divisor left until its top bit lines up with the dividend's
 31124 AND C ; Is the same bit set in the divisor?
 31125 JR NZ,31136 ; The bits line up: stop shifting
 31127 INC B ; Not yet: count another shift
 31128 LD HL,31046 ; HL=the divisor
 31131 CALL 30871 ; Shift the divisor left
 31134 JR 31123 ; Check again
 31136 PUSH BC ; Save the shift count
 31137 LD HL,31038 ; Shift the quotient left
 31140 CALL 30871 ; Shift the quotient left
 31143 CALL 30893 ; Subtract the divisor
 31146 JR Z,31153 ; Jump if the result was not negative
 31148 CALL 30945 ; Otherwise add it back
 31151 JR 31161 ; Skip the remaining bit-setting
 31153 LD A,(31038) ; Set the lowest bit of the quotient
 31156 OR 1 ; ...a 1 for a successful subtraction
 31158 LD (31038),A ; Store the quotient
 31161 LD HL,31030 ; Shift the dividend left
 31164 CALL 30871 ; Shift the dividend left
 31167 DJNZ 31137 ; Repeat for each bit position
 31169 POP BC ; Restore the shift count
 31170 LD HL,31030 ; Shift the remainder back
 31173 CALL 30882 ; Shift the remainder right
 31176 DJNZ 31170 ; Once for each shift made
 31178 RET ; Done: the quotient is in #R31038 (64 bits)

; Store BCDE in a variable
;
; Used by VM op 15 (STORE, #R30335) and by native routines that leave results in VM variables.
;
; Input:L Variable number (from the VM stream)
@label=STOREVAR
c31179 LD H,0 ; HL=4*variable number
 31181 ADD HL,HL ; HL=2*variable
 31182 ADD HL,HL ; HL=4*variable
 31183 PUSH DE ; Save the low word of the value
 31184 LD DE,33552 ; Point HL at the variable
 31187 ADD HL,DE ; HL=address of the variable
 31188 POP DE ; Restore DE
 31189 LD (HL),E ; Store BCDE (low byte first)
 31190 INC HL ; Next byte of the variable
 31191 LD (HL),D ; Store the second byte
 31192 INC HL ; Next byte
 31193 LD (HL),C ; Store the third byte
 31194 INC HL ; Next byte
 31195 LD (HL),B ; Store the top byte (the sign)
 31196 RET ; Done

; VM op 28: LOAD (load a variable into BCDE)
c31197 CALL 30214 ; Fetch the variable number from the VM stream
 31200 LD L,A ; L=the variable number

; Load variable L into BCDE
;
; Input:L Variable number
@label=LOADVAR
c31201 LD H,0 ; HL=4*variable number
 31203 ADD HL,HL ; HL=2*variable
 31204 ADD HL,HL ; HL=4*variable
 31205 LD DE,33552 ; Point HL at the variable
 31208 ADD HL,DE ; HL=address of the variable
 31209 LD E,(HL) ; Load it into BCDE (low byte first)
 31210 INC HL ; Next byte
 31211 LD D,(HL) ; D=second byte
 31212 INC HL ; Next byte
 31213 LD C,(HL) ; C=third byte
 31214 INC HL ; Next byte
 31215 LD B,(HL) ; B=top byte (the sign)
 31216 INC HL ; Point past the variable
 31217 RET ; Done: BCDE=the variable

; Clear the screen
;
; Clears the display file and sets every attribute to 56 (paper 7, ink 0).
@label=CLS
c31218 PUSH HL ; Save HL
 31219 LD HL,16384 ; Clear the display file
 31222 LD DE,16385 ; DE=the next byte
 31225 LD BC,6143 ; BC=the remaining 6143 bytes
 31228 LD (HL),0 ; Clear the first byte
 31230 LDIR ; Propagate it across the display file
 31232 LD HL,22528 ; Set every attribute to paper 7, ink 0
 31235 LD DE,22529 ; DE=the next attribute
 31238 LD BC,767 ; BC=the remaining 767 attributes
 31241 LD (HL),56 ; Paper 7 (white), ink 0 (black)
 31243 LDIR ; Propagate it across the attribute file
 31245 POP HL ; Restore HL
 31246 RET ; Done: a clean white screen

; Draw a picture
;
; Pictures are stored as a list of drawing commands at IY:
; .
; #TABLE(default,centre,:w) { =h Command | =h Meaning } { 0 | End of picture } { 8, x, y | Move the pen to (x,y) } { 16, lo, hi, w, h, data... | Copy a w x h block of bytes to the screen at hi*256+lo (ORed into the display file; written directly into the attributes) } { 128-255 | Draw a line: bits 0-2 are the direction flags, and the length comes from bits 3-6 and the top 2 bits of the next byte } { 64-127, x, y | Flood fill from (x,y); bits 0-2 = the ink colour of the filled cells } { 32-63, hi, lo, runs..., 255 | Paint attribute paper colour (bits 0-2) along a path starting at hi*256+lo; each run byte gives a count (bits 2-7) and a direction (bits 0-1: up, right, down, left) } TABLE#
;
; Input:IY Picture data
@label=DRAWPIC
c31247 PUSH HL ; Save HL
 31248 PUSH DE ; Save DE
 31249 PUSH BC ; Save BC
 31250 CALL 31218 ; Clear the screen
 31253 LD D,127 ; Pen x=127
 31255 LD E,63 ; Pen y=63
 31257 LD B,1 ; Default slope
 31259 LD C,1 ; Default direction
 31261 LD L,1 ; Default length
 31263 LD A,(IY+0) ; Pick up the next command
 31266 AND A ; Is it 0 (end of picture)?
 31267 JP Z,31480 ; Finish if so
 31270 INC IY ; Point at its operands
 31272 CP 8 ; Command 8 (move the pen)?
 31274 JR NZ,31288 ; Jump if not
 31276 LD D,(IY+0) ; D=new x
 31279 INC IY ; Point at y
 31281 LD E,(IY+0) ; E=new y
 31284 INC IY ; Point at the next command
 31286 JR 31263 ; Next command
 31288 CP 16 ; Command 16 (bitmap block)?
 31290 JR NZ,31332 ; Jump if not
 31292 LD L,(IY+0) ; HL=screen address
 31295 LD H,(IY+1) ; H=the high byte of the screen address
 31298 LD B,(IY+2) ; B=width in bytes
 31301 LD C,(IY+3) ; C=height in rows
 31304 INC IY ; Skip the address, low byte...
 31306 INC IY ; ...high byte...
 31308 INC IY ; ...and the width
 31310 INC IY ; Point at the bitmap data
 31312 PUSH HL ; Save the start of the row
 31313 PUSH BC ; Save the width and height
 31314 CALL 31511 ; Put a byte on the screen
 31317 INC L ; Next column
 31318 INC IY ; Next byte of data
 31320 DJNZ 31314 ; Repeat for the width of the block
 31322 POP BC ; Restore the width and height
 31323 POP HL ; Back to the start of the row
 31324 CALL 31484 ; Move down a pixel row (or an attribute row)
 31327 DEC C ; One row done
 31328 JR NZ,31312 ; Repeat for each row
 31330 JR 31263 ; Next command
 31332 BIT 7,A ; Bit 7 set (line)?
 31334 JR Z,31369 ; Jump if not
 31336 LD B,A ; B=the command byte
 31337 AND 7 ; C=direction flags (bits 0-2)
 31339 LD C,A ; C=the direction flags
 31340 LD A,B ; A=the command byte again
 31341 RRCA ; Move bits 3-6 down...
 31342 AND 60 ; B=bits 3-6 (high bits of the slope)...
 31344 LD B,A ; B=the high part of the slope
 31345 LD A,(IY+0) ; Pick up the second byte
 31348 AND 63 ; Bits 0-5: length-1
 31350 LD L,A ; L=the low part of the length
 31351 INC L ; L=length
 31352 LD A,(IY+0) ; A=the second byte again
 31355 INC IY ; Point at the next command
 31357 RLCA ; ...plus bits 6-7 of the second byte
 31358 RLCA ; Rotate bits 6-7 round to bits 0-1...
 31359 AND 3 ; ...and keep them
 31361 OR B ; Combine them with the high part of the slope
 31362 LD B,A ; B=the slope
 31363 INC B ; B=slope
 31364 CALL 31917 ; Draw the line
 31367 JR 31263 ; Next command
 31369 BIT 6,A ; Bit 6 set (flood fill)?
 31371 JR Z,31393 ; Jump if not
 31373 AND 7 ; A=the ink colour
 31375 PUSH DE ; Save the pen position
 31376 LD D,(IY+0) ; D=x of the seed point
 31379 INC IY ; Point at y
 31381 LD E,(IY+0) ; E=y
 31384 INC IY ; Point at the next command
 31386 CALL 31525 ; Fill the area
 31389 POP DE ; Restore the pen position
 31390 JP 31263 ; Next command
 31393 BIT 5,A ; Bit 5 set (paint attributes)?
 31395 JP Z,31263 ; Ignore the command if not
 31398 AND 7 ; Bits 0-2: paper colour
 31400 RLCA ; Multiply the paper colour by 8...
 31401 RLCA ; ...to put it in bits 3-5
 31402 RLCA ; C=paper colour*8
 31403 PUSH HL ; Save HL
 31404 PUSH DE ; Save DE
 31405 PUSH BC ; Save BC
 31406 LD C,A ; C=the paper colour in bits 3-5
 31407 LD H,(IY+0) ; HL=attribute address
 31410 INC IY ; Point at the low byte of the address
 31412 LD L,(IY+0) ; L=the low byte
 31415 INC IY ; Point at the first run
 31417 LD A,(IY+0) ; Pick up the next run
 31420 INC IY ; Point at the next run
 31422 CP 255 ; End of the runs?
 31424 JR Z,31474 ; Finish if so
 31426 LD B,A ; B=the run byte
 31427 AND 3 ; E=direction (0 up, 1 right, 2 down, 3 left)
 31429 LD E,A ; E=the direction
 31430 LD A,B ; B=length of the run (bits 2-7, plus 1)
 31431 RRCA ; Shift the run length down...
 31432 RRCA ; ...two places
 31433 AND 63 ; Keep the length bits
 31435 INC A ; The length is one more
 31436 LD B,A ; B=the length
 31437 LD A,(HL) ; Take the ink of this cell
 31438 AND 7 ; Keep the ink
 31440 RLCA ; Move the ink to bits 3-5, where the paper is...
 31441 RLCA ; ...
 31442 RLCA ; ...
 31443 CP C ; Is it the same as the new paper?
 31444 JR NZ,31448 ; Jump if not
 31446 XOR 56 ; If so use paper 7 instead, so the ink stays visible
 31448 RRCA ; Move the ink back to bits 0-2
 31449 RRCA ; Move the ink back to bits 0-2...
 31450 RRCA ; ...
 31451 OR C ; Combine it with the paper
 31452 LD (HL),A ; Set the attribute
 31453 LD A,E ; Move in the run's direction
 31454 AND A ; Zero means up
 31455 CALL Z,31755 ; Up
 31458 DEC A ; 1 means right
 31459 CALL Z,31806 ; Right
 31462 DEC A ; 2 means down
 31463 CALL Z,31772 ; Down
 31466 DEC A ; 3 means left
 31467 CALL Z,31796 ; Left
 31470 DJNZ 31437 ; Repeat for the length of the run
 31472 JR 31417 ; Next run
 31474 POP BC ; Restore BC
 31475 POP DE ; Restore DE
 31476 POP HL ; Restore HL
 31477 JP 31263 ; Next command
 31480 POP BC ; Restore BC
 31481 POP DE ; Restore DE
 31482 POP HL ; Restore HL
 31483 RET ; Return

; Move HL down one pixel row in the display file (or one row in the attributes)
c31484 LD A,H ; Is HL in the attribute file?
 31485 CP 88 ; Is the high byte 88 or more (attribute file)?
 31487 JR C,31496 ; Jump if not
 31489 LD A,L ; Move down one attribute row
 31490 ADD A,32 ; Add 32 to move down one row of cells...
 31492 LD L,A ; ...L=the new low byte
 31493 RET NC ; Done unless the add carried into the high byte
 31494 INC H ; Carry: the next page
 31495 RET ; Done
 31496 INC H ; Move down one pixel row
 31497 LD A,H ; A=the new high byte
 31498 AND 7 ; The low 3 bits count the pixel row in the cell
 31500 RET NZ ; Return unless that crossed a character row
 31501 LD A,L ; Crossed into the next cell row: add 32 to L
 31502 ADD A,32 ; (next row of cells)
 31504 LD L,A ; L=the new low byte
 31505 RET C ; Carry: in the next third, H is already right
 31506 LD A,H ; Otherwise H must go back 8...
 31507 SUB 8 ; ...to stay in the same third
 31509 LD H,A ; H=the corrected high byte
 31510 RET ; Done

; Put a byte from a bitmap block on the screen
;
; ORs the byte at IY into the display file, or writes it if HL is in the attribute file.
c31511 LD A,H ; Is HL in the attribute file?
 31512 CP 88 ; Is the address 88 or more (attribute file)?
 31514 LD A,(IY+0) ; Pick up the data byte
 31517 JR NC,31520 ; Jump if so: store it as it is
 31519 OR (HL) ; Otherwise merge it with the picture
 31520 LD (HL),A ; Store the byte
 31521 RET ; Done

; The fill attribute
b31522 DEFB 0,0,0

; Flood fill
;
; Fills the area containing the pixel at (D,E) solidly with ink, scanning left and right along each row and remembering whether the rows above and below need filling. Every cell it touches also gets A as its ink colour (bits 3-5 of A, if any, are ORed in as paper: the compressed pictures pass 56, meaning ink 0 on paper 7).
;
; Input:A Attribute bits for the filled cells (ink in bits 0-2)
; D x coordinate
; E y coordinate
@label=FILL
c31525 LD (31522),A ; Store the attribute bits for the filled cells
 31528 PUSH BC ; Save BC
 31529 PUSH DE ; Save DE
 31530 PUSH HL ; Save HL
 31531 LD HL,22528 ; HL=22528: an address in the attribute file, used as the end marker
 31534 PUSH HL ; Push a zero marker (the end of the stack of seeds)
 31535 LD BC,0 ; BC=0
 31538 PUSH BC ; Push the marker (HL=22528, DE=0 below it) on the seed stack
 31539 CALL 32066 ; Get the address and mask of the seed point
 31542 LD D,A ; D=the pixel mask of the seed
 31543 LD A,D ; Is this pixel set?
 31544 AND (HL) ; Is the pixel at HL set?
 31545 JR NZ,31555 ; Jump if so: the left edge has been reached
 31547 CALL 31900 ; Otherwise move left
 31550 JR NZ,31543 ; And keep going
 31552 JP 31561 ; The left edge of the screen was reached: start filling
 31555 CALL 32034 ; Plot the edge pixel
 31558 CALL 31887 ; Move right
 31561 LD BC,0 ; Clear the up/down flags
 31564 LD (31523),BC ; Clear both flags (above and below)
 31568 LD A,D ; Reached a full byte boundary?
 31569 CP 128 ; Is the mask the leftmost pixel of a byte?
 31571 JR NZ,31577 ; No: do it pixel by pixel
 31573 LD A,(HL) ; Is the whole byte empty?
 31574 AND A ; Test the byte
 31575 JR Z,31643 ; Jump if so (fill it in one go)
 31577 PUSH HL ; Save the screen address
 31578 CALL 31823 ; Look at the pixel above
 31581 LD A,0 ; A=0: the flag for "above" if nothing is pushed
 31583 JR Z,31601 ; Jump if at the top
 31585 LD A,D ; A=the pixel mask
 31586 AND (HL) ; Is the pixel above set?
 31587 LD A,0 ; A=0: the flag if it is blocked
 31589 JR NZ,31601 ; Jump if it is set
 31591 LD A,(31523) ; Was the pixel above already being filled?
 31594 AND A ; Test the flag
 31595 JR NZ,31604 ; Jump if so
 31597 EX (SP),HL ; Otherwise push it as a new seed
 31598 PUSH DE ; Push the mask
 31599 PUSH HL ; Push the address
 31600 INC A ; A=1: the flag says a seed is now pending above
 31601 LD (31523),A ; Store the flag
 31604 POP HL ; HL=the current address
 31605 PUSH HL ; Keep it on the stack
 31606 CALL 31851 ; Look at the pixel below
 31609 LD A,0 ; A=0: the flag for "below" if nothing is pushed
 31611 JR Z,31630 ; Jump if at the bottom
 31613 LD A,D ; A=the pixel mask
 31614 AND (HL) ; Is the pixel below set?
 31615 LD A,0 ; A=0: the flag if it is blocked
 31617 JR NZ,31630 ; Jump if it is set
 31619 LD A,(31524) ; Was the pixel below already being filled?
 31622 AND A ; Test the flag
 31623 JR NZ,31633 ; Jump if so
 31625 EX (SP),HL ; Otherwise push it as a new seed
 31626 PUSH DE ; Push the mask
 31627 PUSH HL ; Push the address
 31628 LD A,1 ; A=1: a seed is now pending below
 31630 LD (31524),A ; Store the flag
 31633 POP HL ; HL=the current address
 31634 CALL 32034 ; Plot this pixel
 31637 CALL 31887 ; Move right
 31640 JP 31728 ; Move on along the line
 31643 LD BC,0 ; Fill a whole byte at once: check the bytes above and below
 31646 PUSH HL ; Save the screen address
 31647 CALL 31823 ; Look at the byte above
 31650 LD A,(HL) ; A=the byte above
 31651 POP HL ; Restore the address
 31652 JR Z,31662 ; At the top of the screen: it counts as clear
 31654 CP 255 ; Is the byte above full?
 31656 JR Z,31662 ; Yes: treat as blocked
 31658 AND A ; Is it empty?
 31659 JR NZ,31577 ; Neither empty nor full: do it pixel by pixel
 31661 INC C ; C=1: the byte above is empty
 31662 PUSH HL ; Save the address
 31663 CALL 31851 ; Look at the byte below
 31666 LD A,(HL) ; A=the byte below
 31667 POP HL ; Restore the address
 31668 JR Z,31678 ; At the bottom of the picture: it counts as clear
 31670 CP 255 ; Is the byte below full?
 31672 JR Z,31678 ; Yes: treat as blocked
 31674 AND A ; Is it empty?
 31675 JR NZ,31577 ; Neither: do it pixel by pixel
 31677 INC B ; B=1: the byte below is empty
 31678 LD A,(31523) ; A=the flag for above
 31681 AND A ; Test it
 31682 LD A,C ; A=C (above is empty)
 31683 JR NZ,31697 ; A seed is already pending above
 31685 AND A ; Is the byte above empty?
 31686 JR Z,31697 ; No: nothing to push
 31688 LD (31523),A ; Remember that a seed is pending above
 31691 PUSH HL ; Save the address
 31692 CALL 31823 ; Move to the byte above
 31695 EX (SP),HL ; Push it as a new seed
 31696 PUSH DE ; Push the mask
 31697 LD (31523),A ; Store the flag
 31700 LD A,(31524) ; A=the flag for below
 31703 AND A ; Test it
 31704 LD A,B ; A=B (below is empty)
 31705 JR NZ,31719 ; A seed is already pending below
 31707 AND A ; Is the byte below empty?
 31708 JR Z,31719 ; No: nothing to push
 31710 LD (31524),A ; Remember that a seed is pending below
 31713 PUSH HL ; Save the address
 31714 CALL 31851 ; Move to the byte below
 31717 EX (SP),HL ; Push it as a new seed
 31718 PUSH DE ; Push the mask
 31719 LD (HL),255 ; Fill the whole byte
 31721 CALL 32045 ; Set its ink
 31724 INC L ; Next byte
 31725 LD A,L ; Reached the right edge of the screen?
 31726 AND 31 ; Keep the column
 31728 JR Z,31738 ; At the right edge: this run is finished
 31730 LD A,D ; A=the mask
 31731 AND (HL) ; Is the next pixel set?
 31732 JP Z,31568 ; No: carry on filling
 31735 CALL 32034 ; Plot the pixel
 31738 POP DE ; Pick up the next seed
 31739 POP HL ; Pick up the address of the next seed
 31740 LD A,H ; Is it the zero marker?
 31741 CP 88 ; Is it the end marker (high byte 88)?
 31743 JP NZ,31543 ; Fill from it if not
 31746 LD A,0 ; A=0
 31748 LD (31522),A ; Reset the attribute bits to 0
 31751 POP HL ; Restore HL
 31752 POP DE ; Restore DE
 31753 POP BC ; Restore BC
 31754 RET ; Return

; Move up one attribute row (unless at the top)
c31755 PUSH AF ; Save AF
 31756 PUSH DE ; Save DE
 31757 LD DE,32 ; Move up one attribute row
 31760 AND A ; Clear the carry flag
 31761 SBC HL,DE ; Subtract 32 from the address
 31763 LD A,H ; Above the top?
 31764 CP 87 ; Is it 87 (just below the attribute file at 88)?
 31766 JR NZ,31769 ; No: the move is fine
 31768 ADD HL,DE ; Undo the move if so
 31769 POP DE ; Restore DE
 31770 POP AF ; Restore AF
 31771 RET ; Return

; Move down one attribute row (unless at the bottom of the picture area)
c31772 PUSH AF ; Save AF
 31773 PUSH DE ; Save DE
 31774 LD DE,32 ; Move down one attribute row
 31777 ADD HL,DE ; Add 32 to the address
 31778 LD A,H ; Into the status lines (row 22)?
 31779 CP 90 ; Is the high byte 90 (attribute rows 16-23)?
 31781 JR NZ,31793 ; No: the move is fine
 31783 LD A,L ; A=the low byte
 31784 AND 224 ; Keep the row bits
 31786 CP 192 ; Is it row 22 or 23 (the status lines)?
 31788 JR NZ,31793 ; No: the move is fine
 31790 AND A ; Clear the carry flag
 31791 SBC HL,DE ; Undo the move if so
 31793 POP DE ; Restore DE
 31794 POP AF ; Restore AF
 31795 RET ; Return

; Move left one attribute cell
c31796 PUSH AF ; Save AF
 31797 DEC HL ; Move left one cell
 31798 LD A,H ; Before the start of the attribute file?
 31799 CP 87 ; Is it 87 (just below the attribute file)?
 31801 JR NZ,31804 ; No: the move is fine
 31803 INC HL ; Undo the move if so
 31804 POP AF ; Restore AF
 31805 RET ; Return

; Move right one attribute cell
c31806 PUSH AF ; Save AF
 31807 INC HL ; Move right one cell
 31808 LD A,H ; Past the end of the picture area?
 31809 CP 90 ; Is the high byte 90?
 31811 JR NZ,31821 ; No: the move is fine
 31813 LD A,L ; A=the low byte
 31814 AND 224 ; Keep the row bits
 31816 CP 192 ; Row 22 or 23 (the status lines)?
 31818 JR NZ,31821 ; No: the move is fine
 31820 DEC HL ; Undo the move if so
 31821 POP AF ; Restore AF
 31822 RET ; Return

; Move HL up one pixel row
;
; Returns with the zero flag set if the top of the screen has been reached.
c31823 DEC H ; Move up one pixel row
 31824 LD A,H ; A=the high byte
 31825 AND 7 ; Pixel row within the cell
 31827 CP 7 ; Did that cross a character row?
 31829 RET NZ ; Return (zero flag reset) if not
 31830 LD A,L ; A=the low byte
 31831 SUB 32 ; Up one character row
 31833 LD L,A ; L=it
 31834 JR C,31840 ; Borrow: H is already right
 31836 LD A,H ; A=the high byte
 31837 ADD A,8 ; Add 8 to move to the previous third's last row
 31839 LD H,A ; H=it
 31840 LD A,H ; Above the top of the screen?
 31841 CP 63 ; Is it 63 (above the display file)?
 31843 RET NZ ; Return (zero flag reset) if not
 31844 INC H ; Undo the move
 31845 LD A,L ; A=the low byte
 31846 ADD A,32 ; Put the row back
 31848 LD L,A ; L=it
 31849 XOR A ; Set the zero flag
 31850 RET ; Done: Z means the edge was reached

; Move HL down one pixel row
;
; Returns with the zero flag set if the bottom of the picture area (row 160) has been reached.
c31851 INC H ; Move down one pixel row
 31852 LD A,H ; A=the high byte
 31853 AND 7 ; Pixel row within the cell
 31855 RET NZ ; Return (zero flag reset) unless that crossed a character row
 31856 LD A,L ; A=the low byte
 31857 ADD A,32 ; Down one character row
 31859 LD L,A ; L=it
 31860 JR C,31866 ; Carry: H is already right
 31862 LD A,H ; A=the high byte
 31863 SUB 8 ; Take 8 off
 31865 LD H,A ; H=it
 31866 LD A,H ; Reached row 160 (the bottom of the picture area)?
 31867 CP 80 ; Is it 80 (past the third)?
 31869 RET NZ ; Not the bottom: done with NZ
 31870 LD A,L ; A=the low byte
 31871 AND 224 ; Keep the row bits
 31873 CP 192 ; Is it row 6 (the bottom of the picture area)?
 31875 RET NZ ; Return (zero flag reset) if not
 31876 DEC H ; Undo the move
 31877 LD A,L ; A=the low byte
 31878 SUB 32 ; Up one character row
 31880 LD L,A ; L=it
 31881 LD A,H ; A=the high byte
 31882 ADD A,8 ; Add 8 back
 31884 LD H,A ; H=it
 31885 XOR A ; Set the zero flag
 31886 RET ; Done: Z means the edge was reached

; Move the pixel mask D one pixel right
;
; Returns with the zero flag set at the right edge.
c31887 RRC D ; Move the mask right one pixel
 31889 RET NC ; Return unless it wrapped round
 31890 INC L ; Next cell
 31891 LD A,L ; At the right edge?
 31892 AND 31 ; Keep the column
 31894 RET NZ ; Return (zero flag reset) if not
 31895 RLC D ; Undo the move
 31897 DEC L ; Previous cell
 31898 XOR A ; Set the zero flag
 31899 RET ; Done: Z means the edge was reached

; Move the pixel mask D one pixel left
;
; Returns with the zero flag set at the left edge.
c31900 RLC D ; Move the mask left one pixel
 31902 RET NC ; Return unless it wrapped round
 31903 DEC L ; Previous cell
 31904 LD A,L ; Wrapped round the left edge?
 31905 AND 31 ; Keep the column
 31907 CP 31 ; Did it wrap round to column 31?
 31909 RET NZ ; Return (zero flag reset) if not
 31910 RRC D ; Undo the move
 31912 INC L ; Back to the cell on the right
 31913 XOR A ; Set the zero flag
 31914 RET ; Done: Z means the edge was reached

; Unused: a stray jump
;
; Nothing refers to these two bytes. They are the Z80 instruction JR #R31887, sitting just after the RET of the routine at #R31900 where it can never be executed. #R31887 is the routine that moves the pixel mask right one pixel, so this is probably a leftover from an earlier version of the line routines.
b31915 DEFB 24,226 ; JR #R31887: never executed

; Draw a line segment
;
; Draws a line of L pixels from the pen position (D,E). Bit 0 of C chooses a mostly horizontal (0) or mostly vertical (1) line; bit 1 means down rather than up and bit 2 means left rather than right. B is the number of pixels drawn along the main direction before each step in the other direction, so it sets the slope. Each pixel also sets the ink of its attribute. Drawing stops early at the edge of the picture area, and the pen is left at the end of the line.
;
; Input:B Pixels per minor step
; C Direction flags
; D Pen x
; E Pen y
; L Length
; Output:D,E New pen position
c31917 PUSH HL ; Save HL
 31918 LD A,L ; A=the line length...
 31919 EX AF,AF' ; A'=length
 31920 PUSH BC ; Keep the direction and step count (BC)
 31921 CALL 32066 ; Get the screen address and mask of the pen
 31924 LD D,A ; D=mask
 31925 POP BC ; Get the direction and step count back...
 31926 PUSH BC ; ...and keep them for later
 31927 EX AF,AF' ; A=pixel count again
 31928 BIT 0,C ; Mostly vertical?
 31930 JR NZ,31983 ; Jump if so
 31932 EX AF,AF' ; Swap in the pixel count
 31933 CALL 32034 ; Plot the pixel
 31936 BIT 2,C ; Moving left?
 31938 JR Z,31947 ; Jump if not
 31940 CALL 31900 ; Move left
 31943 JR Z,31977 ; Stop at the edge
 31945 JR 31952 ; Now do the vertical step check
 31947 CALL 31887 ; Move right
 31950 JR Z,31977 ; Stop at the edge
 31952 DEC B ; Time for a vertical step?
 31953 JR NZ,31973 ; Jump if not
 31955 BIT 1,C ; Down?
 31957 JR Z,31966 ; Not moving down: go up instead
 31959 CALL 31851 ; Move down
 31962 JR Z,31977 ; Stop at the edge
 31964 JR 31971 ; Skip the up move
 31966 CALL 31823 ; Move up
 31969 JR Z,31977 ; Stop at the edge
 31971 POP BC ; Reset the step counter
 31972 PUSH BC ; Keep the step counter for the next time round
 31973 EX AF,AF' ; Keep the count in A'
 31974 DEC A ; Count the pixels
 31975 JR NZ,31932 ; Repeat for the length of the line
 31977 CALL 32084 ; Work out the new pen position
 31980 POP BC ; Restore the direction and step count...
 31981 POP HL ; ...and the caller's HL
 31982 RET ; Done: the line has been drawn
 31983 EX AF,AF' ; A=pixel count
 31984 CALL 32034 ; Plot the pixel
 31987 BIT 1,C ; Down?
 31989 JR Z,31998 ; Not moving down: go up instead
 31991 CALL 31851 ; Move down
 31994 JR Z,32028 ; Stop at the edge
 31996 JR 32003 ; Skip the up move
 31998 CALL 31823 ; Move up
 32001 JR Z,32028 ; Stop at the edge
 32003 DEC B ; Time for a horizontal step?
 32004 JR NZ,32024 ; Jump if not
 32006 BIT 2,C ; Left?
 32008 JR Z,32017 ; Not moving left: go right instead
 32010 CALL 31900 ; Move left
 32013 JR Z,32028 ; Stop at the edge
 32015 JR 32022 ; Skip the right move
 32017 CALL 31887 ; Move right
 32020 JR Z,32028 ; Stop at the edge
 32022 POP BC ; Reset the step counter
 32023 PUSH BC ; Keep the step counter for the next time round
 32024 EX AF,AF' ; Keep the count in A'
 32025 DEC A ; Count the pixels
 32026 JR NZ,31983 ; Repeat for the length of the line
 32028 CALL 32084 ; Work out the new pen position
 32031 POP BC ; Restore the direction and step count...
 32032 POP HL ; ...and the caller's HL
 32033 RET ; Done: the line has been drawn

; Plot the pixel at HL (mask D) and set its attribute
c32034 PUSH HL ; Save HL
 32035 LD A,D ; A=the pixel mask
 32036 PUSH AF ; Keep it
 32037 CALL 32045 ; Set the ink of the cell
 32040 POP AF ; Get the mask back
 32041 OR (HL) ; Set the pixel
 32042 LD (HL),A ; Store the byte with the pixel set
 32043 POP HL ; Restore HL
 32044 RET ; Done

; Set the ink of the attribute for display file address HL
;
; Uses the ink colour in #R31522.
c32045 PUSH HL ; Save HL
 32046 LD A,H ; Work out the attribute address
 32047 AND 24 ; Keep bits 3-4 of H: the screen third (0-2) times 8
 32049 RRCA ; Move the third number...
 32050 RRCA ; ...down...
 32051 RRCA ; ...to the low bits
 32052 ADD A,88 ; Add the high byte of the attribute file
 32054 LD H,A ; H=attribute address high byte
 32055 LD A,(HL) ; Clear the old ink
 32056 AND 248 ; Clear the three ink bits
 32058 LD (HL),A ; Store the attribute without ink
 32059 LD A,(31522) ; Put in the new one
 32062 OR (HL) ; Add the new ink colour
 32063 LD (HL),A ; Store the updated attribute
 32064 POP HL ; Restore HL
 32065 RET ; Done

; Get the display file address and mask for pixel (D,E)
;
; Uses the ROM routine PIXEL-ADD (entered at 8880, just after its first instructions).
;
; Input:D x
; E y
; Output:HL Address
; A Pixel mask
c32066 PUSH BC ; Save BC
 32067 LD C,D ; C=x
 32068 LD A,175 ; B=175-y (the ROM counts from the bottom)
 32070 SUB E ; A=175-y
 32071 CALL 8880 ; Use the ROM's PIXEL-ADD (skipping its first instructions)
 32074 LD B,A ; A=bit position
 32075 INC B ; B=the bit position plus one
 32076 LD A,1 ; Turn it into a mask
 32078 RRC A ; Rotate the mask right
 32080 DJNZ 32078 ; Repeat for each position
 32082 POP BC ; Restore BC
 32083 RET ; Return

; Convert a display file address and mask back to coordinates
;
; Inverse of #R32066.
c32084 LD A,255 ; Turn the mask back into a bit position
 32086 INC A ; Count the shifts
 32087 RLC D ; Rotate the mask left until the bit falls out
 32089 JR NC,32086 ; Repeat
 32091 LD D,A ; D=the bit position (0-7)
 32092 LD A,L ; x=8*column+bit
 32093 AND 31 ; Keep the column
 32095 RLCA ; Multiply by 8
 32096 RLCA ; ...
 32097 RLCA ; ...
 32098 OR D ; Add the bit position
 32099 LD D,A ; D=x
 32100 LD A,H ; y=row within the character...
 32101 AND 7 ; Keep the pixel row within the cell
 32103 LD E,A ; E=it
 32104 LD A,L ; ...plus 8*character row...
 32105 AND 224 ; Keep the character row bits
 32107 RRCA ; Move them to bits 3-5
 32108 RRCA ; ...
 32109 OR E ; Add the pixel row
 32110 LD E,A ; E=it
 32111 LD A,H ; ...plus 64*third
 32112 AND 24 ; Keep the third bits
 32114 RLCA ; Move them to bits 6-7
 32115 RLCA ; ...
 32116 RLCA ; ...
 32117 OR E ; Add the lower bits
 32118 LD E,A ; E=y counted from the top
 32119 LD A,175 ; Convert to the ROM's coordinates
 32121 SUB E ; Subtract from 175
 32122 LD E,A ; E=y counted from the bottom
 32123 RET ; Return

; The end of the point list
b32124 DEFB 0,0

; Draw a compressed picture
;
; The larger full-screen pictures (the Partridge Club and the street outside Milton's) use a second, more compact format: a 9-byte header (the offset of the end of the point bit-stream, the bit position where it ends, the offset of the attribute data and four bit widths for the coordinate deltas), a bit-stream of points in which each coordinate is stored as a variable-width delta read by #R32539, line segments drawn between the points (#R32612), and finally three run-length encoded passes over the attribute file (ink, then paper, then bright and flash).
;
; Input:HL Picture data
@label=DRAWCPIC
c32126 PUSH HL ; Save HL
 32127 POP IY ; IY=picture header
 32129 CALL 31218 ; Clear the screen
 32132 LD DE,9 ; The bit-stream starts after the 9-byte header
 32135 ADD HL,DE ; HL=the start of the bit-stream
 32136 LD (32536),HL ; Set the bit-stream pointer
 32139 XOR A ; Start at bit 0
 32140 LD (32538),A ; Store bit position 0
 32143 LD BC,0 ; Start at (0,0)
 32146 CALL 32294 ; Draw the strokes...
 32149 JR NZ,32146 ; ...until the end of the point list
 32151 LD L,(IY+3) ; HL=the offset of the attribute data (header bytes 3-4)
 32154 LD H,(IY+4) ; H=the high byte of the offset
 32157 PUSH IY ; Copy IY into DE...
 32159 POP DE ; ...by way of the stack
 32160 ADD HL,DE ; Add the address of the header
 32161 LD (32124),HL ; Remember it: it also marks the end of the list of fill seeds
 32164 LD L,(IY+0) ; HL=the offset of the end of the point bit-stream (header bytes 0-1)
 32167 LD H,(IY+1) ; H=the high byte of the offset
 32170 ADD HL,DE ; HL=the address just after the bit-stream
 32171 LD A,(IY+2) ; Does the bit-stream end part-way through a byte (header byte 2)?
 32174 AND A ; Test the byte
 32175 JR Z,32178 ; Zero: no padding byte
 32177 INC HL ; Yes: skip that last byte
 32178 PUSH HL ; Save the address
 32179 POP IY ; IY=the list of fill seed points
 32181 LD D,(IY+1) ; D=x
 32184 LD A,175 ; E=175-y
 32186 SUB (IY+0) ; A=175-y
 32189 LD E,A ; E=y counted from the top
 32190 INC IY ; Next byte
 32192 INC IY ; Next seed point
 32194 LD A,56 ; Fill with ink 0 on paper 7
 32196 CALL 31525 ; Fill the area around the seed
 32199 PUSH IY ; Reached the end of the seed points?
 32201 POP HL ; HL=the position in the list
 32202 LD DE,(32124) ; DE=the end of the list
 32206 AND A ; Clear the carry flag
 32207 SBC HL,DE ; Compare
 32209 JR NZ,32181 ; Jump back if not
 32211 LD DE,(32124) ; DE=run-length attribute data
 32215 LD HL,22528 ; First pass over the attribute file: the ink colours
 32218 LD A,H ; Reached the end of the attribute file?
 32219 CP 91 ; Is the high byte 91 (the end of the attribute file)?
 32221 JR Z,32241 ; Jump if so
 32223 LD A,(DE) ; Bits 0-4: run length-1
 32224 AND 31 ; Keep the run length bits
 32226 LD B,A ; B=the run length minus one
 32227 INC B ; B=the run length
 32228 LD A,(DE) ; Bits 5-7: the ink colour
 32229 INC DE ; Next byte of attribute data
 32230 AND 224 ; Keep the colour bits
 32232 RLCA ; Rotate bits 5-7 round to bits 0-2...
 32233 RLCA ; ...
 32234 RLCA ; ...
 32235 LD (HL),A ; Set the ink for the run
 32236 INC HL ; Next cell
 32237 DJNZ 32235 ; Repeat for every cell in the run
 32239 JR 32218 ; Next run
 32241 LD HL,22528 ; Second pass: the paper colours
 32244 LD A,H ; Reached the end of the attribute file?
 32245 CP 91 ; Is the high byte 91?
 32247 JR Z,32269 ; Jump if so
 32249 LD A,(DE) ; Bits 0-4: run length-1
 32250 AND 31 ; Keep the run length bits
 32252 LD B,A ; B=the run length minus one
 32253 INC B ; B=the run length
 32254 LD A,(DE) ; Bits 5-7: the paper colour
 32255 INC DE ; Next byte of attribute data
 32256 AND 224 ; Keep the colour bits
 32258 RRCA ; Move bits 5-7 down to bits 3-5...
 32259 RRCA ; ...
 32260 LD C,A ; C=the paper colour
 32261 LD A,C ; Add the paper to each cell in the run
 32262 OR (HL) ; Merge it with the ink already there
 32263 LD (HL),A ; Store it
 32264 INC HL ; Next cell
 32265 DJNZ 32261 ; Repeat for every cell in the run
 32267 JR 32244 ; Next run
 32269 LD HL,22528 ; Third pass: bright and flash
 32272 LD A,H ; Reached the end of the attribute file?
 32273 CP 91 ; Is the high byte 91?
 32275 RET Z ; Return if so
 32276 LD A,(DE) ; Bits 0-5: run length-1
 32277 AND 63 ; Keep the run length bits
 32279 LD B,A ; B=the run length minus one
 32280 INC B ; B=the run length
 32281 LD A,(DE) ; Bits 6-7: bright and flash
 32282 INC DE ; Next byte of attribute data
 32283 AND 192 ; Keep the bright and flash bits
 32285 LD C,A ; C=the bits
 32286 LD A,C ; Add them to each cell in the run
 32287 OR (HL) ; Merge them with the colours already there
 32288 LD (HL),A ; Store them
 32289 INC HL ; Next cell
 32290 DJNZ 32286 ; Repeat for every cell in the run
 32292 JR 32272 ; Next run

; Draw the next stroke of a compressed picture
;
; Returns with the zero flag set at the end of the point list.
c32294 LD HL,(32536) ; Reached the end of the point list?
 32297 PUSH IY ; Copy IY into DE...
 32299 POP DE ; ...by way of the stack
 32300 AND A ; Clear the carry flag
 32301 SBC HL,DE ; HL=the stream pointer's offset from the header
 32303 LD E,(IY+0) ; E=the low byte of the offset of the end
 32306 LD D,(IY+1) ; D=the high byte
 32309 AND A ; Clear the carry flag
 32310 SBC HL,DE ; Compare: is this the end byte?
 32312 JR NZ,32321 ; Jump if not
 32314 LD A,(32538) ; Check the bit position too
 32317 CP (IY+2) ; Is it the end bit position too?
 32320 RET Z ; Return with the zero flag set at the end
 32321 LD D,1 ; Read one bit: 1 = start a new stroke, 0 = continue the current one
 32323 CALL 32539 ; Read the bit
 32326 AND A ; Test the bit
 32327 JR Z,32340 ; Jump to continue the stroke
 32329 CALL 32365 ; Read the starting point
 32332 CALL 32596 ; Plot it
 32335 OR (HL) ; Merge the pixel with the screen byte
 32336 LD (HL),A ; Store it
 32337 OR 1 ; Reset the zero flag: more to come
 32339 RET ; Return
 32340 LD (32610),BC ; Remember the start of the line
 32344 CALL 32596 ; Get its screen address
 32347 LD D,A ; D=the pixel mask
 32348 EXX ; Switch to the alternate registers
 32349 LD BC,(32610) ; BC'=the line start
 32353 CALL 32365 ; Read the next point
 32356 PUSH BC ; Save the end point
 32357 CALL 32612 ; Draw a line to it
 32360 EXX ; Switch back
 32361 POP BC ; BC=the end point
 32362 OR 1 ; Reset the zero flag: more to come
 32364 RET ; Return

; Read the next point (x in C, y in B)
c32365 LD D,1 ; Read one bit: absolute or relative coordinates?
 32367 CALL 32539 ; Read it
 32370 AND A ; Test it
 32371 JR Z,32382 ; Zero: only one coordinate is given
 32373 CALL 32400 ; Read x
 32376 LD C,A ; C=x
 32377 CALL 32434 ; Read y
 32380 LD B,A ; B=y
 32381 RET ; Return
 32382 LD D,1 ; Read one bit: short or long deltas?
 32384 CALL 32539 ; Read it
 32387 AND A ; Test it
 32388 JR NZ,32395 ; One: it is a y delta
 32390 CALL 32468 ; Read a long x delta
 32393 LD C,A ; C=the new x
 32394 RET ; Return
 32395 CALL 32502 ; Read a long y delta
 32398 LD B,A ; B=the new y
 32399 RET ; Return

; Read an x coordinate (absolute or delta)
c32400 LD D,1 ; D=1: read one bit
 32402 CALL 32539 ; Read it
 32405 AND A ; Test it
 32406 JR Z,32413 ; Zero: a short delta follows
 32408 LD D,8 ; D=8: an absolute coordinate has eight bits
 32410 JP 32539 ; Read it and return
 32413 LD A,(IY+5) ; A=the number of bits in a short x delta (from the picture header)
 32416 LD D,A ; D=the number of bits
 32417 CALL 32539 ; Read the delta (left-aligned in A)
 32420 LD D,A ; D=the delta
 32421 LD A,(IY+5) ; A=the number of bits
 32424 SRA D ; Shift right, keeping the sign...
 32426 INC A ; ...until the delta is right-aligned
 32427 CP 8 ; ...(8 minus the number of bits times)
 32429 JR NZ,32424 ; Repeat
 32431 LD A,D ; A=the signed delta
 32432 ADD A,C ; Add the old x (C)
 32433 RET ; Add it to the old x

; Read a y coordinate (absolute or delta)
c32434 LD D,1 ; Return
 32436 CALL 32539 ; Read it
 32439 AND A ; Test it
 32440 JR Z,32447 ; Zero: a short delta follows
 32442 LD D,8 ; D=8: an absolute coordinate has eight bits
 32444 JP 32539 ; Read it and return
 32447 LD A,(IY+6) ; A=the number of bits in a short y delta (from the picture header)
 32450 LD D,A ; D=the number of bits
 32451 CALL 32539 ; Read the delta (left-aligned in A)
 32454 LD D,A ; D=the delta
 32455 LD A,(IY+6) ; A=the number of bits
 32458 SRA D ; Shift right, keeping the sign...
 32460 INC A ; ...until the delta is right-aligned
 32461 CP 8 ; ...(8 minus the number of bits times)
 32463 JR NZ,32458 ; Repeat
 32465 LD A,D ; A=the signed delta
 32466 ADD A,B ; Add it to the old y
 32467 RET ; Return

; Read a long x delta
c32468 LD D,1 ; D=1: read one bit
 32470 CALL 32539 ; Read it
 32473 AND A ; Test it
 32474 JR Z,32481 ; Zero: a long delta follows
 32476 LD D,8 ; D=8: an absolute coordinate has eight bits
 32478 JP 32539 ; Read it and return
 32481 LD A,(IY+7) ; A=the number of bits in a long x delta (from the picture header)
 32484 LD D,A ; D=the number of bits
 32485 CALL 32539 ; Read the delta (left-aligned in A)
 32488 LD D,A ; D=the delta
 32489 LD A,(IY+7) ; A=the number of bits
 32492 SRA D ; Shift right, keeping the sign...
 32494 INC A ; ...until the delta is right-aligned
 32495 CP 8 ; ...(8 minus the number of bits times)
 32497 JR NZ,32492 ; Repeat
 32499 LD A,D ; A=the signed delta
 32500 ADD A,C ; Add it to the old x
 32501 RET ; Return

; Read a long y delta
c32502 LD D,1 ; D=1: read one bit
 32504 CALL 32539 ; Read it
 32507 AND A ; Test it
 32508 JR Z,32515 ; Zero: a long delta follows
 32510 LD D,8 ; D=8: an absolute coordinate has eight bits
 32512 JP 32539 ; Read it and return
 32515 LD A,(IY+8) ; A=the number of bits in a long y delta (from the picture header)
 32518 LD D,A ; D=the number of bits
 32519 CALL 32539 ; Read the delta (left-aligned in A)
 32522 LD D,A ; D=the delta
 32523 LD A,(IY+8) ; A=the number of bits
 32526 SRA D ; Shift right, keeping the sign...
 32528 INC A ; ...until the delta is right-aligned
 32529 CP 8 ; ...(8 minus the number of bits times)
 32531 JR NZ,32526 ; Repeat
 32533 LD A,D ; A=the signed delta
 32534 ADD A,B ; Add it to the old y
 32535 RET ; Return

; The bit-stream pointer
b32536 DEFB 0,0,0

; Read D bits from the picture bit-stream
;
; The bits come back left-aligned: the value is in the top D bits of A and the callers shift it down.
;
; Input:D Number of bits
; Output:A The bits, left-aligned
c32539 PUSH HL ; Save HL
 32540 PUSH DE ; Save DE
 32541 LD HL,(32536) ; Pick up the next two bytes of the bit-stream
 32544 LD D,(HL) ; D=the first byte of the stream
 32545 INC HL ; Next byte
 32546 LD E,(HL) ; E=the second byte
 32547 EX DE,HL ; HL=the two bytes
 32548 LD A,(32538) ; Shift them left by the bit position
 32551 INC A ; Test the bit position...
 32552 DEC A ; ...
 32553 JR Z,32558 ; Zero: the shift is done
 32555 ADD HL,HL ; Shift the pair left
 32556 JR 32552 ; Shift the pair left one more bit
 32558 POP DE ; D=number of bits wanted
 32559 LD A,D ; A=the number of bits
 32560 LD L,0 ; Build a mask of D bits
 32562 SCF ; Set the carry
 32563 RR L ; Shift a one into the mask
 32565 DEC A ; Count down
 32566 JR NZ,32562 ; Repeat until the mask has D bits
 32568 LD A,L ; A=the mask
 32569 AND H ; Extract the bits
 32570 PUSH AF ; Save the value
 32571 LD A,(32538) ; Advance the bit position by D
 32574 ADD A,D ; Add the number of bits to the bit position
 32575 LD HL,(32536) ; HL=the stream pointer
 32578 CP 8 ; Past the end of the byte?
 32580 JR C,32587 ; Less than 8: the position is right
 32582 SUB 8 ; Take off 8
 32584 INC HL ; Moving on a byte for each 8 bits
 32585 JR 32578 ; Subtract 8 again
 32587 LD (32538),A ; Store the new bit position
 32590 LD (32536),HL ; Store the new pointer
 32593 POP AF ; Restore the value
 32594 POP HL ; Restore HL
 32595 RET ; Return with the bits left-aligned in A (the callers shift them down)

; Get the pixel address for (C,B)
;
; Uses ROM PIXEL-ADD.
c32596 PUSH BC ; Save BC
 32597 LD A,B ; B=y
 32598 CALL 8880 ; Use the ROM's PIXEL-ADD
 32601 INC A ; B=the bit position plus one
 32602 LD B,A ; ...
 32603 LD A,1 ; Turn the bit position into a mask
 32605 RRCA ; Rotate the mask right
 32606 DJNZ 32605 ; Rotate the mask once for each bit position
 32608 POP BC ; Restore BC
 32609 RET ; Return

; The line start point
b32610 DEFB 0,0

; Draw a line from the last point to (C,B)
;
; A Bresenham line drawer.
c32612 LD L,C ; L=the target x
 32613 LD H,0 ; H=0
 32615 LD A,(32610) ; A=the start x (#R32610)
 32618 LD E,A ; E=it
 32619 LD D,H ; D=0
 32620 AND A ; Clear the carry flag
 32621 SBC HL,DE ; HL=target x minus start x: the signed x distance
 32623 LD A,L ; A=the low byte of the distance
 32624 LD DE,257 ; D=1, E=1: the y step and the x step both start as +1
 32627 BIT 7,H ; Is the x distance negative?
 32629 JR Z,32635 ; No
 32631 NEG ; A=its size
 32633 LD E,255 ; E=255: the x step is -1
 32635 LD C,A ; C=the size of the x distance
 32636 PUSH DE ; Save the steps
 32637 LD L,B ; L=the target y
 32638 LD H,0 ; H=0
 32640 LD A,(32611) ; A=the start y (32611)
 32643 LD E,A ; E=it
 32644 LD D,H ; D=0
 32645 AND A ; Clear the carry flag
 32646 SBC HL,DE ; HL=target y minus start y: the signed y distance
 32648 POP DE ; Get the steps back
 32649 LD A,L ; A=the low byte of the distance
 32650 BIT 7,H ; Is the y distance negative?
 32652 JR Z,32658 ; No
 32654 NEG ; A=its size
 32656 LD D,255 ; D=255: the y step is -1
 32658 LD B,A ; B=the size of the y distance
 32659 LD A,C ; A=the size of the x distance
 32660 CP B ; Compare it with the y distance
 32661 JR NC,32673 ; x is the longer: that is the main direction
 32663 LD L,C ; y is the longer: L=the x distance (the shorter)
 32664 LD (32694),DE ; Store the steps in the operand of the LD BC,0 at #R32693 (self-modifying)
 32668 XOR A ; A=0
 32669 LD E,A ; E=0: no x step on the main direction
 32670 JP 32681 ; Carry on
 32673 LD L,B ; L=the y distance (the shorter)
 32674 LD B,C ; B=the x distance (the number of pixels to draw)
 32675 LD (32694),DE ; Store the steps in the operand of the LD BC,0 at #R32693 (self-modifying)
 32679 LD D,0 ; D=0: no y step on the main direction
 32681 LD H,B ; H=the length of the main direction
 32682 LD A,B ; A=it
 32683 RRA ; Halve it: the error term starts half-way
 32684 ADD A,L ; Add the shorter distance to the error term
 32685 JR C,32690 ; It overflowed a byte: step sideways
 32687 CP H ; Compare with the longer distance
 32688 JR C,32699 ; Smaller: no sideways step this time
 32690 SUB H ; Take off the longer distance
 32691 LD C,A ; C=the new error term
 32692 EXX ; Switch to the alternate registers
 32693 LD BC,0 ; BC=the step for both directions (set above)
 32696 JP 32703 ; Carry on
 32699 LD C,A ; C=the error term
 32700 PUSH DE ; Save the main-direction step
 32701 EXX ; Switch to the alternate registers
 32702 POP BC ; BC=the main-direction step only
 32703 LD A,B ; A=the vertical step
 32704 AND A ; Test it
 32705 JR Z,32728 ; None: skip the vertical move
 32707 BIT 7,A ; Is it negative?
 32709 JR Z,32722 ; No: move down
 32711 DEC H ; Up one pixel row
 32712 LD A,H ; A=the high byte of the screen address
 32713 AND 7 ; Pixel row within the character cell
 32715 CP 7 ; Did the row wrap round to 7 (crossed a character boundary)?
 32717 JR Z,32772 ; Yes: adjust the address
 32719 JP 32728 ; No
 32722 INC H ; Down one pixel row
 32723 LD A,H ; A=the high byte
 32724 AND 7 ; Pixel row within the character cell
 32726 JR Z,32759 ; Crossed into the next character row: adjust
 32728 LD A,C ; A=the horizontal step
 32729 AND A ; Test it
 32730 JR Z,32751 ; None: plot the pixel
 32732 BIT 7,A ; Is it negative?
 32734 JR NZ,32745 ; Yes: move left
 32736 RRC D ; Rotate the pixel mask right
 32738 JP NC,32751 ; Still in the same byte
 32741 INC L ; Next byte
 32742 JP 32751 ; Plot the pixel
 32745 RLC D ; Rotate the pixel mask left
 32747 JP NC,32751 ; Still in the same byte
 32750 DEC L ; Previous byte
 32751 LD A,D ; A=the pixel mask
 32752 OR (HL) ; Combine it with the screen byte
 32753 LD (HL),A ; Plot the pixel
 32754 EXX ; Switch back to the main registers
 32755 LD A,C ; A=the error term
 32756 DJNZ 32684 ; Loop for every pixel of the line
 32758 RET ; Return
 32759 LD A,L ; A=the low byte
 32760 ADD A,32 ; Down one character row
 32762 LD L,A ; L=it
 32763 JR C,32728 ; Carry: this was the last row of the third, so H is already right
 32765 LD A,H ; A=the high byte
 32766 SUB 8 ; Take back the 8
 32768 LD H,A ; H=it
 32769 JP 32728 ; Carry on
 32772 LD A,L ; A=the low byte
 32773 SUB 32 ; Up one character row
 32775 LD L,A ; L=it
 32776 JR C,32728 ; Carry: the borrow means H is already right
 32778 LD A,H ; A=the high byte
 32779 ADD A,8 ; Move up 8 in the high byte
 32781 LD H,A ; H=it
 32782 JP 32728 ; Carry on

; Play the theme tune (if A=16)
;
; Plays the list of tune fragments at #R32832 via #R32866. The stack pointer is temporarily moved to 53792.
;
; Input:A SAY flags bits 4-6
@label=TUNE
c32785 LD (32801),SP ; Save the stack pointer
 32789 LD SP,53792 ; Use a stack up at 53792
 32792 CP 16 ; Is the tune wanted?
 32794 JR Z,32803 ; Play it if so
 32796 LD SP,(32801) ; Restore the stack pointer
 32800 RET ; Done

; The saved stack pointer
b32801 DEFB 0,0

; Play the tune fragments listed at #R32832
c32803 PUSH IX ; Save IX
 32805 LD IX,32832 ; Point IX at the list of tune fragments
 32809 LD L,(IX+0) ; Pick up the next fragment address
 32812 LD H,(IX+1) ; H=the high byte of the fragment address
 32815 LD A,L ; End of the list?
 32816 OR H ; Combine with L: a zero address ends the list
 32817 JR Z,32828 ; Finish if so
 32819 CALL 32866 ; Play the fragment
 32822 INC IX ; Next fragment...
 32824 INC IX ; ...(2 bytes per entry)
 32826 JR 32809 ; Next fragment
 32828 POP IX ; Restore IX
 32830 JR 32796 ; Restore the stack and return

; Theme tune: list of fragments
;
; Addresses of the note lists played by #R32803 (terminated by 0).
w32832 DEFW 33051,33148,33173,33202
 32840 DEFW 33051,33271,33308,33271
 32848 DEFW 33345,33051,33173,33173
 32856 DEFW 33202,33386,33386,33447
 32864 DEFW 0

; Play a tune fragment
;
; Each note is four bytes: pitch, duration (2 bytes) and a flags byte. Stops early if a key is pressed.
;
; Input:HL Note data
c32866 XOR A ; Stop if a key is pressed
 32867 IN A,(254) ; Read the keyboard
 32869 AND 31 ; Keep the key bits
 32871 CP 31 ; No key pressed?
 32873 JR NZ,32976 ; A key is pressed: stop the tune
 32875 LD D,(HL) ; D=pitch
 32876 XOR A ; A pitch of 0 ends the fragment
 32877 CP D ; Is the pitch zero?
 32878 JP Z,32976 ; A pitch of zero: the fragment is over
 32881 INC HL ; Next byte (the duration)
 32882 LD E,(HL) ; E=duration
 32883 INC HL ; Next byte (the flags)
 32884 LD C,(HL) ; C=flags
 32885 INC HL ; Next byte (the repeat count)
 32886 LD B,(HL) ; B=repeat count
 32887 INC HL ; Next byte (the next note)
 32888 LD A,24 ; Default border/speaker value
 32890 LD (33000),A ; Modify the OUT value at 33000
 32893 LD A,C ; Bits 4-7 of the flags...
 32894 RRCA ; Shift bits 4-7 down...
 32895 RRCA ; ...
 32896 RRCA ; ...
 32897 RRCA ; ...
 32898 AND 15 ; Keep them
 32900 JR NZ,32906 ; Non-zero: use it as the delay
 32902 LD (33000),A ; ...override it if non-zero
 32905 INC A ; A=1: the default delay
 32906 LD (32930),A ; Modify the delay at 32930
 32909 LD A,C ; C=pitch slide (bits 0-3)
 32910 AND 15 ; Keep the slide bits
 32912 LD C,A ; C=the slide
 32913 PUSH DE ; Save DE
 32914 JP 32928 ; Start the note
 32917 PUSH BC ; Save BC
 32918 LD B,5 ; Short pause between repeats
 32920 DJNZ 32920 ; Pause
 32922 JP 32925 ; Pad the timing
 32925 NOP ; Pad the timing
 32926 NOP ; Pad the timing
 32927 POP BC ; Restore BC
 32928 PUSH BC ; Save BC
 32929 LD B,4 ; Delay (modified above)
 32931 NOP ; Pad the timing
 32932 NOP ; Pad the timing
 32933 NOP ; Pad the timing
 32934 CALL 32982 ; Play the note
 32937 LD A,0 ; Pad the timing
 32939 DJNZ 32934 ; Play the note again for each repeat
 32941 POP BC ; Restore BC
 32942 LD A,C ; Slide the pitch
 32943 ADD A,D ; Add the slide to the pitch
 32944 LD D,A ; D=the new pitch
 32945 PUSH AF ; Save the carry flag
 32946 BIT 7,C ; Up or down?
 32948 JP Z,32958 ; Pitch slide is upward: go on
 32951 POP AF ; Restore the carry flag
 32952 JP NC,32977 ; Stop if the pitch wrapped round
 32955 JP 32965 ; Continue
 32958 POP AF ; Restore the carry flag
 32959 JP C,32977 ; Stop if the pitch wrapped round
 32962 JP 32965 ; Continue
 32965 LD A,E ; Shorten the duration
 32966 SUB C ; Take the slide off the duration
 32967 LD E,A ; E=the new duration
 32968 LD A,R ; A=refresh register (adds a little noise)
 32970 DJNZ 32917 ; Repeat
 32972 POP DE ; Restore DE
 32973 JP 32866 ; Next note
 32976 RET ; Return
 32977 POP DE ; Restore DE
 32978 PUSH DE ; Save DE
 32979 JP 32970 ; Finish this note

; Delay and toggle the speaker
c32982 PUSH BC ; Save BC
 32983 LD B,(IY+0) ; (Never used: B is overwritten by the next instruction)
 32986 LD B,12 ; B=12: the fixed delay
 32988 DJNZ 32988 ; Wait about 12 loops
 32990 POP BC ; Restore BC
 32991 CALL 32995 ; Toggle the speaker
 32994 RET ; Done

; Toggle the speaker with a pulse
c32995 BIT 7,D ; Test bit 7 of the pitch
 32997 LD A,0 ; A=0: speaker off
 32999 LD A,16 ; A=speaker bit (this operand is modified by #R32890)
 33001 JP 33004 ; Pad the timing
 33004 JP 33007 ; Pad the timing
 33007 OUT (254),A ; Speaker on
 33009 PUSH DE ; Save DE
 33010 AND 127 ; Mask the pitch (A is overwritten below, so this has no effect)
 33012 LD A,D ; A=the pitch
 33013 LD D,A ; D=pitch
 33014 DEC D ; Delay for half a cycle
 33015 CALL 33032 ; Wait a half cycle
 33018 JR NZ,33014 ; Repeat until the half cycle is over
 33020 LD A,0 ; A=0: speaker bit off
 33022 OUT (254),A ; Speaker off
 33024 DEC E ; Delay for the other half
 33025 CALL 33032 ; Wait a half cycle
 33028 JR NZ,33024 ; Repeat until the half cycle is over
 33030 POP DE ; Restore DE
 33031 RET ; Return

; Short delay
c33032 PUSH BC ; Save BC
 33033 NOP ; Timing padding
 33034 NOP ; Waste 4 T-states
 33035 NOP ; Waste 4 T-states
 33036 NOP ; Waste 4 T-states
 33037 POP BC ; Restore BC
 33038 PUSH BC ; Save BC
 33039 NOP ; Waste 4 T-states
 33040 NOP ; Waste 4 T-states
 33041 NOP ; Waste 4 T-states
 33042 NOP ; Waste 4 T-states
 33043 POP BC ; Restore BC
 33044 PUSH BC ; Save BC
 33045 NOP ; Waste 4 T-states
 33046 NOP ; Waste 4 T-states
 33047 NOP ; Waste 4 T-states
 33048 NOP ; Waste 4 T-states
 33049 POP BC ; Restore BC
 33050 RET ; Return

; Theme tune: note data
;
; Used by #R32866.
b33051 DEFB 13,14,16,131,115,115,0,16
 33059 DEFB 13,14,16,196,13,14,16,131
 33067 DEFB 115,115,0,16,12,13,16,139
 33075 DEFB 115,115,0,16,12,13,16,208
 33083 DEFB 12,13,16,139,115,115,0,16
 33091 DEFB 12,12,16,147,115,115,0,16
 33099 DEFB 12,12,16,110,115,115,0,12
 33107 DEFB 12,13,16,69,12,12,16,73
 33115 DEFB 115,115,0,16,7,8,16,165
 33123 DEFB 7,8,16,165,115,115,0,16
 33131 DEFB 12,12,16,110,12,12,16,110
 33139 DEFB 12,12,16,110,115,115,0,16
 33147 DEFB 0,12,12,16,220,115,115,0
 33155 DEFB 12,7,8,16,165,7,8,16
 33163 DEFB 165,7,8,16,110,115,115,0
 33171 DEFB 16,0,12,12,16,220,115,115
 33179 DEFB 0,12,7,8,16,165,115,115
 33187 DEFB 0,12,8,8,16,104,7,8
 33195 DEFB 16,110,115,115,0,12,0,12
 33203 DEFB 12,16,110,115,115,0,12,12
 33211 DEFB 12,16,110,115,115,0,12,10
