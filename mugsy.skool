; Delay for BC units, B times
c41997 PUSH BC ; Save the repeat count
 41998 CALL 42026 ; Play the shootout sound effect
 42001 LD BC,(41993) ; BC=the delay length
 42005 DEC BC ; Count the delay down
 42006 LD A,B ; Test BC...
 42007 OR C ; ...for zero
 42008 JR NZ,42005 ; Loop until it is zero
 42010 POP BC ; Restore the repeat count
 42011 DJNZ 41997 ; Repeat B times
 42013 RET ; Return

; Short delay (length at 41995)
c42014 PUSH BC ; Save BC
 42015 LD BC,(41995) ; BC=the short delay length
 42019 DEC BC ; Count down
 42020 LD A,B ; Test BC...
 42021 OR C ; ...for zero
 42022 JR NZ,42019 ; Loop until it is zero
 42024 POP BC ; Restore BC
 42025 RET ; Return

; Play the shootout sound effect
;
; Plays the bit pattern at #R42057 through the speaker.
c42026 LD HL,42057 ; HL=the sound data
 42029 LD DE,40 ; DE=40: the number of bytes
 42032 LD C,(HL) ; C=the next byte of the pattern
 42033 LD B,8 ; B=8 bits
 42035 LD A,0 ; A=0: the speaker and border low
 42037 RLC C ; Rotate the next bit out
 42039 JR NC,42043 ; Zero: leave the speaker low
 42041 LD A,24 ; A=24: speaker on (bit 4) and MIC (bit 3)
 42043 OUT (254),A ; Output it
 42045 CALL 42014 ; Wait a short time
 42048 DJNZ 42035 ; Next bit
 42050 INC HL ; Next byte
 42051 DEC DE ; One fewer left
 42052 LD A,D ; Test DE...
 42053 OR E ; ...for zero
 42054 JR NZ,42032 ; Loop until all are played
 42056 RET ; Return

; Shootout: sound effect data
;
; Played by #R42026.
b42057 DEFB 12,225,227,28,57,206,65,188
 42065 DEFB 195,206,71,28,248,102,114,75
 42073 DEFB 184,247,56,179,199,153,156,227
 42081 DEFB 49,238,38,39,138,49,195,230
 42089 DEFB 98,199,29,27,28,230,60,124
 42097 DEFB 0,0,0,0,0,0,0,0
 42105 DEFB 0,0,0,0,0,0,0

; Shootout with the hit man from Detroit
;
; An arcade sequence. Mugsy (controlled with Q/Z up/down, I/P left/right and B/N/M to fire) must shoot the hit man in a restaurant before the hit man shoots him. Installs its own IM2 interrupt routine (#R48539), sets Mugsy's hit points to (A AND 7)+1 (42301; the hit man always has 4, at 42302), runs the game and restores IM1 on exit.
;
; Input:A Value from the handout: Mugsy gets (A AND 7)+1 hit points (8 if A is 255)
; Output:A Result: bit 0 set if Mugsy was killed; bits 2-3 set if bystanders were hit
@label=SHOOTOUT
c42112 DI ; Interrupts off while the IM2 handler is installed
 42113 PUSH AF ; Save the strength value passed in A (it is needed again below)
 42114 LD HL,48539 ; HL=address of the shootout's interrupt routine
 42117 LD (53457),HL ; Patch it into the JP at 53457 that the IM2 vector table (#R53504) leads to
 42120 LD A,209 ; A=209: the high byte of the vector table address, which is filled with 208
 42122 LD I,A ; Set the interrupt vector register: IM 2 interrupts now vector through #R53504
 42124 IM 2 ; Select interrupt mode 2
 42126 LD A,0 ; A=0: black border, speaker off
 42128 OUT (254),A ; Set the border colour and speaker
 42130 POP AF ; Get the strength value back
 42131 AND 7 ; Keep the low 3 bits (0-7)
 42133 INC A ; Add 1 to make 1-8
 42134 LD (42301),A ; Store it as Mugsy's hit points (the hit man's bullets take one off each time they hit him)
 42137 CALL 42639 ; Draw the restaurant and put the figures in place
 42140 CALL 42977 ; Main loop: let any figure whose timer says it is ready decide what to do next
 42143 CALL 44766 ; Deal with Mugsy's and the hit man's bullets landing
 42146 CALL 44884 ; Deal with anyone who has been hit
 42149 LD A,(42335) ; A=the "shootout over" flag (set when Mugsy or the hit man has fallen over)
 42152 AND A ; Test it
 42153 JR Z,42140 ; Keep going until it is set
 42155 LD BC,65535 ; BC=65535: a pause of about a second and a half so the player can see the result
 42158 DEC BC ; Count BC down
 42159 LD A,B ; A=B
 42160 OR C ; Combine with C to test for zero
 42161 JR NZ,42158 ; Loop until BC is zero
 42163 LD A,63 ; A=63: the high byte of the ROM's interrupt table address
 42165 LD I,A ; Put the interrupt vector register back as the ROM expects it
 42167 IM 1 ; Back to interrupt mode 1
 42169 LD A,(42334) ; A=the result bits (bit 0 Mugsy killed, bit 1 hit man killed, bit 2 bystander 1 hit, bit 3 bystander 2 hit)
 42172 DI ; Leave with interrupts disabled (the caller restores the ROM's FLAGS)
 42173 RET ; Return to the VM's native-call routine

; Shootout: animation frame tables
;
; Four bytes per frame: a direction mask, the graphic height in pixel rows, and the address of the graphic. Mugsy, the hit man and the bystanders each use a table (#R42174, 42194, #R42206, #R42222 ...).
b42174 DEFB 4,32,170,186,4,32,234,186
 42182 DEFB 4,32,42,187,4,32,106,187
 42190 DEFB 4,32,170,187,4,32,234,185
 42198 DEFB 4,32,42,186,4,32,106,186
 42206 DEFB 4,32,234,183,4,32,42,184
 42214 DEFB 4,32,106,184,4,32,170,184
 42222 DEFB 4,32,234,184,4,32,42,185
 42230 DEFB 4,32,106,185,4,32,170,185

; Shootout: figure handlers
;
; One handler per figure slot, called by #R42977.
w42238 DEFW 43018,43246,43471,43814
 42246 DEFW 44294,44416

; Shootout: figure timers
;
; 0 = counting down, 1 = ready for orders, 2 and 3 = waiting/parked. One byte per figure slot (the seventh is the furniture slot).
b42250 DEFB 3,3,3,3,3,3,3

; Shootout: countdown pointers
;
; The address of each figure slot's countdown record, used by the interrupt routine #R48539.
w42257 DEFW 42271,42274,42277,42280
 42265 DEFW 42283,42286,42289

; Shootout: figure countdowns
;
; Three bytes per figure slot: the number of interrupts left before the next frame is drawn, and the address of the figure's record plus 3 (where the drawing job begins).
b42271 DEFB 0,138,165,0,177,165,0,216
 42279 DEFB 165,0,255,165,0,38,166,0
 42287 DEFB 77,166,0,113,166

; Shootout: variables
;
; #TABLE(default,centre,:w) { =h Address | =h Meaning } { #R42292-42297 | Route script pointers for bystander 1, bystander 2 and the hit man } { 42298 | Upper limit on the screen for Mugsy and the hit man } { #R42300 | Set once the sprite graphics have been inverted } { 42301 | Mugsy's remaining hit points (from the handout) } { 42302 | The hit man's remaining hit points (4) } { 42303-42306 | Saved stack pointer and temporary } { 42307 | Frame buffer address } { 42309 | Frame table address } { 42311 | Number of figure slots in use } { 42312-42313 | Number of frames in the current animation and delay between frames } { 42314 | Left limit for the current figure } { 42315 | Direction code from the keyboard } { #R42316-42317 | Firing state of Mugsy and the hit man } { 42318-42321 | Steps left for the two bullets and bullet cancel flags } { 42322 | Set when a figure could not move } { 42323-42326 | Bystander 1, bystander 2, Mugsy and the hit man have gone down } { 42327-42328 | A bullet touches bystander 1 or bystander 2 } { 42329-42330 | Mugsy or the hit man has run out of hit points } { 42331-42332 | Mugsy's or the hit man's bullet has landed } { 42333 | Somebody has gone down in this pass of the main loop } { 42334 | The result: bit 0 Mugsy killed, bit 1 hit man killed, bits 2-3 bystanders hit } { 42335 | The shootout is over } TABLE#
