 42645 LD B,33 ; B=33 bytes to clear
 42647 XOR A ; A=0
 42648 LD (HL),A ; Clear a flag
 42649 INC HL ; Move on
 42650 DJNZ 42648 ; Loop for all 33 bytes
 42652 LD HL,42250 ; HL=the figure timers (one byte per figure, from #R42250)
 42655 LD B,7 ; B=7 timers
 42657 LD (HL),3 ; Set a timer to 3: "idle" (1 means ready for orders, 0 means a countdown is running)
 42659 INC HL ; Next timer
 42660 DJNZ 42657 ; Loop for all seven
 42662 LD BC,405 ; BC=405
 42665 LD HL,24575 ; HL=24575, the top of a work area below the code
 42668 LD DE,24574 ; DE=24574
 42671 XOR A ; A=0
 42672 LD (HL),A ; Clear the first byte of the work area
 42673 LDDR ; Clear 405 more, working backwards (24170-24575): the sprite frame buffers are cleaned out
 42675 LD BC,60 ; BC=60
 42678 LD HL,24115 ; HL=24115
 42681 LD DE,24114 ; DE=24114
 42684 LD A,56 ; A=56: white paper, black ink
 42686 LD (HL),A ; Store the first attribute
 42687 LDDR ; Fill 60 attribute bytes (24055-24115) with white paper
 42689 LD A,(42300) ; A=has the walls graphic been inverted already? (#R42300)
 42692 AND A ; Test it
 42693 JR NZ,42715 ; Skip the inversion if it has
 42695 LD A,1 ; A=1
 42697 LD (42300),A ; Mark the sprite data as inverted (it is stored inverted in the file and flipped once, on first use)
 42700 LD HL,47082 ; HL=start of the sprite data (#R47082)
 42703 LD BC,1326 ; BC=1326 bytes
 42706 LD A,(HL) ; Fetch a byte of sprite data
 42707 CPL ; Invert it
 42708 LD (HL),A ; Store it back
 42709 INC HL ; Next byte
 42710 DEC BC ; Count down
 42711 LD A,C ; A=C
 42712 OR B ; Combine with B
 42713 JR NZ,42706 ; Loop until all 1326 bytes are done
 42715 LD A,7 ; A=7
 42717 LD (42311),A ; Seven figure slots to service while the furniture is drawn (the seventh draws furniture)
 42720 LD A,1 ; A=1
 42722 LD (42289),A ; Make the furniture slot's timer expire at once
 42725 LD HL,45711 ; HL=first furniture descriptor (#R45711)
 42728 CALL 42940 ; Load it into the furniture slot's record
 42731 CALL 42931 ; Wait for the interrupt routine to draw it
 42734 LD HL,18633 ; HL=screen address of the next piece
 42737 LD DE,22985 ; DE=its attribute address
 42740 CALL 42970 ; Request a redraw and wait
 42743 LD HL,20564 ; HL=screen address
 42746 LD DE,23124 ; DE=attribute address
 42749 CALL 42970 ; Request a redraw and wait
 42752 LD HL,18653 ; HL=screen address
 42755 LD DE,23005 ; DE=attribute address
 42758 CALL 42970 ; Request a redraw and wait
 42761 LD A,1 ; A=1
 42763 LD (42289),A ; Re-arm the furniture slot's timer
 42766 LD HL,45721 ; HL=second furniture descriptor (45721)
 42769 CALL 42940 ; Load it into the furniture slot's record
 42772 CALL 42931 ; Wait for the interrupt routine to draw it
 42775 LD HL,18599 ; HL=screen address of a copy
 42778 LD DE,22951 ; DE=its attribute address
 42781 CALL 42970 ; Redraw and wait
 42784 LD HL,20530 ; HL=screen address
 42787 LD DE,23090 ; DE=attribute address
 42790 CALL 42970 ; Redraw and wait
 42793 LD HL,18619 ; HL=screen address
 42796 LD DE,22971 ; DE=attribute address
 42799 CALL 42970 ; Redraw and wait
 42802 LD HL,48354 ; HL=address of the third furniture graphic (#R48354)
 42805 LD (42625),HL ; Patch it into the furniture slot's record
 42808 LD HL,18455 ; HL=screen address
 42811 LD DE,22807 ; DE=attribute address
 42814 CALL 42970 ; Redraw and wait
 42817 LD HL,18603 ; HL=screen address
 42820 LD DE,22955 ; DE=attribute address
 42823 CALL 42970 ; Redraw and wait
 42826 LD HL,20534 ; HL=screen address
 42829 LD DE,23094 ; DE=attribute address
 42832 CALL 42970 ; Redraw and wait
 42835 LD HL,45731 ; HL=initial records of the six real figures (#R45731)
 42838 LD DE,42375 ; DE=the first figure's record (#R42375)
 42841 LD BC,234 ; BC=234 bytes (6 records of 39)
 42844 LDIR ; Copy the figure records into place
 42846 LD A,6 ; A=6
 42848 LD (42311),A ; From now on only six slots are serviced (the furniture slot is retired)
 42851 LD HL,23875 ; HL=23875: a sprite frame buffer
 42854 LD (42307),HL ; Use it for the next figure drawn
 42857 LD HL,42492 ; HL=42492: the hit man's record
 42860 PUSH HL ; Save it
 42861 CALL 45693 ; Copy the record into the workspace
 42864 CALL 45079 ; Work out where to draw him
 42867 CALL 45201 ; Draw him
 42870 POP DE ; DE=the record again
 42871 CALL 45702 ; Copy the workspace back into the record
 42874 LD HL,42253 ; HL=42253: the timer for figure 3 (the hit man)
 42877 LD (HL),0 ; Set it to 0: his countdown starts running
 42879 LD A,1 ; A=1
 42881 LD (42280),A ; The hit man waits one tick before first acting
 42884 EI ; Enable interrupts
 42885 HALT ; Let one interrupt happen
 42886 DI ; Disable interrupts again
 42887 LD HL,42527 ; HL=42527: the hit man's record, byte +35
 42890 LD (HL),1 ; Set it to 1
 42892 LD HL,42253 ; HL=42253 (the hit man's timer)
 42895 LD (HL),3 ; Set it to 3: idle
 42897 LD HL,42250 ; HL=42250: the timers again
 42900 LD (HL),1 ; Set the first timer to 1: bystander 1 may act at once
 42902 INC HL ; Next timer
 42903 LD (HL),1 ; Set the second timer to 1: bystander 2 may act at once
 42905 LD HL,46645 ; HL=bystander 1's route script (#R46645)
 42908 LD (42292),HL ; Store it as that figure's script pointer
 42911 LD HL,46825 ; HL=bystander 2's route script (#R46825)
 42914 LD (42294),HL ; Store it
 42917 LD HL,47058 ; HL=the hit man's route script (#R47058)
 42920 LD (42296),HL ; Store it
 42923 LD HL,16512 ; HL=16512: the top row of the playing area on the screen
 42926 LD (42298),HL ; Store it as the upper limit for Mugsy and the hit man
 42929 EI ; Enable interrupts: the shootout is live
 42930 RET ; Return

; Shootout: wait for an interrupt
c42931 LD HL,42256 ; HL=the furniture slot's timer
 42934 LD (HL),0 ; Set it to 0 so that the interrupt routine runs its countdown
 42936 EI ; Enable interrupts
 42937 HALT ; Wait for the next interrupt
 42938 DI ; Disable interrupts
 42939 RET ; Return

; Shootout: load a furniture descriptor into the furniture slot
;
; Copies the 10-byte descriptor at HL: 6 bytes (screen address and graphic data) and then 4 bytes (attribute address and colour) into the seventh figure record, which the interrupt routine draws.
c42940 LD DE,42623 ; DE=where the furniture slot keeps its first six data bytes (#R42623)
 42943 LD BC,6 ; BC=6 bytes
 42946 LDIR ; Copy the screen position and graphic data
 42948 LD DE,42635 ; DE=where it keeps the attribute data (42635)
 42951 LD BC,4 ; BC=4 bytes
 42954 LDIR ; Copy them
 42956 RET ; Return

; Shootout: place a piece of furniture (HL=screen address, DE=attribute address)
c42957 LD A,1 ; A=1
 42959 LD (42289),A ; Re-arm the furniture slot's timer
 42962 LD (42623),HL ; Store the screen address
 42965 LD (42635),DE ; Store the attribute address
 42969 RET ; Return

; Shootout: draw a piece of furniture and wait for the interrupt
c42970 CALL 42957 ; Set the new position
 42973 CALL 42931 ; Let the interrupt routine draw it
 42976 RET ; Return

; Shootout: main loop (the figure dispatcher)
;
; The shootout is a small cooperative scheduler. Each of the six figures (bystander 1, bystander 2, Mugsy, the hit man, Mugsy's bullet and the hit man's bullet) has a timer byte at 42250+n and a handler address in the table at #R42238. A timer of 0 means that the figure's countdown is running; the interrupt routine #R48539 ticks the countdown and, when it reaches zero, draws the figure's next frame and sets the timer to 1. A timer of 1 tells this routine that the figure is ready for new orders: it runs the handler, which reads the next byte of the figure's route script (or the keyboard, for Mugsy), moves it, and leaves the timer to be decremented back to 0. A timer of 3 parks a figure for good.
c42977 XOR A ; A=0
 42978 LD (42333),A ; Clear the "somebody is down" flag for this pass of the loop
 42981 LD A,(42311) ; A=number of figure slots in use (7 while the furniture is drawn, then 6)
 42984 LD B,A ; B=the slot count
 42985 LD C,0 ; C=0: the slot number
 42987 LD HL,42250 ; HL=the slot timers (#R42250...)
 42990 LD A,1 ; A=1: a timer of 1 means the figure is ready for new orders
 42992 CP (HL) ; Is this slot's timer 1?
 42993 JR NZ,43013 ; No: leave this figure alone for now
 42995 PUSH BC ; Save the loop counter and slot number
 42996 PUSH HL ; Save the timer pointer
 42997 LD B,0 ; B=0
 42999 RL C ; C=slot number*2: the offset into the handler table
 43001 LD HL,42238 ; HL=handler table (#R42238)
 43004 ADD HL,BC ; Point at this slot's entry
 43005 LD E,(HL) ; E=low byte of the handler address
 43006 INC HL ; Next byte
 43007 LD D,(HL) ; D=high byte
 43008 EX DE,HL ; HL=handler address
 43009 JP (HL) ; Run the handler (it ends with JP #R43010)
 43010 POP HL ; Restore the timer pointer
 43011 POP BC ; Restore the loop counter and slot number
 43012 DEC (HL) ; Timer 1 becomes 0: the interrupt routine now counts this figure's next move down
 43013 INC HL ; Next slot's timer
 43014 INC C ; Next slot number
 43015 DJNZ 42990 ; Loop for all slots
 43017 RET ; Return

; Shootout: handler for bystander 1
;
; Route script bytes are direction codes (4 right, 64 left, 2 up-right, 128 up-left, 8 down-right, 32 down-left), 0 for "stand still for a tick", 80, 81 and 82 for standing for 25, 1 or 128 ticks, 255 to hand over to the next figure and 254 to leave the restaurant and end the shootout.
c43018 LD A,(42323) ; Handler for slot 0 (bystander 1): A=has he already gone down or left?
 43021 AND A ; Test it
 43022 JR Z,43032 ; No: carry on
 43024 LD HL,42250 ; HL=his timer
 43027 LD (HL),3 ; Park the timer at 3 so he is never serviced again
 43029 JP 43010 ; Back to the dispatcher
 43032 LD A,(42327) ; A=has a bullet hit him?
 43035 AND A ; Test it
 43036 JR NZ,43074 ; Yes: make him fall over
 43038 LD HL,(42292) ; HL=his script pointer
 43041 LD A,(HL) ; A=the next script byte
 43042 CP 254 ; 254: end of the script
 43044 JP Z,43183 ; Handle that below
 43047 CP 255 ; 255: hand over to the hit man
 43049 JR Z,43170 ; Handle that below
 43051 CP 80 ; 80: stand still for a long time
 43053 JR Z,43143 ; Handle that below
 43055 CP 81 ; 81: stand still for one tick
 43057 JR Z,43152 ; Handle that below
 43059 CP 82 ; 82: stand still for a very long time
 43061 JR Z,43161 ; Handle that below
 43063 CP 0 ; 0: a plain animation step
 43065 JR Z,43098 ; Handle that with the moves
 43067 AND 238 ; Keep only the bits that are not 1 or 16
 43069 JR NZ,43098 ; A real direction code: make the move
 43071 JP 43010 ; Anything else (1, 16 or 17) is ignored this time
 43074 LD HL,42334 ; HL=the result byte (42334)
 43077 SET 2,(HL) ; Set bit 2: bystander 1 has been hit
 43079 LD (42323),A ; Remember that he is down (A is non-zero)
 43082 LD A,30 ; A=30
 43084 LD (42271),A ; He lies there for 30 ticks before his countdown ends
 43087 LD A,8 ; A=8: the falling animation length
 43089 LD BC,48250 ; BC=48250: the falling-over graphic
 43092 LD HL,42375 ; HL=his record (#R42375)
 43095 JP 44558 ; Set up the falling animation
 43098 PUSH HL ; Save the script pointer
 43099 LD A,4 ; A=4
 43101 LD (42312),A ; Four animation frames in the cycle
 43104 DEC A ; A=3
 43105 LD (42313),A ; The frame delay is 3
 43108 DEC A ; A=2
 43109 LD (42271),A ; His countdown is 2 ticks
 43112 LD HL,42174 ; HL=the walking frame table (#R42174)
 43115 LD (42309),HL ; Use it
 43118 LD HL,23575 ; HL=23575: the frame buffer for this figure
 43121 LD (42307),HL ; Use it
 43124 XOR A ; A=0
 43125 LD (42314),A ; Reset the left limit
 43128 POP HL ; Get the script pointer back
 43129 LD A,(HL) ; A=the direction code from the script
 43130 INC HL ; Move the pointer on
 43131 LD (42292),HL ; Store the new script pointer
 43134 LD HL,42375 ; HL=his record
 43137 CALL 44953 ; Move him and redraw
 43140 JP 43010 ; Back to the dispatcher
 43143 EX DE,HL ; 80: swap pointer and frame table
 43144 LD HL,42190 ; HL=standing frame table (#R42190)
 43147 LD A,25 ; A=25: stand for 25 ticks
 43149 JP 43220 ; Carry on
 43152 EX DE,HL ; 81: swap pointer and frame table
 43153 LD HL,42174 ; HL=walking frame table (#R42174)
 43156 LD A,1 ; A=1: one tick
 43158 JP 43220 ; Carry on
 43161 EX DE,HL ; 82: swap pointer and frame table
 43162 LD HL,42174 ; HL=walking frame table
 43165 LD A,128 ; A=128: a long wait
 43167 JP 43220 ; Carry on
 43170 LD HL,42250 ; 255: HL=his timer
 43173 LD (HL),3 ; Park him at 3
 43175 INC HL ; Move to the next timer
 43176 INC HL ; And the next
 43177 INC HL ; And the hit man's timer
 43178 LD (HL),1 ; Make the hit man ready for orders
 43180 JP 43010 ; Back to the dispatcher
 43183 LD HL,42375 ; 254: HL=his record
 43186 PUSH HL ; Save it
 43187 CALL 45693 ; Copy it to the workspace
 43190 CALL 45155 ; Copy his coordinates
 43193 LD HL,1000 ; HL=1000: off the screen
 43196 LD (42353),HL ; Move him off the screen
 43199 LD (42365),HL ; And his attribute address
 43202 POP DE ; DE=the record
 43203 CALL 45702 ; Copy the workspace back
 43206 LD A,1 ; A=1
 43208 LD (42323),A ; He is gone
 43211 LD (42271),A ; His countdown is 1
 43214 LD (42335),A ; Set the "shootout over" flag
 43217 JP 43010 ; Back to the dispatcher
 43220 INC DE ; Point past the script byte
 43221 LD (42292),DE ; Store the new script pointer
 43225 LD (42271),A ; Set the countdown
 43228 LD (42309),HL ; Set the frame table
 43231 LD HL,23575 ; HL=frame buffer
 43234 LD (42307),HL ; Use it
 43237 LD HL,42375 ; HL=his record
 43240 CALL 44726 ; Redraw him
 43243 JP 43010 ; Back to the dispatcher

; Shootout: handler for bystander 2
c43246 LD A,(42324) ; Handler for slot 1 (bystander 2): has he gone down?
 43249 AND A ; Test it
 43250 JR Z,43260 ; No: carry on
 43252 LD HL,42251 ; HL=his timer
 43255 LD (HL),3 ; Park it
 43257 JP 43010 ; Back to the dispatcher
 43260 LD A,(42328) ; Has a bullet hit him?
 43263 AND A ; Test it
 43264 JR NZ,43302 ; Yes: make him fall over
 43266 LD HL,(42294) ; HL=his script pointer
 43269 LD A,(HL) ; A=the next script byte
 43270 CP 254 ; 254: end of script
 43272 JP Z,43408 ; Handle that below
 43275 CP 255 ; 255: hand over
 43277 JR Z,43397 ; Handle that below
 43279 CP 80 ; 80: stand still for a long time
 43281 JR Z,43370 ; Handle that below
 43283 CP 81 ; 81: stand still for one tick
 43285 JR Z,43379 ; Handle that below
 43287 CP 82 ; 82: stand still for a while
 43289 JR Z,43388 ; Handle that below
 43291 CP 0 ; 0: plain step
 43293 JR Z,43326 ; Handle that with the moves
 43295 AND 238 ; Keep only the bits that are not 1 or 16
 43297 JR NZ,43326 ; A real direction code: move
 43299 JP 43010 ; Ignore 1, 16 and 17
 43302 LD HL,42334 ; HL=the result byte
 43305 SET 3,(HL) ; Set bit 3: bystander 2 has been hit
 43307 LD (42324),A ; Remember he is down
 43310 LD A,30 ; A=30
 43312 LD (42274),A ; His countdown is 30
 43315 LD A,16 ; A=16: the falling animation length
 43317 LD BC,48154 ; BC=48154: the falling-over graphic
 43320 LD HL,42414 ; HL=his record (42414)
 43323 JP 44558 ; Set up the falling animation
 43326 PUSH HL ; Save the script pointer
 43327 LD A,2 ; A=2
 43329 LD (42312),A ; Two animation frames in the cycle
 43332 LD (42313),A ; Frame delay 2
 43335 INC A ; A=3
 43336 LD (42274),A ; Countdown 3
 43339 LD HL,42194 ; HL=his walking frame table (42194)
 43342 LD (42309),HL ; Use it
 43345 LD HL,23675 ; HL=frame buffer (23675)
 43348 LD (42307),HL ; Use it
 43351 XOR A ; A=0
 43352 LD (42314),A ; Reset the left limit
 43355 POP HL ; Get the script pointer back
 43356 LD A,(HL) ; A=the direction code
 43357 INC HL ; Advance the pointer
 43358 LD (42294),HL ; Store it
 43361 LD HL,42414 ; HL=his record
 43364 CALL 44953 ; Move him and redraw
 43367 JP 43010 ; Back to the dispatcher
 43370 EX DE,HL ; 80: swap
 43371 LD HL,42202 ; HL=standing frame table (42202)
 43374 LD A,25 ; A=25
 43376 JP 43445 ; Carry on
 43379 EX DE,HL ; 81: swap
 43380 LD HL,42194 ; HL=walking frame table (42194)
 43383 LD A,1 ; A=1
 43385 JP 43445 ; Carry on
 43388 EX DE,HL ; 82: swap
 43389 LD HL,42194 ; HL=walking frame table
 43392 LD A,100 ; A=100: wait
 43394 JP 43445 ; Carry on
 43397 LD HL,42251 ; 255: HL=his timer
 43400 LD (HL),3 ; Park it
 43402 INC HL ; Next timer
 43403 LD (HL),1 ; Make slot 2 (Mugsy) ready
 43405 JP 43010 ; Back to the dispatcher
 43408 LD HL,42414 ; 254: HL=his record
 43411 PUSH HL ; Save it
 43412 CALL 45693 ; Copy to workspace
 43415 CALL 45155 ; Copy coordinates
 43418 LD HL,1000 ; HL=1000: off screen
 43421 LD (42353),HL ; Move him off the screen
 43424 LD (42365),HL ; And his attributes
 43427 POP DE ; DE=the record
 43428 CALL 45702 ; Copy back
 43431 LD A,1 ; A=1
 43433 LD (42324),A ; He is gone
 43436 LD (42274),A ; Countdown 1
 43439 LD (42335),A ; Set the "shootout over" flag
 43442 JP 43010 ; Back to the dispatcher
 43445 INC DE ; Point past the script byte
 43446 LD (42294),DE ; Store the pointer
 43450 LD (42274),A ; Set the countdown
 43453 LD (42309),HL ; Set the frame table
 43456 LD HL,23675 ; HL=frame buffer
 43459 LD (42307),HL ; Use it
 43462 LD HL,42414 ; HL=his record
 43465 CALL 44726 ; Redraw him
 43468 JP 43010 ; Back to the dispatcher

; Shootout: handler for Mugsy
;
; Takes the direction code from #R46460, handles firing (state 0 idle, 1 and 2 raising the gun, 3 firing a bullet) and Mugsy's death.
c43471 LD A,(42325) ; Handler for slot 2 (Mugsy): is he dead?
 43474 AND A ; Test it
 43475 JR Z,43509 ; No: carry on
 43477 LD HL,42252 ; HL=his timer
 43480 LD (HL),3 ; Park it at 3
 43482 LD A,(42333) ; A=the "somebody is down" flag
 43485 AND A ; Test it
 43486 JR NZ,43493 ; Already set: skip
 43488 LD A,1 ; A=1
 43490 LD (42333),A ; Tell the other figures that a gunfight has ended
 43493 LD IX,42453 ; IX=his record (42453)
 43497 LD HL,18576 ; HL=18576: where he lies
 43500 LD (IX+17),L ; Put him there (low byte)
 43503 LD (IX+18),H ; And the high byte
 43506 JP 43010 ; Back to the dispatcher
 43509 LD A,(42329) ; Has the hit man's bullet used up his hit points?
 43512 AND A ; Test it
 43513 JR NZ,43541 ; Yes: he dies
 43515 LD A,(42316) ; A=is Mugsy's gun being fired (his fire state)?
 43518 AND A ; Test it
 43519 JP NZ,43639 ; Yes: continue the firing sequence
 43522 LD A,(42315) ; A=the direction code from the keyboard
 43525 LD B,A ; B=the code
 43526 CP 10 ; 10 means fire
 43528 JR Z,43608 ; Start firing
 43530 CP 0 ; 0 means no key pressed
 43532 JR Z,43565 ; Stand still
 43534 AND 238 ; Keep only the bits that are not 1 or 16
 43536 JR NZ,43565 ; A real direction: move
 43538 JP 43010 ; Otherwise do nothing
 43541 LD HL,42334 ; HL=the result byte
 43544 SET 0,(HL) ; Set bit 0: Mugsy has been killed
 43546 LD (42325),A ; Remember he is dead
 43549 LD A,30 ; A=30
 43551 LD (42277),A ; His countdown is 30
 43554 LD A,16 ; A=16: the falling animation length
 43556 LD BC,48106 ; BC=48106: the falling-over graphic
 43559 LD HL,42453 ; HL=his record (42453)
 43562 JP 44558 ; Set up the falling animation
 43565 LD A,2 ; A=2
 43567 LD (42312),A ; Mugsy's animation has two frames
 43570 LD (42277),A ; Countdown 2
 43573 LD A,4 ; A=4
 43575 LD (42313),A ; Frame delay 4
 43578 LD HL,42206 ; HL=Mugsy's walking frame table (#R42206)
 43581 LD (42309),HL ; Use it
 43584 LD DE,23775 ; DE=frame buffer (23775)
 43587 LD (42307),DE ; Use it
 43591 LD IX,42453 ; IX=his record
 43595 CALL 44612 ; Work out the limits of his movement
 43598 LD HL,42453 ; HL=his record
 43601 LD A,B ; A=the direction code
 43602 CALL 44953 ; Move him
 43605 JP 43010 ; Back to the dispatcher
 43608 LD HL,42316 ; He is firing: HL=his fire state
 43611 INC (HL) ; Raise it to 1
 43612 INC (HL) ; And to 2
 43613 LD HL,42214 ; HL=Mugsy's firing frame table (#R42214)
 43616 LD (42309),HL ; Use it
 43619 LD HL,23775 ; HL=frame buffer (23775)
 43622 LD (42307),HL ; Use it
 43625 LD A,5 ; A=5
 43627 LD (42277),A ; Countdown 5
 43630 LD HL,42453 ; HL=his record
 43633 CALL 44726 ; Draw the gun being raised
 43636 JP 43010 ; Back to the dispatcher
 43639 CP 2 ; Is the fire state 2?
 43641 JP NZ,43779 ; No: end of the firing sequence
 43644 LD IX,42453 ; IX=Mugsy's record
 43648 LD A,(IX+0) ; A=his state byte
 43651 AND 224 ; Which way is he facing (bits 5-7)?
 43653 JR NZ,43666 ; Facing left: use that branch
 43655 LD A,(IX+17) ; A=his screen address, low byte
 43658 AND 31 ; Column
 43660 CP 28 ; Is he at column 28, the right wall?
 43662 JR Z,43697 ; Yes: no room for a bullet
 43664 JR 43678 ; Fire the bullet
 43666 LD A,(IX+17) ; Facing left: A=screen address low byte
 43669 AND 31 ; Column
 43671 LD B,A ; B=column
 43672 LD A,(42314) ; A=the left limit
 43675 CP B ; Same column?
 43676 JR Z,43697 ; Yes: no room for a bullet
 43678 LD IY,42531 ; IY=the bullet's record (42531)
 43682 LD B,11 ; B=11: the bullet starts 11 pixel rows down
 43684 CALL 43709 ; Position the bullet next to the gun
 43687 LD A,10 ; A=10
 43689 LD (42318),A ; The bullet flies for 10 steps
 43692 LD HL,42254 ; HL=the bullet's timer
 43695 LD (HL),1 ; Make the bullet ready to move
 43697 LD HL,42316 ; HL=fire state
 43700 INC (HL) ; Raise it to 3
 43701 LD A,5 ; A=5
 43703 LD (42277),A ; Countdown 5
 43706 JP 43010 ; Back to the dispatcher

; Shootout: place a bullet in front of its owner (B=rows down from the top of the figure)
c43709 LD A,(IX+0) ; A=the owner's state byte
 43712 LD (IY+0),A ; Give the bullet the same facing
 43715 LD L,(IX+17) ; L=the owner's screen address, low byte
 43718 LD H,(IX+18) ; H=high byte
 43721 INC H ; Move down one pixel row...
 43722 CALL 45651 ; (using this subroutine)
 43725 DJNZ 43721 ; ...B times
 43727 LD A,(IY+0) ; A=the bullet's state
 43730 AND 224 ; Which way?
 43732 JR NZ,43743 ; Left: handle that
 43734 INC L ; Facing right: move the bullet two cells right of the gun
 43735 INC L ; Another one
 43736 LD A,4 ; A=4: right
 43738 LD (IY+0),A ; Set the bullet's direction
 43741 JR 43749 ; Carry on
 43743 DEC L ; Facing left: one cell to the left
 43744 LD A,64 ; A=64: left
 43746 LD (IY+0),A ; Set the direction
 43749 LD (IY+17),L ; Set the bullet's screen address
 43752 LD (IY+18),H ; And high byte
 43755 EX DE,HL ; DE=screen address
 43756 CALL 45626 ; Convert to an attribute address
 43759 LD (IY+29),E ; Store it
 43762 LD (IY+30),D ; And high byte
 43765 XOR A ; A=0
 43766 LD (IY+3),A ; Clear some counters
 43769 LD (IY+4),A ; And another
 43772 LD (IY+13),A ; And another
 43775 LD (IY+14),A ; And another
 43778 RET ; Return
 43779 LD HL,42218 ; HL=Mugsy's standing frame table (42218)
 43782 LD (42309),HL ; Use it
 43785 LD HL,23775 ; HL=frame buffer (23775)
 43788 LD (42307),HL ; Use it
 43791 LD A,6 ; A=6
 43793 LD (42277),A ; Countdown 6
 43796 XOR A ; A=0
 43797 LD (42316),A ; Reset the fire state
 43800 LD HL,42453 ; HL=his record
 43803 CALL 44726 ; Redraw him standing
 43806 LD HL,42488 ; HL=42488
 43809 LD (HL),1 ; Set the flag
 43811 JP 43010 ; Back to the dispatcher

; Shootout: handler for the hit man
;
; Follows short move fragments (#R47034-47081). At the end of each fragment he compares his position with Mugsy's and picks a new one that moves him towards Mugsy, firing when they are on the same row.
c43814 LD A,(42326) ; Handler for slot 3 (the hit man): has Mugsy's bullet used up his hit points?
 43817 AND A ; Test it
 43818 JR Z,43839 ; No: carry on
 43820 LD HL,42253 ; HL=his timer
 43823 LD (HL),3 ; Park it at 3
 43825 LD A,(42333) ; A=the "somebody is down" flag
 43828 AND A ; Test it
 43829 JR NZ,43836 ; Already set: skip
 43831 LD A,1 ; A=1
 43833 LD (42333),A ; Set it
 43836 JP 43010 ; Back to the dispatcher
 43839 LD A,(42330) ; Has Mugsy's bullet used up the hit man's hit points?
 43842 AND A ; Test it
 43843 JR NZ,43875 ; Yes: he dies
 43845 LD A,(42317) ; A=the hit man's fire state
 43848 AND A ; Test it
 43849 JP NZ,44190 ; Yes: continue the firing sequence
 43852 LD HL,(42296) ; HL=his script pointer
 43855 LD A,(HL) ; A=the next script byte
 43856 CP 255 ; 255: end of the fragment
 43858 JR Z,43977 ; Choose a new one
 43860 CP 10 ; 10: fire
 43862 JR Z,43938 ; Fire
 43864 CP 0 ; 0: standing step
 43866 JR Z,43899 ; Do that
 43868 AND 238 ; Keep only the bits that are not 1 or 16
 43870 JR NZ,43899 ; A real direction: move
 43872 JP 43010 ; Ignore the rest
 43875 LD HL,42334 ; HL=the result byte
 43878 SET 1,(HL) ; Set bit 1: the hit man has been killed
 43880 LD (42326),A ; Remember he is dead
 43883 LD A,30 ; A=30
 43885 LD (42280),A ; His countdown is 30
 43888 LD A,16 ; A=16: the falling animation length
 43890 LD BC,48202 ; BC=48202: the falling-over graphic
 43893 LD HL,42492 ; HL=his record (42492)
 43896 JP 44558 ; Set up the falling animation
 43899 PUSH HL ; Save the script pointer
 43900 LD A,2 ; A=2
 43902 LD (42312),A ; Two frames in the cycle
 43905 LD (42313),A ; Frame delay 2
 43908 LD (42280),A ; Countdown 2
 43911 LD HL,42222 ; HL=the hit man's walking frame table (#R42222)
 43914 LD (42309),HL ; Use it
 43917 LD HL,23875 ; HL=frame buffer (23875)
 43920 LD (42307),HL ; Use it
 43923 POP HL ; Get the pointer back
 43924 LD A,(HL) ; A=the direction code
 43925 INC HL ; Advance the pointer
 43926 LD (42296),HL ; Store it
 43929 LD HL,42492 ; HL=his record
 43932 CALL 44953 ; Move him
 43935 JP 43010 ; Back to the dispatcher
 43938 INC HL ; Fire: skip the script byte
 43939 LD (42296),HL ; Store the pointer
 43942 LD HL,42317 ; HL=his fire state
 43945 INC (HL) ; Raise it to 1
 43946 INC (HL) ; And to 2
 43947 LD HL,42230 ; HL=the hit man's firing frame table (#R42230)
 43950 LD (42309),HL ; Use it
 43953 LD HL,23875 ; HL=frame buffer (23875)
 43956 LD (42307),HL ; Use it
 43959 LD IX,42492 ; IX=his record
 43963 LD A,8 ; A=8
 43965 LD (42280),A ; Countdown 8
 43968 LD HL,42492 ; HL=his record
 43971 CALL 44726 ; Draw the gun being raised
 43974 JP 43010 ; Back to the dispatcher
 43977 XOR A ; End of the fragment: work out where Mugsy is
 43978 LD B,A ; B=0
 43979 LD C,A ; C=0: the direction bits
 43980 LD IX,42453 ; IX=Mugsy's record
 43984 LD IY,42492 ; IY=the hit man's record
 43988 LD A,(IX+17) ; A=Mugsy's column (low byte)
 43991 AND 31 ; Keep the column bits
 43993 LD L,A ; L=Mugsy's column
 43994 LD A,(IY+17) ; A=the hit man's address low byte
 43997 AND 31 ; Column bits
 43999 LD H,A ; H=the hit man's column
 44000 LD A,(IX+18) ; A=Mugsy's address high byte
 44003 AND 24 ; Which third of the screen?
 44005 LD E,A ; E=Mugsy's third
 44006 LD A,(IY+18) ; A=the hit man's address high byte
 44009 AND 24 ; Which third?
 44011 LD D,A ; D=the hit man's third
 44012 LD A,H ; A=the hit man's column
 44013 SUB L ; Compare with Mugsy's
 44014 JR C,44021 ; Hit man is to the left
 44016 SET 2,C ; Bit 2: hit man at or right of Mugsy
 44018 JP 44023 ; Carry on
 44021 SET 3,C ; Bit 3: hit man left of Mugsy
 44023 LD A,D ; A=the hit man's third
 44024 SUB E ; Compare with Mugsy's
 44025 JR Z,44039 ; Same third
 44027 JR C,44034 ; Hit man is higher
 44029 SET 0,C ; Bit 0: hit man is lower
 44031 JP 44075 ; Choose a fragment
 44034 SET 1,C ; Bit 1: hit man is higher
 44036 JP 44075 ; Choose a fragment
 44039 LD A,(IX+17) ; Same third: A=Mugsy's row bits
 44042 AND 224 ; Row within the third
 44044 LD L,A ; L=it
 44045 LD A,(IY+17) ; A=the hit man's row bits
 44048 AND 224 ; Row within the third
 44050 CP L ; Compare
 44051 JR C,44058 ; Hit man is higher
 44053 SET 0,C ; Bit 0: hit man is lower
 44055 JP 44060 ; Carry on
 44058 SET 1,C ; Bit 1: hit man is higher
 44060 SUB L ; Difference in rows
 44061 JR NZ,44075 ; Different rows: choose a fragment
 44063 LD A,(42325) ; Same row: is Mugsy already dead?
 44066 AND A ; Test it
 44067 JR NZ,44075 ; Yes: just move
 44069 RES 0,C ; Same row and Mugsy alive: clear bit 0
 44071 RES 1,C ; And bit 1
 44073 LD B,10 ; B=10: fire
 44075 CALL 44153 ; Is there furniture beside the hit man?
 44078 JR NZ,44086 ; No: carry on
 44080 LD A,12 ; A=12
 44082 XOR C ; Flip the horizontal bits: go the other way
 44083 LD C,A ; C=the new direction bits
 44084 LD B,0 ; B=0: do not fire
 44086 LD A,C ; A=the direction bits
 44087 CP 4 ; Right (4)?
 44089 JR NZ,44097 ; No
 44091 LD HL,47042 ; Fragment #R47042
 44094 JP 44137 ; Use it
 44097 CP 8 ; Left (8)?
 44099 JR NZ,44107 ; No
 44101 LD HL,47034 ; Fragment #R47034
 44104 JP 44137 ; Use it
 44107 CP 5 ; Right and lower (5)?
 44109 JR NZ,44116 ; No
 44111 LD HL,47058 ; Fragment #R47058
 44114 JR 44137 ; Use it
 44116 CP 6 ; Left and higher (6)?
 44118 JR NZ,44125 ; No
 44120 LD HL,47074 ; Fragment #R47074
 44123 JR 44137 ; Use it
 44125 CP 9 ; Left and lower (9)?
 44127 JR NZ,44134 ; No
 44129 LD HL,47050 ; Fragment #R47050
 44132 JR 44137 ; Use it
 44134 LD HL,47066 ; Otherwise fragment #R47066
 44137 LD (42296),HL ; Store the new script pointer
 44140 INC HL ; Skip two bytes
 44141 INC HL ; Poke B (fire or not) into the fragment
 44142 LD (HL),B ; Next byte
 44143 INC HL ; Poke it again
 44144 LD (HL),B ; Next byte of the fragment
 44145 LD HL,42253 ; HL=his timer
 44148 LD (HL),2 ; Wait two ticks
 44150 JP 43010 ; Back to the dispatcher

; Shootout: check for furniture next to a figure
c44153 PUSH BC ; Save BC
 44154 LD E,(IY+29) ; E=the figure's attribute address, low byte
 44157 LD D,(IY+30) ; D=high byte
 44160 LD A,(IY+0) ; A=the figure's state byte
 44163 AND 224 ; Which way is he facing?
 44165 JR NZ,44172 ; Left: use the left offset
 44167 LD HL,96 ; Facing right: look 96 bytes ahead
 44170 JR 44175 ; Carry on
 44172 LD HL,95 ; Facing left: look 95 bytes ahead
 44175 ADD HL,DE ; HL=the attribute cell to inspect
 44176 LD A,58 ; A=58: the attribute of a piece of furniture
 44178 LD BC,4 ; BC=4: look at four cells
 44181 CPI ; Compare A with a cell
 44183 JR Z,44188 ; Found: stop
 44185 JP PE,44181 ; Keep looking
 44188 POP BC ; Restore BC
 44189 RET ; Return (zero flag set if there is furniture)
 44190 CP 2 ; Is the hit man's fire state 2?
 44192 JR NZ,44259 ; No: finish the firing sequence below
 44194 LD IX,42492 ; IX=the hit man's record
 44198 LD A,(IX+0) ; A=his state byte
 44201 AND 224 ; Which way is he facing?
 44203 JR NZ,44216 ; Left: use that branch
 44205 LD A,(IX+17) ; Facing right: A=screen address low byte
 44208 AND 31 ; Column
 44210 CP 28 ; At column 28, the right wall?
 44212 JR Z,44247 ; Yes: no bullet
 44214 JR 44228 ; Fire the bullet
 44216 LD A,(IX+17) ; Facing left: A=screen address low byte
 44219 AND 31 ; Column
 44221 LD B,A ; B=column
 44222 LD A,(42314) ; A=the left limit
 44225 CP B ; Same column?
 44226 JR Z,44247 ; Yes: no bullet
 44228 LD IY,42570 ; IY=the hit man's bullet record (42570)
 44232 LD B,13 ; B=13: the bullet starts 13 pixel rows down
 44234 CALL 43709 ; Position the bullet next to the gun
 44237 LD A,15 ; A=15
 44239 LD (42320),A ; The bullet flies for 15 steps
 44242 LD HL,42255 ; HL=the bullet's timer
 44245 LD (HL),1 ; Make the bullet ready to move
 44247 LD HL,42317 ; HL=the hit man's fire state
 44250 INC (HL) ; Raise it to 3
 44251 LD A,4 ; A=4
 44253 LD (42280),A ; Countdown 4
 44256 JP 43010 ; Back to the dispatcher
 44259 LD HL,42234 ; HL=the hit man's standing frame table (42234)
 44262 LD (42309),HL ; Use it
 44265 LD HL,23875 ; HL=frame buffer (23875)
 44268 LD (42307),HL ; Use it
 44271 LD A,8 ; A=8
 44273 LD (42280),A ; Countdown 8
 44276 XOR A ; A=0
 44277 LD (42317),A ; Reset the fire state
 44280 LD HL,42492 ; HL=his record
 44283 CALL 44726 ; Redraw him standing
 44286 LD HL,42527 ; HL=42527
 44289 LD (HL),1 ; Set the flag
 44291 JP 43010 ; Back to the dispatcher

; Shootout: handler for Mugsy's bullet
c44294 LD A,(42319) ; Handler for slot 4 (Mugsy's bullet): was a bullet just cancelled?
 44297 AND A ; Test it
 44298 JR Z,44312 ; No: carry on
 44300 XOR A ; A=0
 44301 LD (42319),A ; Clear the flag
 44304 LD HL,42254 ; HL=the bullet's timer
 44307 LD (HL),3 ; Park it at 3
 44309 JP 43010 ; Back to the dispatcher
 44312 LD HL,42531 ; HL=the bullet's record (42531)
 44315 PUSH HL ; Save it
 44316 CALL 45693 ; Copy it to the workspace
 44319 LD HL,42318 ; HL=the bullet's remaining flight
 44322 DEC (HL) ; One step less
 44323 JP Z,44376 ; Used up: remove it
 44326 LD A,9 ; A=9
 44328 CP (HL) ; Is this the first step?
 44329 JR Z,44364 ; Yes: it has only just been drawn
 44331 CALL 45155 ; Copy its coordinates
 44334 EX DE,HL ; HL=screen address
 44335 CALL 45423 ; Move it a cell in its direction
 44338 EX DE,HL ; DE=new screen address
 44339 CALL 44403 ; Get the next route byte
 44342 AND A ; Test it
 44343 JR Z,44353 ; Nothing in the way
 44345 LD A,1 ; A=1
 44347 LD (42318),A ; The bullet has hit something: stop it next time
 44350 LD (42331),A ; Tell the hit tests that Mugsy's bullet has landed
 44353 LD (42353),DE ; Store the new position
 44357 CALL 45626 ; Convert to an attribute address
 44360 LD (42365),DE ; Store it
 44364 POP DE ; DE=the record
 44365 CALL 45702 ; Copy the workspace back
 44368 LD A,1 ; A=1
 44370 LD (42283),A ; Redraw the bullet at the next tick
 44373 JP 43010 ; Back to the dispatcher
 44376 CALL 45155 ; Copy the coordinates
 44379 LD HL,1000 ; HL=1000: off the screen
 44382 LD (42353),HL ; Move the bullet off the screen
 44385 LD (42365),HL ; And its attributes
 44388 POP DE ; DE=the record
 44389 CALL 45702 ; Copy back
 44392 LD A,1 ; A=1
 44394 LD (42283),A ; Redraw
 44397 LD (42319),A ; Flag the bullet as cancelled
 44400 JP 43010 ; Back to the dispatcher

; Shootout: get the next byte of a figure's route
c44403 LD A,(42336) ; A=the figure's state byte
 44406 AND 224 ; Which way is it moving?
 44408 JR Z,44412 ; Left
 44410 LD A,(DE) ; Moving right: A=the byte at DE
 44411 RET ; Return
 44412 INC DE ; Moving left: next byte
 44413 LD A,(DE) ; A=the byte there
 44414 DEC DE ; Back to DE
 44415 RET ; Return

; Shootout: handler for the hit man's bullet
c44416 LD A,(42321) ; Handler for slot 5 (the hit man's bullet): was a bullet just cancelled?
 44419 AND A ; Test it
 44420 JR Z,44434 ; No: carry on
 44422 XOR A ; A=0
 44423 LD (42321),A ; Clear the flag
 44426 LD HL,42255 ; HL=the bullet's timer
 44429 LD (HL),3 ; Park it at 3
 44431 JP 43010 ; Back to the dispatcher
 44434 LD HL,42570 ; HL=the bullet's record (42570)
 44437 PUSH HL ; Save it
 44438 CALL 45693 ; Copy it to the workspace
 44441 LD HL,42320 ; HL=the bullet's remaining flight
 44444 DEC (HL) ; One step less
 44445 JP Z,44498 ; Used up: remove it
 44448 LD A,14 ; A=14
 44450 CP (HL) ; Is this the first step?
 44451 JR Z,44486 ; Yes
 44453 CALL 45155 ; Copy its coordinates
 44456 EX DE,HL ; HL=screen address
 44457 CALL 45423 ; Move it a cell
 44460 EX DE,HL ; DE=new address
 44461 CALL 44403 ; Get the next route byte
 44464 AND A ; Test it
 44465 JR Z,44475 ; Nothing in the way
 44467 LD A,1 ; A=1
 44469 LD (42320),A ; The bullet has hit something
 44472 LD (42332),A ; Tell the hit tests that the hit man's bullet has landed
 44475 LD (42353),DE ; Store the new position
 44479 CALL 45626 ; Convert to an attribute address
 44482 LD (42365),DE ; Store it
 44486 POP DE ; DE=the record
 44487 CALL 45702 ; Copy back
 44490 LD A,1 ; A=1
 44492 LD (42286),A ; Redraw at the next tick
 44495 JP 43010 ; Back to the dispatcher
 44498 CALL 45155 ; Copy the coordinates
 44501 LD HL,1000 ; HL=1000: off the screen
 44504 LD (42353),HL ; Move the bullet off the screen
 44507 LD (42365),HL ; And its attributes
 44510 POP DE ; DE=the record
 44511 CALL 45702 ; Copy back
 44514 LD A,1 ; A=1
 44516 LD (42286),A ; Redraw
 44519 LD (42321),A ; Flag the bullet as cancelled
 44522 JP 43010 ; Back to the dispatcher

; Shootout: look for a bullet touching a figure
;
; Returns A=1 if any of the 4x3 attribute cells at the figure's attribute address has the bullet colour (57).
c44525 LD L,(IX+29) ; L=the target's attribute address, low byte
 44528 LD H,(IX+30) ; H=high byte
 44531 LD DE,32 ; DE=32: one row of attributes
 44534 LD C,3 ; C=3: three rows to examine
 44536 PUSH HL ; Save the row start
 44537 LD B,4 ; B=4: four cells per row
 44539 LD A,57 ; A=57: the attribute of a bullet
 44541 CP (HL) ; Is this cell a bullet?
 44542 JR Z,44554 ; Yes: it is in the target
 44544 INC HL ; Next cell
 44545 DJNZ 44541 ; Loop for four cells
 44547 POP HL ; Restore the row start
 44548 ADD HL,DE ; Move down one row
 44549 DEC C ; Count the rows
 44550 JR NZ,44536 ; Loop for three rows
 44552 XOR A ; A=0: no bullet near the target
 44553 RET ; Return
 44554 LD A,1 ; A=1: a bullet is touching the target
 44556 POP HL ; Tidy the stack
 44557 RET ; Return

; Shootout: start a falling-over animation
c44558 PUSH HL ; Save the record address
 44559 PUSH AF ; Save the animation length
 44560 PUSH BC ; Save the graphic address
 44561 CALL 45693 ; Copy the record to the workspace
 44564 POP BC ; Get the graphic address back
 44565 LD (42355),BC ; Store it as the figure's frame pointer
 44569 CALL 45155 ; Copy the coordinates
 44572 POP AF ; Get the animation length
 44573 LD (42373),A ; Store it
 44576 RRA ; Divide by 8...
 44577 RRA ; ...by shifting right...
 44578 RRA ; ...three times
 44579 LD (42367),A ; Store the number of cells
 44582 EX DE,HL ; HL=the screen address
 44583 LD B,20 ; B=20: drop the figure 20 pixel rows
 44585 INC H ; Down one row
 44586 CALL 45651 ; Fix up the address across character boundaries
 44589 DJNZ 44585 ; Repeat 20 times
 44591 LD (42353),HL ; Store the new screen address
 44594 EX DE,HL ; DE=the screen address
 44595 CALL 45182 ; Compute the pixel shift
 44598 CALL 45626 ; Convert to an attribute address
 44601 LD (42365),DE ; Store it
 44605 POP DE ; DE=the record
 44606 CALL 45702 ; Copy the workspace back
 44609 JP 43010 ; Back to the dispatcher

; Shootout: work out the left and upper limits for a figure
c44612 LD A,(IX+18) ; A=the figure's screen address, high byte
 44615 CP 72 ; Is it in the top part of the screen?
 44617 JR NC,44714 ; No: use the default limit
 44619 LD A,(IX+17) ; A=the screen address, low byte
 44622 LD C,A ; C=it
 44623 AND 31 ; Column bits
 44625 LD D,A ; D=column
 44626 LD A,C ; A=the full byte
 44627 AND 224 ; Row bits
 44629 LD C,A ; C=row bits
 44630 CP 128 ; Row 4 (128)?
 44632 JR NZ,44646 ; No
 44634 LD A,D ; A=column
 44635 CP 4 ; Column 4?
 44637 JR NZ,44714 ; No: default
 44639 LD A,4 ; A=4: left limit
 44641 LD HL,16512 ; HL=16512
 44644 JR 44719 ; Store it
 44646 LD A,C ; A=row bits
 44647 CP 160 ; Row 5 (160)?
 44649 JR NZ,44663 ; No
 44651 LD A,D ; A=column
 44652 CP 3 ; Column below 3?
 44654 JR C,44714 ; Yes: default
 44656 LD A,3 ; A=3: left limit
 44658 LD HL,16544 ; HL=16544
 44661 JR 44719 ; Store it
 44663 LD A,C ; A=row bits
 44664 CP 192 ; Row 6 (192)?
 44666 JR NZ,44680 ; No
 44668 LD A,D ; A=column
 44669 CP 2 ; Column below 2?
 44671 JR C,44714 ; Yes: default
 44673 LD A,2 ; A=2: left limit
 44675 LD HL,16576 ; HL=16576
 44678 JR Z,44719 ; Store it
 44680 LD A,C ; A=row bits
 44681 CP 224 ; Row 7 (224)?
 44683 JR NZ,44697 ; No
 44685 LD A,D ; A=column
 44686 AND 3 ; Low two bits of the column
 44688 JR Z,44714 ; Zero: default
 44690 LD A,1 ; A=1: left limit
 44692 LD HL,16608 ; HL=16608
 44695 JR 44719 ; Store it
 44697 LD A,C ; A=row bits
 44698 CP 0 ; Row 0?
 44700 JR NZ,44714 ; No: default
 44702 LD A,D ; A=column
 44703 CP 0 ; Column 0?
 44705 JR NZ,44714 ; No: default
 44707 LD A,0 ; A=0: left limit
 44709 LD HL,18432 ; HL=18432
 44712 JR 44719 ; Store it
 44714 LD A,0 ; A=0: no left limit
 44716 LD HL,16512 ; HL=16512: the top of the playing area
 44719 LD (42298),HL ; Store the upper limit
 44722 LD (42314),A ; Store the left limit
 44725 RET ; Return

; Shootout: move and redraw the current figure
c44726 PUSH HL ; Save the record address
 44727 CALL 45693 ; Copy it to the workspace
 44730 CALL 45155 ; Copy the coordinates
 44733 LD HL,(42309) ; HL=the frame table
 44736 LD (42369),HL ; Store it in the workspace
 44739 CALL 45079 ; Update the figure's position and animation
 44742 LD (42353),DE ; Store the new screen address
 44746 LD A,(42336) ; A=the state byte
 44749 AND 224 ; Facing left?
 44751 JR NZ,44758 ; Yes: erase and redraw leftwards
 44753 CALL 45201 ; Draw facing right
 44756 JR 44761 ; Done
 44758 CALL 45276 ; Draw facing left
 44761 POP DE ; DE=the record
 44762 CALL 45702 ; Copy the workspace back
 44765 RET ; Return

; Shootout: deal with Mugsy firing
c44766 LD A,(42331) ; A=has Mugsy's bullet landed?
 44769 AND A ; Test it
 44770 JR Z,44802 ; No: check the hit man's
 44772 XOR A ; A=0
 44773 LD (42331),A ; Clear the flag
 44776 LD IX,42492 ; IX=the hit man's record
 44780 CALL 44525 ; Is the bullet touching him?
 44783 AND A ; Test it
 44784 JR Z,44797 ; No
 44786 XOR A ; A=0
 44787 LD HL,42302 ; HL=the hit man's hit points (42302)
 44790 DEC (HL) ; One hit
 44791 JR NZ,44797 ; Still alive
 44793 LD (HL),4 ; Reset the counter (he has taken 4 hits)
 44795 LD A,1 ; A=1: he is dead
 44797 LD (42330),A ; Record whether he is dead
 44800 JR 44834 ; Carry on
 44802 LD A,(42332) ; A=has the hit man's bullet landed?
 44805 AND A ; Test it
 44806 JR Z,44883 ; No: finished
 44808 XOR A ; A=0
 44809 LD (42332),A ; Clear the flag
 44812 LD IX,42453 ; IX=Mugsy's record
 44816 CALL 44525 ; Is the bullet touching him?
 44819 AND A ; Test it
 44820 JR Z,44831 ; No
 44822 XOR A ; A=0
 44823 LD HL,42301 ; HL=Mugsy's hit points (42301)
 44826 DEC (HL) ; One hit
 44827 JR NZ,44831 ; Still alive
 44829 LD A,1 ; A=1: Mugsy is dead
 44831 LD (42329),A ; Record whether Mugsy is dead
 44834 LD IX,42375 ; IX=bystander 1's record
 44838 CALL 44525 ; Is a bullet touching him?
 44841 LD (42327),A ; Record it
 44844 LD IX,42414 ; IX=bystander 2's record
 44848 CALL 44525 ; Is a bullet touching him?
 44851 LD (42328),A ; Record it
 44854 AND A ; Test it
 44855 JR Z,44867 ; No
 44857 LD HL,42251 ; HL=bystander 2's timer
 44860 LD A,(HL) ; A=his timer
 44861 CP 2 ; Is it 2?
 44863 JR NZ,44867 ; No
 44865 LD (HL),1 ; Make him ready
 44867 LD A,(42327) ; A=is bystander 1 hit?
 44870 AND A ; Test it
 44871 JR Z,44883 ; No
 44873 LD HL,42250 ; HL=his timer
 44876 LD A,(HL) ; A=his timer
 44877 CP 2 ; Is it 2?
 44879 JR NZ,44883 ; No
 44881 LD (HL),1 ; Make him ready
 44883 RET ; Return

; Shootout: deal with a hit
c44884 LD A,(42323) ; A=has bystander 1 gone down?
 44887 AND A ; Test it
 44888 JP NZ,44909 ; Yes: look at bystander 2
 44891 LD A,(42333) ; A=the "somebody is down" flag
 44894 AND A ; Test it
 44895 RET Z ; Return if not
 44896 LD HL,(42292) ; HL=his script pointer
 44899 INC HL ; Skip a byte
 44900 LD (42292),HL ; Store it
 44903 LD HL,42250 ; HL=his timer
 44906 LD (HL),1 ; Make him ready
 44908 RET ; Return
 44909 LD A,(42324) ; A=has bystander 2 gone down?
 44912 AND A ; Test it
 44913 JP NZ,44934 ; Yes: look at the main figures
 44916 LD A,(42333) ; A=the "somebody is down" flag
 44919 AND A ; Test it
 44920 RET Z ; Return if not
 44921 LD HL,(42294) ; HL=his script pointer
 44924 INC HL ; Skip a byte
 44925 LD (42294),HL ; Store it
 44928 LD HL,42251 ; HL=his timer
 44931 LD (HL),1 ; Make him ready
 44933 RET ; Return
 44934 LD A,(42325) ; A=has Mugsy been killed?
 44937 AND A ; Test it
 44938 JR Z,44944 ; No
 44940 LD (42335),A ; Set the "shootout over" flag
 44943 RET ; Return
 44944 LD A,(42326) ; A=has the hit man been killed?
 44947 AND A ; Test it
 44948 RET Z ; No: return
 44949 LD (42335),A ; Set the "shootout over" flag
 44952 RET ; Return

; Shootout: move a figure
c44953 PUSH HL ; Save the record address
 44954 PUSH AF ; Save the direction code
 44955 CALL 45693 ; Copy the record to the workspace
 44958 CALL 45155 ; Copy the coordinates
 44961 LD HL,42336 ; HL=the workspace
 44964 POP AF ; Get the direction code back
 44965 LD B,A ; B=it
 44966 AND A ; Zero?
 44967 JR Z,44970 ; Then keep the old direction
 44969 LD (HL),B ; Store the new one
 44970 INC HL ; Next workspace byte (the animation delay)
 44971 DEC (HL) ; One tick less
 44972 JR NZ,44981 ; Not time to change frame
 44974 LD A,(42313) ; A=the frame delay
 44977 LD (HL),A ; Reload it
 44978 CALL 45122 ; Move to the next frame of the animation
 44981 INC HL ; Next workspace byte (the step counter)
 44982 DEC (HL) ; One tick less
 44983 JR NZ,45007 ; Not time to step
 44985 LD A,(42372) ; A=the step delay
 44988 LD (HL),A ; Reload it
 44989 CALL 45044 ; Is there a gun flash to remove?
 44992 JR NZ,45002 ; Yes
 44994 LD A,1 ; A=1
 44996 LD (42338),A ; Mark the figure as standing
 44999 JP 45007 ; Carry on
 45002 EX DE,HL ; DE=screen address
 45003 CALL 45423 ; Step the figure
 45006 EX DE,HL ; Back
 45007 CALL 45079 ; Update the position
 45010 LD (42353),DE ; Store the screen address
 45014 CALL 45182 ; Compute the pixel shift
 45017 CALL 45626 ; Convert to an attribute address
 45020 LD (42365),DE ; Store it
 45024 LD A,(42336) ; A=the state byte
 45027 AND 224 ; Facing left?
 45029 JR NZ,45036 ; Yes
 45031 CALL 45201 ; Draw it facing right
 45034 JR 45039 ; Done
 45036 CALL 45276 ; Draw it facing left
 45039 POP DE ; DE=the record
 45040 CALL 45702 ; Copy back
 45043 RET ; Return

; Shootout: remove the gun flash
c45044 PUSH DE ; Save DE
 45045 CALL 45626 ; Convert to an attribute address
 45048 LD A,(42336) ; A=the state byte
 45051 AND 224 ; Facing left?
 45053 JR NZ,45061 ; Yes
 45055 LD HL,96 ; HL=96
 45058 JP 45064 ; Carry on
 45061 LD HL,95 ; HL=95
 45064 ADD HL,DE ; HL=the cell ahead
 45065 LD A,58 ; A=58: furniture
 45067 LD BC,4 ; BC=4
 45070 CPI ; Look for it
 45072 JR Z,45077 ; Found
 45074 JP PE,45070 ; Keep looking
 45077 POP DE ; Restore DE
 45078 RET ; Return

; Shootout: update a figure's position
c45079 PUSH DE ; Save DE
 45080 LD HL,(42369) ; HL=the frame table position
 45083 LD A,(42336) ; A=the state byte
 45086 LD B,A ; B=it
 45087 AND 224 ; Facing left?
 45089 JR NZ,45099 ; Yes
 45091 LD A,(HL) ; A=the old state byte
 45092 AND 224 ; Facing left?
 45094 LD (HL),B ; Store the new state
 45095 JR NZ,45105 ; It was facing left
 45097 JR 45111 ; Carry on
 45099 LD A,(HL) ; A=the old state
 45100 AND 224 ; Facing left?
 45102 LD (HL),B ; Store the new state
 45103 JR NZ,45111 ; Same direction
 45105 INC HL ; Next byte
 45106 LD A,(HL) ; A=the frame count
 45107 DEC HL ; Back to the first byte
 45108 CALL 45353 ; Move to the next frame
 45111 INC HL ; Skip a byte
 45112 INC HL ; And another
 45113 LD E,(HL) ; E=graphic address, low byte
 45114 INC HL ; Next byte
 45115 LD D,(HL) ; D=high byte
 45116 LD (42355),DE ; Store the graphic address
 45120 POP DE ; Restore DE
 45121 RET ; Return

; Shootout: move to the next figure slot
c45122 PUSH HL ; Save HL
 45123 LD A,(42371) ; A=frame counter
 45126 LD HL,(42369) ; HL=the frame table pointer
 45129 DEC A ; One frame less
 45130 JR Z,45141 ; None left: wrap round
 45132 INC HL ; Next frame (4 bytes)
 45133 INC HL ; ...
 45134 INC HL ; ...
 45135 INC HL ; ...
 45136 LD (42369),HL ; Store the pointer
 45139 JR 45150 ; Carry on
 45141 LD HL,(42309) ; HL=the start of the table
 45144 LD (42369),HL ; Store the pointer
 45147 LD A,(42312) ; A=the number of frames
 45150 LD (42371),A ; Store the counter
 45153 POP HL ; Restore HL
 45154 RET ; Return

; Shootout: copy the current figure's coordinates
c45155 LD HL,(42365) ; HL=the figure's attribute address
 45158 LD (42349),HL ; Store it
 45161 LD DE,(42353) ; DE=the figure's screen address
 45165 LD (42339),DE ; Store it
 45169 LD A,(42358) ; A=the pixel shift
 45172 LD (42344),A ; Store it
 45175 LD A,(42357) ; A=the pixel width
 45178 LD (42343),A ; Store it
 45181 RET ; Return

; Shootout: compute a figure's pixel shift
c45182 LD A,D ; A=the high byte of the screen address
 45183 AND 7 ; Pixel row within a character (0-7)
 45185 LD B,A ; B=it
 45186 LD A,8 ; A=8
 45188 SUB B ; A=8 minus the row
 45189 LD (42358),A ; Store the pixel shift
 45192 LD B,A ; B=it
 45193 LD A,(42373) ; A=the figure's height in pixels
 45196 SUB B ; A=height minus the shift
 45197 LD (42357),A ; Store it
 45200 RET ; Return

; Shootout: draw a figure (masked)
c45201 LD B,0 ; B=0
 45203 LD A,255 ; A=255
 45205 EX AF,AF' ; Keep it in A'
 45206 LD A,32 ; A=32: 32 rows to copy
 45208 LD HL,(42355) ; HL=the figure's graphic
 45211 LD DE,(42307) ; DE=the frame buffer
 45215 EX AF,AF' ; Get the row counter
 45216 LD C,2 ; C=2: two bytes per row
 45218 LDI ; Copy a row of two bytes
 45220 JP PE,45218 ; Loop for each byte
 45223 LD (DE),A ; Add a blank byte
 45224 INC DE ; Next byte in the buffer
 45225 EX AF,AF' ; Save the counter
 45226 DEC A ; One row less
 45227 JR NZ,45215 ; Loop for 32 rows
 45229 LD HL,(42307) ; HL=the frame buffer
 45232 LD (42355),HL ; The buffer is the graphic now
 45235 LD A,(42373) ; A=the number of cells
 45238 LD E,A ; E=it
 45239 LD A,(42374) ; A=the width in bytes
 45242 LD C,A ; C=it
 45243 LD A,(42338) ; A=the pixel shift
 45246 LD B,A ; B=it
 45247 LD A,4 ; A=4
 45249 SUB B ; 4 minus the shift
 45250 ADD A,A ; Double it
 45251 JR Z,45275 ; Nothing to shift
 45253 SCF ; Set the carry flag
 45254 LD D,A ; D=the shift count
 45255 LD B,C ; B=the width
 45256 PUSH HL ; Save the row start
 45257 RR (HL) ; Shift a byte right
 45259 INC HL ; Next byte
 45260 DJNZ 45257 ; Repeat for the whole row
 45262 LD (42305),HL ; Remember the position reached
 45265 POP HL ; Restore the row start
 45266 DEC D ; One shift less
 45267 JR NZ,45255 ; Repeat
 45269 LD HL,(42305) ; HL=the position reached
 45272 DEC E ; One row less
 45273 JR NZ,45254 ; Repeat
 45275 RET ; Return

; Shootout: erase a figure
c45276 LD B,0 ; B=0
 45278 LD A,255 ; A=255
 45280 EX AF,AF' ; Keep it in A'
 45281 LD A,32 ; A=32: 32 rows to copy
 45283 LD HL,(42355) ; HL=the figure's graphic
 45286 LD DE,(42307) ; DE=the frame buffer
 45290 EX AF,AF' ; Get the row counter
 45291 LD (DE),A ; Start with a blank byte
 45292 INC DE ; Next byte
 45293 LD C,2 ; C=2: two bytes per row
 45295 LDI ; Copy a row of two bytes
 45297 JP PE,45295 ; Loop for each byte
 45300 EX AF,AF' ; Save the counter
 45301 DEC A ; One row less
 45302 JR NZ,45290 ; Loop for 32 rows
 45304 LD HL,(42307) ; HL=the frame buffer
 45307 LD (42355),HL ; The buffer is the graphic now
 45310 DEC DE ; Back one byte
 45311 EX DE,HL ; HL=the end of the buffer
 45312 LD A,(42373) ; A=the number of cells
 45315 LD E,A ; E=it
 45316 LD A,(42374) ; A=the width in bytes
 45319 LD C,A ; C=it
 45320 LD A,(42338) ; A=the pixel shift
 45323 LD B,A ; B=it
 45324 LD A,4 ; A=4
 45326 SUB B ; 4 minus the shift
 45327 ADD A,A ; Double it
 45328 JR Z,45352 ; Nothing to shift
 45330 SCF ; Set the carry flag
 45331 LD D,A ; D=the shift count
 45332 LD B,C ; B=the width
 45333 PUSH HL ; Save the row end
 45334 RL (HL) ; Shift a byte left
 45336 DEC HL ; Previous byte
 45337 DJNZ 45334 ; Repeat for the whole row
 45339 LD (42305),HL ; Remember the position reached
 45342 POP HL ; Restore the row end
 45343 DEC D ; One shift less
 45344 JR NZ,45332 ; Repeat
 45346 LD HL,(42305) ; HL=the position reached
 45349 DEC E ; One row less
 45350 JR NZ,45331 ; Repeat
 45352 RET ; Return

; Shootout: get the next animation frame
c45353 PUSH HL ; Save the record address
 45354 INC HL ; Skip the state and counters...
 45355 INC HL ; ...to the frame table pointer
 45356 LD E,(HL) ; E=the frame table address, low byte
 45357 INC HL ; Next byte
 45358 LD D,(HL) ; D=high byte
 45359 EX DE,HL ; HL=the frame table address
 45360 LD C,A ; C=the number of frames
 45361 LD D,(HL) ; D=a byte of the frame table
 45362 RR D ; Shift the next bit out of D
 45364 RLA ; and into A (this reverses the bits)
 45365 RR D ; Shift the next bit out of D
 45367 RLA ; and into A (this reverses the bits)
 45368 RR D ; Shift the next bit out of D
 45370 RLA ; and into A (this reverses the bits)
 45371 RR D ; Shift the next bit out of D
 45373 RLA ; and into A (this reverses the bits)
 45374 RR D ; Shift the next bit out of D
 45376 RLA ; and into A (this reverses the bits)
 45377 RR D ; Shift the next bit out of D
 45379 RLA ; and into A (this reverses the bits)
 45380 RR D ; Shift the next bit out of D
 45382 RLA ; and into A (this reverses the bits)
 45383 RR D ; Shift the next bit out of D
 45385 RLA ; and into A (this reverses the bits)
 45386 LD B,A ; B=the reversed byte
 45387 INC HL ; Next byte
 45388 LD D,(HL) ; D=the next byte
 45389 RR D ; Shift the next bit out of D
 45391 RLA ; and into A (this reverses the bits)
 45392 RR D ; Shift the next bit out of D
 45394 RLA ; and into A (this reverses the bits)
 45395 RR D ; Shift the next bit out of D
 45397 RLA ; and into A (this reverses the bits)
 45398 RR D ; Shift the next bit out of D
 45400 RLA ; and into A (this reverses the bits)
 45401 RR D ; Shift the next bit out of D
 45403 RLA ; and into A (this reverses the bits)
 45404 RR D ; Shift the next bit out of D
 45406 RLA ; and into A (this reverses the bits)
 45407 RR D ; Shift the next bit out of D
 45409 RLA ; and into A (this reverses the bits)
 45410 RR D ; Shift the next bit out of D
 45412 RLA ; and into A (this reverses the bits)
 45413 LD (HL),B ; Store the second byte
 45414 DEC HL ; Back one byte
 45415 LD (HL),A ; Store the first
 45416 INC HL ; Forward
 45417 INC HL ; And on to the next pair
 45418 DEC C ; One frame less
 45419 JR NZ,45361 ; Loop for every frame
 45421 POP HL ; Restore the record address
 45422 RET ; Return

; Shootout: step a figure in its current direction
c45423 LD A,L ; A=the figure's screen address, low byte
 45424 AND 31 ; Column bits
 45426 LD E,A ; E=the column
 45427 LD A,L ; A=the low byte again
 45428 AND 224 ; Row bits
 45430 LD D,A ; D=the row
 45431 LD A,(42336) ; A=the direction code
 45434 CP 4 ; Right?
 45436 JR NZ,45454 ; No

; Shootout: move right one cell (unless at column 28)
c45438 LD A,28 ; A=28: the right-hand column limit
 45440 CP E ; Is the figure there?
 45441 JR NZ,45452 ; No
 45443 LD A,1 ; A=1
 45445 LD (42338),A ; Stop the figure
 45448 LD (42322),A ; Report that it could not move
 45451 RET ; Return
 45452 INC L ; Move one column right
 45453 RET ; Return
 45454 CP 64 ; Left?
 45456 JR NZ,45475 ; No

; Shootout: move left one cell (unless at the left limit)
c45458 LD A,(42314) ; A=the left limit
 45461 CP E ; Is the figure there?
 45462 JR NZ,45473 ; No
 45464 LD A,1 ; A=1
 45466 LD (42338),A ; Stop the figure
 45469 LD (42322),A ; Report that it could not move
 45472 RET ; Return
 45473 DEC L ; Move one column left
 45474 RET ; Return
 45475 CP 1 ; Up?
 45477 JR NZ,45511 ; No

; Shootout: move up one pixel row (unless at the top limit)
c45479 PUSH HL ; Save the address
 45480 PUSH DE ; Save the row
 45481 LD L,D ; L=the row
 45482 LD DE,(42298) ; DE=the upper limit
 45486 AND A ; Clear the carry flag
 45487 SBC HL,DE ; Compare with the limit
 45489 POP DE ; Restore the row
 45490 POP HL ; Restore the address
 45491 JR NZ,45494 ; Not at the limit
 45493 RET ; At the top: no move
 45494 DEC H ; Up a pixel row
 45495 CALL 45636 ; Fix up across character boundaries
 45498 DEC H ; Up another
 45499 CALL 45636 ; Fix up
 45502 DEC H ; Up another
 45503 CALL 45636 ; Fix up
 45506 DEC H ; Up another
 45507 CALL 45636 ; Fix up
 45510 RET ; Return
 45511 CP 16 ; Down?
 45513 JR NZ,45547 ; No

; Shootout: move down one pixel row (unless at the bottom limit)
c45515 PUSH HL ; Save the address
 45516 PUSH DE ; Save the row
 45517 LD L,D ; L=the row
 45518 EX DE,HL ; DE=the row
 45519 LD HL,20576 ; HL=the lower limit (20576)
 45522 AND A ; Clear the carry flag
 45523 SBC HL,DE ; Compare
 45525 POP DE ; Restore the row
 45526 POP HL ; Restore the address
 45527 JR NZ,45530 ; Not at the limit
 45529 RET ; At the bottom: no move
 45530 INC H ; Down a pixel row
 45531 CALL 45651 ; Fix up across character boundaries
 45534 INC H ; Down another
 45535 CALL 45651 ; Fix up
 45538 INC H ; Down another
 45539 CALL 45651 ; Fix up
 45542 INC H ; Down another
 45543 CALL 45651 ; Fix up
 45546 RET ; Return
 45547 CP 128 ; Up and left?
 45549 JR NZ,45567 ; No
 45551 XOR A ; A=0
 45552 LD (42322),A ; Clear the "could not move" flag
 45555 CALL 45458 ; Move left
 45558 LD A,(42322) ; A=the flag
 45561 AND A ; Test it
 45562 RET NZ ; Could not move: return
 45563 CALL 45479 ; Move up
 45566 RET ; Return
 45567 CP 2 ; Up and right?
 45569 JR NZ,45587 ; No
 45571 XOR A ; A=0
 45572 LD (42322),A ; Clear the flag
 45575 CALL 45438 ; Move right
 45578 LD A,(42322) ; A=the flag
 45581 AND A ; Test it
 45582 RET NZ ; Could not move: return
 45583 CALL 45479 ; Move up
 45586 RET ; Return
 45587 CP 32 ; Down and left?
 45589 JR NZ,45607 ; No
 45591 XOR A ; A=0
 45592 LD (42322),A ; Clear the flag
 45595 CALL 45458 ; Move left
 45598 LD A,(42322) ; A=the flag
 45601 AND A ; Test it
 45602 RET NZ ; Could not move: return
 45603 CALL 45515 ; Move down
 45606 RET ; Return
 45607 CP 8 ; Down and right?
 45609 RET NZ ; No: return
 45610 XOR A ; A=0
 45611 LD (42322),A ; Clear the flag
 45614 CALL 45438 ; Move right
 45617 LD A,(42322) ; A=the flag
 45620 AND A ; Test it
 45621 RET NZ ; Could not move: return
 45622 CALL 45515 ; Move down
 45625 RET ; Return

; Convert a display file address in DE into an attribute address
c45626 LD A,D ; A=the high byte of the display address
 45627 AND 24 ; Which third of the screen (0-2)?
 45629 RRA ; Divide by 8...
 45630 RRA ; ...to...
 45631 RRA ; ...get it into bits 0-1
 45632 OR 88 ; Add the base of the attribute file (88*256=22528)
 45634 LD D,A ; D=the high byte of the attribute address
 45635 RET ; Return

; Move HL up one pixel row
c45636 LD A,H ; A=the high byte
 45637 CPL ; Invert it
 45638 AND 7 ; Pixel row within a character (inverted)
 45640 RET NZ ; Return if not at the top of a character
 45641 LD A,L ; A=the low byte
 45642 SUB 32 ; Up one character row
 45644 LD L,A ; L=it
 45645 RET C ; Return if that did not cross a third
 45646 LD A,H ; A=the high byte
 45647 ADD A,8 ; Up one third
 45649 LD H,A ; H=it
 45650 RET ; Return

; Move HL down one pixel row
c45651 LD A,H ; A=the high byte
 45652 AND 7 ; Pixel row within a character
 45654 RET NZ ; Return if still inside a character
 45655 LD A,32 ; A=32
 45657 ADD A,L ; Down one character row
 45658 LD L,A ; L=it
 45659 RET C ; Return if that did not cross a third
 45660 LD A,H ; A=the high byte
 45661 SUB 8 ; Down one third
 45663 LD H,A ; H=it
 45664 RET ; Return

; Shootout: clear the screen
c45665 LD HL,16384 ; HL=the start of the display file
 45668 LD DE,16385 ; DE=the next byte
 45671 LD BC,6143 ; BC=6143
 45674 XOR A ; A=0
 45675 LD (HL),A ; Clear the first byte
 45676 LDIR ; Clear the rest of the pixels
 45678 LD HL,22528 ; HL=the start of the attributes
 45681 LD DE,22529 ; DE=the next byte
 45684 LD BC,767 ; BC=767
 45687 LD A,56 ; A=56: white paper, black ink
 45689 LD (HL),A ; Set the first attribute
 45690 LDIR ; Set the rest of the attributes
 45692 RET ; Return

; Shootout: copy a figure's 39-byte record into the workspace at #R42336
c45693 LD DE,42336 ; DE=the workspace (#R42336)
 45696 LD BC,39 ; BC=39 bytes
 45699 LDIR ; Copy the record into the workspace
 45701 RET ; Return

; Shootout: copy the workspace at #R42336 back into a figure's record
c45702 LD HL,42336 ; HL=the workspace (#R42336)
 45705 LD BC,39 ; BC=39 bytes
 45708 LDIR ; Copy it back into the record
 45710 RET ; Return

