; Interrupt routine for the shootout: the sprite scheduler
;
; Runs fifty times a second. For each figure whose timer is 0 it counts down the figure's countdown; when that reaches zero it points SP at the figure's record and uses POP to load HL, DE, BC and IY from it, then jumps to IY: a sprite drawing routine (#R45965, #R46031, #R46119 or #R46196) that draws the figure with the registers already set up. The drawing routines pass control on through #R48601 and finish at #R48617, which restores the real stack and sets the timer to 1. The routine ends by reading the keyboard.
@label=ISR2
c48539 PUSH AF ; Save AF
 48540 PUSH BC ; Save BC
 48541 PUSH DE ; Save DE
 48542 PUSH HL ; Save HL
 48543 PUSH IX ; Save IX
 48545 PUSH IY ; Save IY
 48547 LD HL,42250 ; HL=the figure timers
 48550 LD A,(42311) ; A=the number of figures in use
 48553 LD B,A ; B=the count
 48554 LD C,0 ; C=0: the figure number
 48556 LD A,(HL) ; A=this figure's timer
 48557 AND A ; Test it
 48558 JR NZ,48622 ; Not zero: the figure is idle or waiting for orders
 48560 PUSH BC ; Save the counters
 48561 PUSH HL ; Save the timer pointer
 48562 LD HL,42257 ; HL=the table of countdown pointers (#R42257)
 48565 LD B,0 ; B=0
 48567 RL C ; C=the figure number*2
 48569 ADD HL,BC ; HL=its entry
 48570 LD E,(HL) ; E=the countdown address, low byte
 48571 INC HL ; Next byte
 48572 LD D,(HL) ; D=high byte
 48573 EX DE,HL ; HL=the countdown address
 48574 DEC (HL) ; One tick less
 48575 JR Z,48582 ; Reached zero: draw the figure
 48577 POP HL ; Restore the timer pointer
 48578 LD (HL),255 ; Set the timer to 255 so that the INC below leaves it at 0
 48580 JR 48620 ; Next figure
 48582 INC HL ; Next byte: the sprite job pointer
 48583 LD E,(HL) ; E=the low byte
 48584 INC HL ; Next byte
 48585 LD D,(HL) ; D=the high byte
 48586 EX DE,HL ; HL=the sprite job (a block of register values)
 48587 LD IX,0 ; IX=0
 48591 ADD IX,SP ; IX=the stack pointer
 48593 LD SP,HL ; SP=the sprite job
 48594 POP HL ; HL=the first register pair from the job
 48595 POP DE ; DE=the second pair
 48596 POP BC ; BC=the third pair
 48597 POP IY ; IY=the address of the drawing routine
 48599 JP (IY) ; Run the drawing routine (it finishes with a jump to #R48601 or #R48617)
 48601 EXX ; Switch to the alternate registers
 48602 POP HL ; HL'=the next value from the job
 48603 POP DE ; DE'=the next value
 48604 EXX ; Back to the main registers
 48605 POP BC ; BC=the next value
 48606 POP HL ; HL=the next value
 48607 POP IY ; IY=the next routine
 48609 LD (42303),SP ; Remember the stack pointer
 48613 LD SP,HL ; SP=the job's saved-background area
 48614 INC SP ; Step past the last byte
 48615 JP (IY) ; Run the second routine (it finishes with a jump to #R48617)
 48617 LD SP,IX ; Restore the real stack pointer
 48619 POP HL ; Restore the timer pointer
 48620 POP BC ; Restore the counters
 48621 INC (HL) ; Timer: 0 becomes 1 (the figure is ready for orders)
 48622 INC HL ; Next timer
 48623 INC C ; Next figure
 48624 DJNZ 48556 ; Loop for all the figures
 48626 CALL 46460 ; Read the keyboard
 48629 POP IY ; Restore IY
 48631 POP IX ; Restore IX
 48633 POP HL ; Restore HL
 48634 POP DE ; Restore DE
 48635 POP BC ; Restore BC
 48636 POP AF ; Restore AF
 48637 EI ; Enable interrupts
 48638 RET ; Return from the interrupt

; Padding before the dictionary
;
; A single zero byte (a NOP) after the interrupt routine. It brings the dictionary to #R48640, which is 190 x 256, so that the dictionary starts on a page boundary; dictionary references are a page number plus an offset (see #R29928).
b48639 DEFB 0 ; Padding

; Dictionary
;
; The 225 words that Louey's messages are built from, 1006 bytes in all, in alphabetical order. A message refers to a word by a page number (0-4) and an offset (#R29928 adds them to #R48640), or, for the 32 commonest, by a single byte (the table at #R49710). The block starts with a letter index of 32 two-byte entries (64 bytes); the words follow.
; .
; Each letter takes one byte: the low five bits are the letter (1 = a to 26 = z; 27 to 31 are the punctuation marks ' - ! ? and ") and the top bits are mostly ignored. Bit 7 marks the last letter of a word, but only from the third letter on, so no word is cut short at two letters. A short word is closed by a byte whose letter is 0. Each line below is one word, with its offset from #R48640 (the number a message uses; the page is the offset divided by 256).
; .
; The game never reads the letter index: it finds words only through the references. It looks like a by-product of the tool that built the dictionary. 9 words are never referred to by any message: "fin", "fun", "lea", "liv", "min", "per", "pre", "some", "the".
b48640 DEFB 0,0 ; Index: unused
 48642 DEFB 64,0 ; Index: offset 64, the first word beginning with "a" ("a")
 48644 DEFB 140,0 ; Index: offset 140, the first word beginning with "b" ("bad")
