 35077 LD A,E ; A=the low byte
 35078 AND 31 ; Column
 35080 CP 3 ; Column 3?
 35082 JR NZ,35086 ; No
 35084 RES 7,D ; Clear the left-clip flag: the car has come into view
 35086 LD (38789),DE ; Store the new position
 35090 LD BC,455 ; BC=455 bytes
 35093 LD D,H ; DE=the buffer
 35094 LD E,L ; ...
 35095 INC HL ; HL=the next byte
