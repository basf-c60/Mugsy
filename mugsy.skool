; Shootout: XOR a sprite onto the screen
c45965 LD A,(DE) ; Fetch a byte of the graphic (the graphic is read backwards, from DE)
 45966 XOR (HL) ; Combine it with the screen byte
 45967 LD (HL),A ; Draw it
 45968 DEC DE ; Back one byte in the graphic
 45969 INC L ; Next screen byte to the right
 45970 LD A,(DE) ; Fetch the next graphic byte
 45971 XOR (HL) ; Combine it with the screen
 45972 LD (HL),A ; Draw it
 45973 DEC DE ; Back one byte in the graphic
 45974 DEC L ; Back to the left-hand column
 45975 INC H ; Down a pixel row (within the character)
 45976 DJNZ 45965 ; Loop for B pixel rows
 45978 LD A,C ; A=C: pixel rows left to do
 45979 AND A ; Test it
 45980 JR Z,46007 ; None left: finish the job
 45982 SUB 8 ; Subtract eight rows (one character row)
 45984 LD B,8 ; B=8: a full character
 45986 LD C,A ; C=the rows left
 45987 JR NC,45994 ; At least eight were left
 45989 ADD A,8 ; Add the eight back
 45991 LD B,A ; B=what is left
 45992 LD C,0 ; C=0: that is the last block
 45994 LD A,32 ; A=32
 45996 ADD A,L ; Move down one character row
 45997 LD L,A ; L=the new low byte
 45998 JR C,45965 ; Still in the same third: draw the next block
 46000 LD A,H ; Crossed into the next third: A=the high byte
 46001 SUB 8 ; Down 8 in the high byte
 46003 LD H,A ; H=it
 46004 JP 45965 ; Draw the next block
 46007 POP DE ; Restore the attribute address
 46008 POP HL ; Restore the screen address
 46009 POP AF ; Restore the attribute count
 46010 LD BC,32 ; BC=32: one row of attributes
 46013 EX AF,AF' ; Save the row counter
 46014 LD A,(DE) ; A=an attribute byte (the attributes are read backwards too)
 46015 LD (HL),A ; Set it
 46016 DEC DE ; Back one byte
 46017 INC L ; Next cell
 46018 LD A,(DE) ; A=the next attribute
 46019 LD (HL),A ; Set it
 46020 DEC DE ; Back one byte
 46021 EX AF,AF' ; Get the row counter
 46022 DEC A ; One row less
 46023 JP Z,48601 ; All done: go on to the second half of the job
 46026 DEC L ; Back to the first column
 46027 ADD HL,BC ; Down one attribute row
 46028 JP 46013 ; Next row
 46031 EXX ; Use the alternate registers for the mask pointers
 46032 LD A,(DE) ; A=a mask byte
 46033 OR (HL) ; Combine with the screen byte
 46034 CPL ; Invert it (this gives the screen bits to keep)
 46035 LD B,A ; B=the bits that will be changed
 46036 OR (HL) ; Combine with the screen byte again
 46037 LD (HL),A ; Put the byte back with the mask bits set to 1
 46038 INC DE ; Next mask byte
 46039 INC L ; Next screen byte
 46040 LD A,(DE) ; A=the next mask byte
 46041 OR (HL) ; Combine with the screen byte
 46042 CPL ; Invert it
 46043 LD C,A ; C=the bits that will be changed
 46044 OR (HL) ; Combine with the screen byte
 46045 LD (HL),A ; Set the mask bits
 46046 INC DE ; Next mask byte
 46047 PUSH BC ; Save the old screen bits on the stack
 46048 DEC L ; Back to the first column
 46049 INC H ; Down a pixel row
 46050 EXX ; Back to the main registers
 46051 DJNZ 46031 ; Loop for B pixel rows
 46053 LD A,C ; A=C: pixel rows left
 46054 AND A ; Test it
 46055 JR Z,46083 ; None left: restore the attributes
 46057 SUB 8 ; Subtract eight rows
 46059 LD B,8 ; B=8
 46061 LD C,A ; C=the rows left
 46062 JR NC,46069 ; At least eight were left
 46064 ADD A,8 ; Add the eight back
 46066 LD B,A ; B=what is left
 46067 LD C,0 ; C=0
 46069 EXX ; Alternate registers again
 46070 LD A,32 ; A=32
 46072 ADD A,L ; Down one character row
 46073 LD L,A ; L=the new low byte
 46074 JR C,46032 ; Same third: continue
 46076 LD A,H ; A=the high byte
 46077 SUB 8 ; Down one third
 46079 LD H,A ; H=it
 46080 JP 46032 ; Continue
 46083 LD SP,(42303) ; Restore the stack pointer used by the background buffer
 46087 POP HL ; HL=where the saved screen bytes begin
 46088 POP DE ; DE=the attribute address
 46089 POP BC ; BC=the attribute colour and count
 46090 LD SP,HL ; SP=the saved-background pointer
 46091 INC SP ; Step past the last byte saved
 46092 EX DE,HL ; HL=the attribute address
 46093 LD A,(HL) ; A=an attribute byte
 46094 LD D,A ; D=it
 46095 AND 248 ; Keep the paper, bright and flash bits and clear the ink
 46097 OR B ; Set the ink colour from B
 46098 LD (HL),A ; Store it
 46099 INC L ; Next cell
 46100 LD A,(HL) ; A=the next attribute
 46101 LD E,A ; E=it
 46102 AND 248 ; Keep the paper, bright and flash bits and clear the ink
 46104 OR B ; Set the ink colour from B
 46105 LD (HL),A ; Store it
 46106 PUSH DE ; Save the old attributes on the stack
 46107 DEC C ; One row less
 46108 JP Z,48617 ; All done: finish the job
 46111 DEC L ; Back a column
 46112 LD DE,32 ; DE=32
 46115 ADD HL,DE ; Down one row
 46116 JP 46093 ; Next row
 46119 LD A,(DE) ; Fetch a byte of the graphic
 46120 XOR (HL) ; Combine with the screen
 46121 LD (HL),A ; Draw it
 46122 DEC DE ; Back a byte
 46123 INC L ; Next column
 46124 LD A,(DE) ; Fetch the next byte
 46125 XOR (HL) ; Combine with the screen
 46126 LD (HL),A ; Draw it
 46127 DEC DE ; Back a byte
 46128 INC L ; Next column
 46129 LD A,(DE) ; Fetch the third byte
 46130 XOR (HL) ; Combine with the screen
 46131 LD (HL),A ; Draw it
 46132 DEC DE ; Back a byte
 46133 DEC L ; Back to the first column
 46134 DEC L ; (two columns)
 46135 INC H ; Down a pixel row
 46136 DJNZ 46119 ; Loop for B pixel rows
 46138 LD A,C ; A=C: pixel rows left
 46139 AND A ; Test it
 46140 JR Z,46167 ; None left: restore the attributes
 46142 SUB 8 ; Subtract eight rows
 46144 LD B,8 ; B=8
 46146 LD C,A ; C=the rows left
 46147 JR NC,46154 ; At least eight were left
 46149 ADD A,8 ; Add the eight back
 46151 LD B,A ; B=what is left
 46152 LD C,0 ; C=0
 46154 LD A,32 ; A=32
 46156 ADD A,L ; Down one character row
 46157 LD L,A ; L=the new low byte
 46158 JR C,46119 ; Same third: continue
 46160 LD A,H ; A=the high byte
 46161 SUB 8 ; Down one third
 46163 LD H,A ; H=it
 46164 JP 46119 ; Continue
 46167 POP DE ; Restore the attribute address
 46168 POP HL ; Restore the screen address
 46169 POP AF ; Restore the attribute count
 46170 LD BC,32 ; BC=32
 46173 EX AF,AF' ; Save the row counter
 46174 LD A,(DE) ; A=an attribute byte
 46175 LD (HL),A ; Set it
 46176 DEC DE ; Back one byte
 46177 INC L ; Next cell
 46178 LD A,(DE) ; A=the next attribute
 46179 LD (HL),A ; Set it
 46180 DEC DE ; Back one byte
 46181 INC L ; Next cell
 46182 LD A,(DE) ; A=the third attribute
 46183 LD (HL),A ; Set it
 46184 DEC DE ; Back one byte
 46185 EX AF,AF' ; Get the row counter
 46186 DEC A ; One row less
 46187 JP Z,48601 ; All done: go on to the second half of the job
 46190 DEC L ; Back a cell
 46191 DEC L ; Back another
 46192 ADD HL,BC ; Down one attribute row
 46193 JP 46173 ; Next row
 46196 EXX ; Alternate registers
 46197 LD A,(DE) ; A=a mask byte
 46198 OR (HL) ; Combine with the screen
 46199 CPL ; Invert it
 46200 LD B,A ; B=the bits that will change
 46201 OR (HL) ; Combine with the screen
 46202 LD (HL),A ; Draw it
 46203 INC DE ; Next mask byte
 46204 INC L ; Next column
 46205 LD A,(DE) ; A=the next mask byte
 46206 OR (HL) ; Combine with the screen
 46207 CPL ; Invert it
 46208 LD C,A ; C=the bits that will change
 46209 OR (HL) ; Combine with the screen
 46210 LD (HL),A ; Draw it
 46211 INC DE ; Next mask byte
 46212 INC L ; Next column
 46213 PUSH BC ; Save the old bits on the stack
 46214 LD A,(DE) ; A=the third mask byte
 46215 OR (HL) ; Combine with the screen
 46216 CPL ; Invert it
 46217 LD B,A ; B=the bits that will change
 46218 OR (HL) ; Combine with the screen
 46219 LD (HL),A ; Draw it
 46220 INC DE ; Next mask byte
 46221 PUSH BC ; Save the old bits on the stack
 46222 INC SP ; Move the stack pointer back a byte
 46223 DEC L ; Back a column
 46224 DEC L ; And another
 46225 INC H ; Down a pixel row
 46226 EXX ; Main registers again
 46227 DJNZ 46196 ; Loop for B pixel rows
 46229 LD A,C ; A=C: pixel rows left
 46230 AND A ; Test it
 46231 JR Z,46259 ; None left: restore the attributes
 46233 SUB 8 ; Subtract eight rows
 46235 LD B,8 ; B=8
 46237 LD C,A ; C=the rows left
 46238 JR NC,46245 ; At least eight were left
 46240 ADD A,8 ; Add the eight back
 46242 LD B,A ; B=what is left
 46243 LD C,0 ; C=0
 46245 EXX ; Alternate registers
 46246 LD A,32 ; A=32
 46248 ADD A,L ; Down one character row
 46249 LD L,A ; L=the new low byte
 46250 JR C,46197 ; Same third: continue
 46252 LD A,H ; A=the high byte
 46253 SUB 8 ; Down one third
 46255 LD H,A ; H=it
 46256 JP 46197 ; Continue
 46259 LD SP,(42303) ; Restore the stack pointer used by the background buffer
 46263 POP HL ; HL=where the saved screen bytes begin
 46264 POP DE ; DE=the attribute address
 46265 POP BC ; BC=the attribute colour and count
 46266 LD SP,HL ; SP=the saved-background pointer
 46267 INC SP ; Step past the last byte saved
 46268 EX DE,HL ; HL=the attribute address
 46269 LD A,(HL) ; A=an attribute byte
 46270 LD D,A ; D=it
 46271 AND 248 ; Keep the paper, bright and flash bits and clear the ink
 46273 OR B ; Set the ink colour from B
 46274 LD (HL),A ; Store it
 46275 INC L ; Next cell
 46276 LD A,(HL) ; A=the next attribute
 46277 LD E,A ; E=it
 46278 AND 248 ; Keep the paper, bright and flash bits and clear the ink
 46280 OR B ; Set the ink colour from B
 46281 LD (HL),A ; Store it
 46282 INC L ; Next cell
 46283 PUSH DE ; Save the old attributes on the stack
 46284 LD A,(HL) ; A=the third attribute
 46285 LD D,A ; D=it
 46286 AND 248 ; Keep the paper, bright and flash bits and clear the ink
 46288 OR B ; Set the ink colour from B
 46289 LD (HL),A ; Store it
 46290 PUSH DE ; Save the old attributes on the stack
 46291 INC SP ; Move the stack pointer back a byte
 46292 DEC C ; One row less
 46293 JP Z,48617 ; All done: finish the job
 46296 DEC L ; Back a column
 46297 DEC L ; And another
 46298 LD DE,32 ; DE=32
 46301 ADD HL,DE ; Down one row
 46302 JP 46269 ; Next row

; Shootout: draw the walls of the restaurant
c46305 CALL 45665 ; Clear the screen to white paper
 46308 LD A,95 ; A=95: the starting y coordinate
 46310 LD C,0 ; C=0: the starting x coordinate
 46312 LD D,255 ; D=255: y changes by -1 each step
 46314 LD E,1 ; E=1: x changes by +1 each step
 46316 LD B,41 ; B=41 points
 46318 CALL 46428 ; Plot a diagonal line (the left wall in perspective)
 46321 LD B,27 ; B=27 bytes
 46323 CALL 46454 ; Draw a horizontal line (the back wall's base) along the row HL points at
 46326 LD A,54 ; A=54: the starting y
 46328 LD C,40 ; C=40: the starting x
 46330 LD D,255 ; D=255: y changes by -1
 46332 LD E,0 ; E=0: x does not change
 46334 LD B,54 ; B=54 points
 46336 CALL 46428 ; Plot a vertical line (a wall edge)
 46339 LD A,90 ; A=90: the starting y
 46341 LD C,5 ; C=5: the starting x
 46343 LD D,255 ; D=255: y -1
 46345 LD E,0 ; E=0: x constant
 46347 LD B,42 ; B=42 points
 46349 CALL 46428 ; Plot a vertical line
 46352 LD A,80 ; A=80: the starting y
 46354 LD C,15 ; C=15: the starting x
 46356 LD D,255 ; D=255: y -1
 46358 LD E,0 ; E=0: x constant
 46360 LD B,42 ; B=42 points
 46362 CALL 46428 ; Plot a vertical line
 46365 LD A,39 ; A=39: the starting y
 46367 LD C,15 ; C=15: the starting x
 46369 LD D,1 ; D=1: y +1
 46371 LD E,255 ; E=255: x -1
 46373 LD B,10 ; B=10 points
 46375 CALL 46428 ; Plot a short diagonal
 46378 LD A,24 ; A=24: 24 pixel rows for the door
 46380 LD DE,16435 ; DE=16435: the door's position on the screen
 46383 PUSH DE ; Save it
 46384 LD HL,48404 ; HL=the door graphic (48404)
 46387 LD BC,5 ; BC=5 bytes per row
 46390 PUSH DE ; Save the row's address
 46391 LDIR ; Copy a row of the door onto the screen
 46393 POP DE ; Get the row's address back
 46394 INC D ; Next pixel row
 46395 EX DE,HL ; HL=the address
 46396 PUSH AF ; Save the row counter
 46397 CALL 45651 ; Fix up the address across character boundaries
 46400 POP AF ; Restore the row counter
 46401 EX DE,HL ; DE=the address
 46402 DEC A ; One row less
 46403 JR NZ,46387 ; Loop for 24 rows
 46405 POP DE ; DE=the door's screen address
 46406 CALL 45626 ; Convert it to an attribute address
 46409 LD A,3 ; A=3: three attribute rows
 46411 LD BC,5 ; BC=5 cells per row
 46414 PUSH DE ; Save the row's address
 46415 LDIR ; Set the door's attributes
 46417 POP DE ; Restore the address
 46418 LD BC,32 ; BC=32
 46421 EX DE,HL ; HL=the address
 46422 ADD HL,BC ; Down one attribute row
 46423 EX DE,HL ; DE=the address
 46424 DEC A ; One row less
 46425 JR NZ,46411 ; Loop for 3 rows
 46427 RET ; Return

; Shootout: plot a pixel
c46428 PUSH AF ; Save the counter
 46429 PUSH BC ; Save the coordinates
 46430 CALL 8880 ; Get the display address for the point from the ROM (the PIXEL-ADD routine, skipping its range check)
 46433 LD B,A ; B=the bit position
 46434 INC B ; One more than the bit position
 46435 LD A,254 ; A=%11111110
 46437 RRCA ; Rotate it to line up with the pixel...
 46438 DJNZ 46437 ; ...for B steps
 46440 CPL ; Make it the single pixel mask
 46441 OR (HL) ; Combine with the screen byte
 46442 LD (HL),A ; Plot the pixel
 46443 POP BC ; Restore the coordinates
 46444 POP AF ; Restore the counter
 46445 ADD A,D ; Add the y step
 46446 PUSH AF ; Save it
 46447 LD A,C ; A=x
 46448 ADD A,E ; Add the x step
 46449 LD C,A ; C=the new x
 46450 POP AF ; Restore y
 46451 DJNZ 46428 ; Plot B points
 46453 RET ; Return

; Shootout: draw a horizontal line
c46454 LD (HL),255 ; Set a screen byte to 255
 46456 INC L ; Next byte
 46457 DJNZ 46454 ; Loop for B bytes
 46459 RET ; Return

; Shootout: read the controls
;
; Reads Q (up), Z (down), I (left), P (right) and B/N/M (fire) and converts them to a direction code. Opposite directions pressed together cancel out.
;
; Output:A Direction code
@label=CONTROLS
c46460 LD HL,42453 ; HL=Mugsy's record (the figure the keys move)
 46463 LD C,0 ; C=0: the direction bits
 46465 LD A,223 ; Read the half-row Y U I O P
 46467 IN A,(254) ; Read the keyboard
 46469 LD B,A ; B=the key states
 46470 AND 1 ; Is P pressed?
 46472 JR NZ,46476 ; No
 46474 SET 2,C ; Set bit 2: right
 46476 LD A,B ; A=the key states
 46477 AND 4 ; Is I pressed?
 46479 JR NZ,46483 ; No
 46481 SET 6,C ; Set bit 6: left
 46483 LD A,254 ; Read the half-row CAPS Z X C V
 46485 IN A,(254) ; Read the keyboard
 46487 AND 2 ; Is Z pressed?
 46489 JR NZ,46493 ; No
 46491 SET 4,C ; Set bit 4: down
 46493 LD A,251 ; Read the half-row Q W E R T
 46495 IN A,(254) ; Read the keyboard
 46497 AND 1 ; Is Q pressed?
 46499 JR NZ,46503 ; No
 46501 SET 0,C ; Set bit 0: up
 46503 LD A,127 ; Read the half-row SPACE SYM M N B
 46505 IN A,(254) ; Read the keyboard
 46507 LD B,A ; B=the key states
 46508 AND 4 ; Is M pressed?
 46510 JR NZ,46514 ; No
 46512 SET 7,C ; Set bit 7: fire
 46514 LD A,B ; A=the key states
 46515 AND 8 ; Is N pressed?
 46517 JR NZ,46521 ; No
 46519 SET 7,C ; Set bit 7: fire
 46521 LD A,B ; A=the key states
 46522 AND 16 ; Is B pressed?
 46524 JR NZ,46528 ; No
 46526 SET 7,C ; Set bit 7: fire
 46528 LD A,C ; A=the combined bits
 46529 AND A ; Test them
 46530 JR Z,46640 ; No key pressed: no movement
 46532 LD B,A ; B=the bits
 46533 AND 17 ; Up and down together?
 46535 CP 17 ; Compare
 46537 JR Z,46640 ; Yes: they cancel
 46539 LD A,B ; A=the bits
 46540 AND 68 ; Left and right together?
 46542 CP 68 ; Compare
 46544 JR Z,46640 ; Yes: they cancel
 46546 LD A,B ; A=the bits
 46547 AND 128 ; Is fire pressed?
 46549 LD A,10 ; A=10: the code for fire
 46551 JR NZ,46641 ; Yes: use it
 46553 LD A,B ; A=the bits
 46554 AND 127 ; Drop the fire bit
 46556 LD B,A ; B=the direction bits
 46557 CP 4 ; Right?
 46559 JR Z,46641 ; Use the code
 46561 CP 64 ; Left?
 46563 JR Z,46641 ; Use the code
 46565 CP 5 ; Up and right?
 46567 LD A,2 ; A=2
 46569 JR Z,46641 ; Use the code
 46571 LD A,B ; A=the bits
 46572 CP 20 ; Down and right?
 46574 LD A,8 ; A=8
 46576 JR Z,46641 ; Use the code
 46578 LD A,B ; A=the bits
 46579 CP 65 ; Up and left?
 46581 LD A,128 ; A=128
 46583 JR Z,46641 ; Use the code
 46585 LD A,B ; A=the bits
 46586 CP 80 ; Down and left?
 46588 LD A,32 ; A=32
 46590 JR Z,46641 ; Use the code
 46592 LD A,B ; A=the bits
 46593 CP 1 ; Up only?
 46595 JR NZ,46616 ; No: try down
 46597 LD A,(HL) ; A=Mugsy's state byte
 46598 LD D,A ; D=it
 46599 AND 14 ; Is he facing right?
 46601 JR Z,46607 ; No
 46603 LD A,2 ; A=2: up and right
 46605 JR 46641 ; Use the code
 46607 LD A,D ; A=his state
 46608 AND 224 ; Is he facing left?
 46610 JR Z,46616 ; No
 46612 LD A,128 ; A=128: up and left
 46614 JR 46641 ; Use the code
 46616 LD A,B ; A=the bits
 46617 CP 16 ; Down only?
 46619 JR NZ,46640 ; No: no movement
 46621 LD A,(HL) ; A=Mugsy's state byte
 46622 AND 14 ; Is he facing right?
 46624 JR Z,46630 ; No
 46626 LD A,8 ; A=8: down and right
 46628 JR 46641 ; Use the code
 46630 LD A,D ; A=his state
 46631 AND 224 ; Is he facing left?
 46633 JR Z,46640 ; No: no movement
 46635 LD A,32 ; A=32: down and left
 46637 JR 46641 ; Use the code

; Unused: a stray byte
;
; Nothing can reach this byte: the JR at #R46637 jumps over it and the JR Z at #R46633 lands just after it. It is 120, the instruction LD A,B, probably the remains of an earlier version of this routine.
b46639 DEFB 120 ; LD A,B: never executed

; Shootout: no movement
c46640 LD A,(HL) ; A=Mugsy's current state (no new direction)
 46641 LD (42315),A ; Store the direction code for the main loop
 46644 RET ; Return

