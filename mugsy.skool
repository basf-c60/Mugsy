@start
@org=24576
@set-handle-unsupported-macros=1
; Start the game
;
; This is the entry point (from #R24576(PRINT USR 24576) in the BASIC loader). It disables interrupts, moves the stack down into the printer buffer, saves IY (which the ROM interrupt routine needs) and calls the main loop. When the player answers "nope" to "Hows about another game, Mugsy?" the main loop returns here and the machine locks up in an infinite loop (see #LINK(Bugs#noquit)(the bugs page)).
@label=START
c24576 DI ; Disable interrupts
 24577 LD SP,23552 ; Put the stack in the printer buffer, just below the system variables
 24580 LD (33900),IY ; Save IY (the ROM interrupt routine needs it to point at the system variables)
 24584 CALL 24589 ; Play games until the player has had enough
 24587 JR 24587 ; Then hang forever (see #LINK(Bugs#noquit)(the bugs page))

; Main loop: play one game
;
; Initialises the variables, shows Louey's greeting and then plays years until the game status flag at #R33897 is non-zero. A value of 2 means "another game"; 1 means "no more".
@label=MAINLOOP
c24589 CALL 33937 ; Initialise the VM variables and flags
 24592 LD IY,24609 ; Run the script at #R24609: Louey says "Hi Boss, it's Louey your sidekick here..."
 24596 CALL 30092 ; Run the greeting script
 24599 CALL 24614 ; Play years until the game ends
 24602 LD A,(33897) ; Pick up the game status flag (1=quit, 2=new game)
 24605 DEC A ; Count down: 1 (quit) becomes 0
 24606 RET Z ; Return (and hang) if the player doesn't want another game
 24607 JR 24589 ; Otherwise start a new game

; VM script: Louey's greeting
;
; Run by #R24589 at the start of each game.
b24609 DEFB 1,134,194,20 ; VM: SAY #R49798,20 "Hi Boss, it's Louey your sidekick here wit' da lowdown on da mob..."
 24613 DEFB 0 ; VM: END

; Play one year
;
; Picks one of the two speech bubble layout tables at random (#R33913 or #R33925), runs the main VM script at #R24652 and loops until the script sets the game status flag at #R33897.
@label=PLAYYEAR
c24614 LD HL,0 ; No bubble layout is current yet
 24617 LD (33904),HL ; Remember that no layout is current
 24620 LD A,100 ; A=100: the upper limit (#R30014 takes the absolute value, giving 0..100)
 24622 CALL 30014 ; A=a random number from 0 to 100
 24625 CP 50 ; Is it less than 50?
 24627 LD HL,33913 ; Use the first table of bubble layouts...
 24630 JR C,24635 ; ...if so
 24632 LD HL,33925 ; Otherwise use the second table
 24635 LD (33902),HL ; Store the layout table pointer
 24638 LD IY,24652 ; Run the main script at #R24652 for this year
 24642 CALL 30092 ; Run the year's script
 24645 LD A,(33897) ; Has the game finished?
 24648 AND A ; Test the game status flag
 24649 JR Z,24614 ; Play another year if not
 24651 RET ; Return: the game is over

; VM script: one year of the game
;
; Run by #R24614. This is the whole game: the report on last year, Rocco, the contract, buying and selling clients, ammo, the squeeze, the kickback, the hit man, the year's results and finally the end-of-game rating. See the #LINK(VM)(VM reference) for the instruction set.
b24652 DEFB 1,174,194,1,4,9 ; VM: SAY #R49838,1 "Last year (Killed) guys got rubbed out by other mobs and (Recruits) hoods wuz recruited by the organisation."
 24658 DEFB 6,72,9,94,96 ; VM: IFLT K0,Recruits,#R24670
 24663 DEFB 1,253,194,9 ; VM: SAY #R49917,9 "[City Hall think you stink/Some of da boys is sayin' you're all washed up], Boss."
 24667 DEFB 13,137,96 ; VM: GOTO #R24713
*24670 DEFB 9,96,132,1,137,96 ; VM: IFPEEKEQ #R33888,1,#R24713
